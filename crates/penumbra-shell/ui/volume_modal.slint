import { Theme } from "theme.slint";
import { Icon } from "icon.slint";

export component VolumeModal inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <float> volume: 0.65;
    property <float> pre-mute-volume: 0.65;

    callback volume-changed(float);
    callback dismiss();

    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    width: 100%;
    height: 100%;
    background: transparent;

    animate opacity {
        duration: root.open ? Theme.duration-medium : Theme.duration-short;
        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
    }

    // Dismiss area covering the outside space
    TouchArea {
        enabled: root.open;
        width: 100%;
        height: 100%;
        clicked => { root.dismiss(); }
    }

    // Material 3 Expressive Right-Side Floating Volume Pill
    slider-card := Rectangle {
        x: root.open ? 344px : 416px;
        y: 210px;
        width: track-touch.pressed ? 56px : 52px;
        height: 264px;
        background: Theme.surface-container-high;
        border-radius: Theme.radius-pill;
        border-width: 1px;
        border-color: track-touch.pressed ? Theme.specular-rim-glow : Theme.specular-rim-active;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.glass-scrim-deep;
        drop-shadow-offset-y: 8px;
        clip: true;

        animate x {
            duration: root.open ? Theme.duration-medium : Theme.duration-short;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }
        animate width {
            duration: Theme.duration-micro;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }
        animate border-color { duration: Theme.duration-micro; }

        // Active fill bar rising from the bottom
        fill-bar := Rectangle {
            property <float> clamped-vol: Math.clamp(root.volume, 0.0, 1.0);
            x: 0px;
            y: parent.height - self.height;
            width: parent.width;
            height: self.clamped-vol * parent.height;
            background: self.clamped-vol > 0.01 ? Theme.primary : Theme.surface-variant;
            border-radius: Theme.radius-tile-squash;

            animate height {
                duration: track-touch.pressed ? 0ms : Theme.duration-short;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }
            animate background { duration: Theme.duration-short; }

            // Expressive pill handle near top of active fill
            if self.clamped-vol > 0.14: Rectangle {
                x: (parent.width - self.width) / 2;
                y: 8px;
                width: 20px;
                height: 4px;
                border-radius: Theme.radius-pill;
                background: Theme.on-primary;
                opacity: 0.55;
            }
        }

        // Percentage indicator at top + dynamic contrast
        Text {
            x: 0px;
            y: 16px;
            width: parent.width;
            text: Math.round(Math.clamp(root.volume, 0.0, 1.0) * 100.0) + "%";
            color: root.volume > 0.85 ? Theme.on-primary : Theme.on-surface;
            font-size: Theme.font-label;
            font-weight: 700;
            horizontal-alignment: center;
            animate color { duration: Theme.duration-micro; }
        }

        // Interactive touch scrubbing directly on the vertical slider
        track-touch := TouchArea {
            enabled: root.open;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height - 52px;

            moved => {
                if (self.pressed) {
                    let ratio = 1.0 - (self.mouse-y / parent.height);
                    let clamped = Math.clamp(ratio, 0.0, 1.0);
                    root.volume = clamped;
                    if (clamped > 0.02) {
                        root.pre-mute-volume = clamped;
                    }
                    root.volume-changed(clamped);
                }
            }

            pointer-event(pe) => {
                if (pe.kind == PointerEventKind.down || pe.kind == PointerEventKind.up) {
                    let ratio = 1.0 - (self.mouse-y / parent.height);
                    let clamped = Math.clamp(ratio, 0.0, 1.0);
                    root.volume = clamped;
                    if (clamped > 0.02) {
                        root.pre-mute-volume = clamped;
                    }
                    root.volume-changed(clamped);
                }
            }
        }

        // Bottom Mute/Unmute Toggle Button
        mute-btn := Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 8px;
            width: mute-touch.pressed ? 34px : 38px;
            height: mute-touch.pressed ? 34px : 38px;
            border-radius: mute-touch.pressed ? 12px : 19px;
            background: root.volume > 0.10
                ? (mute-touch.pressed ? Theme.primary-container : Theme.glass-scrim-thin)
                : Theme.surface-container-highest;

            animate width, height, border-radius {
                duration: Theme.duration-micro;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            Icon {
                name: root.volume <= 0.01 ? "volume-mute" : (root.volume < 0.45 ? "volume-low" : "volume");
                icon-color: root.volume > 0.10 ? Theme.on-primary : Theme.on-surface;
                icon-size: 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            mute-touch := TouchArea {
                enabled: root.open;
                clicked => {
                    if (root.volume > 0.01) {
                        root.pre-mute-volume = root.volume;
                        root.volume = 0.0;
                    } else {
                        root.volume = root.pre-mute-volume > 0.05 ? root.pre-mute-volume : 0.5;
                    }
                    root.volume-changed(root.volume);
                }
            }
        }
    }
}
