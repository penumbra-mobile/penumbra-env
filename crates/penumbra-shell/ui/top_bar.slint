import { Theme } from "theme.slint";

export component TopBarWindow inherits Window {
    title: "Penumbra Top Bar";
    height: 42px;
    background: transparent;
    default-font-family: "Droid Sans";

    // Telemetry properties bound to penumbra-services (Material 3 Expressive status bar)
    in-out property <string> time-text: "12:00";
    in-out property <float> battery-pct: 100.0;
    in-out property <bool> is-charging: false;
    in-out property <bool> wifi-connected: true;
    in-out property <int> wifi-signal: 100;
    in-out property <string> carrier-text: "Penumbra";
    in-out property <bool> privacy-active: false;
    in-out property <bool> dnd-active: false;
    in-out property <bool> wwan-present: false;
    in-out property <int> wwan-signal: 0;
    in-out property <string> wwan-tech: "";
    in-out property <bool> bt-powered: false;
    in-out property <bool> bt-connected: false;
    in-out property <bool> vpn-active: false;
    in-out property <bool> docked: false;
    in-out property <float> shade-progress: 0.0;

    callback top-bar-pulled-down(float /* dy */, bool /* is_qs */);
    callback top-bar-released(bool /* is_qs */);

    touch-area := TouchArea {
        property <length> press-x: 0px;
        property <length> press-y: 0px;
        property <bool> has-dragged: false;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.press-x = touch-area.mouse-x;
                self.press-y = touch-area.mouse-y;
                self.has-dragged = false;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                let dy = touch-area.mouse-y - self.press-y;
                let is-qs = self.press-x >= (root.width / 2);
                if (!self.has-dragged && dy > 6px) {
                    root.top-bar-pulled-down(dy / 1px, is-qs);
                    self.has-dragged = true;
                }
                if (self.has-dragged) {
                    root.top-bar-released(is-qs);
                } else if (event.kind == PointerEventKind.up && Math.abs(dy) <= 6px) {
                    root.top-bar-pulled-down(520.0, is-qs);
                    root.top-bar-released(is-qs);
                }
                self.has-dragged = false;
            }
        }
        moved => {
            if (touch-area.pressed) {
                let dy = touch-area.mouse-y - self.press-y;
                let is-qs = self.press-x >= (root.width / 2);
                if (dy > 4px) {
                    self.has-dragged = true;
                    root.top-bar-pulled-down(dy / 1px, is-qs);
                }
            }
        }
    }

    // Material 3 Expressive Top Bar (borderless, transparent, official Material Symbols Rounded)
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: transparent;
        opacity: Math.clamp(1.0 - root.shade-progress * 5.0, 0.0, 1.0);

        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 0px;

            // Left Cluster: Cellular WWAN, Wi-Fi, VPN, Docked
            HorizontalLayout {
                horizontal-stretch: 0;
                height: parent.height;
                spacing: 6px;
                alignment: start;

                if root.wwan-present: HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 15px;
                            height: 15px;
                            source: root.wwan-signal >= 75 ? @image-url("icons/signal_cellular_4_bar.svg")
                                  : root.wwan-signal >= 50 ? @image-url("icons/signal_cellular_3_bar.svg")
                                  : root.wwan-signal >= 25 ? @image-url("icons/signal_cellular_2_bar.svg")
                                  : @image-url("icons/signal_cellular_1_bar.svg");
                            colorize: Theme.on-surface;
                        }
                    }

                    if root.wwan-tech != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 15px;
                            border-radius: 7.5px;
                            background: Theme.surface-container-highest.with-alpha(0.85);
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                alignment: center;
                                Text {
                                    text: root.wwan-tech;
                                    color: Theme.on-surface;
                                    font-size: 9px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                if root.wifi-connected: VerticalLayout {
                    alignment: center;
                    Image {
                        width: 15px;
                        height: 15px;
                        source: root.wifi-signal >= 65 ? @image-url("icons/wifi.svg")
                              : root.wifi-signal >= 25 ? @image-url("icons/wifi_2_bar.svg")
                              : @image-url("icons/wifi_1_bar.svg");
                        colorize: Theme.on-surface;
                    }
                }

                if root.vpn-active: VerticalLayout {
                    alignment: center;
                    Image {
                        width: 14px;
                        height: 14px;
                        source: @image-url("icons/vpn_key.svg");
                        colorize: Theme.primary;
                    }
                }

                if root.docked: VerticalLayout {
                    alignment: center;
                    Image {
                        width: 14px;
                        height: 14px;
                        source: @image-url("icons/dock.svg");
                        colorize: Theme.primary;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            // Right Cluster: Privacy, DND, Bluetooth, Expressive Battery Pill
            HorizontalLayout {
                horizontal-stretch: 0;
                height: parent.height;
                spacing: 6px;
                alignment: end;

                if root.privacy-active: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 16px;
                        height: 12px;
                        border-radius: 6px;
                        background: Theme.privacy-green;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 2px;
                            padding: 2px;

                            Rectangle {
                                width: 3px;
                                height: 3px;
                                border-radius: 1.5px;
                                background: #003919;
                            }
                            Rectangle {
                                width: 3px;
                                height: 3px;
                                border-radius: 1.5px;
                                background: #003919;
                            }
                        }
                    }
                }

                if root.dnd-active: VerticalLayout {
                    alignment: center;
                    Image {
                        width: 14px;
                        height: 14px;
                        source: @image-url("icons/do_not_disturb_on.svg");
                        colorize: Theme.on-surface-variant;
                    }
                }

                if root.bt-powered: VerticalLayout {
                    alignment: center;
                    Image {
                        width: 14px;
                        height: 14px;
                        source: root.bt-connected ? @image-url("icons/bluetooth_connected.svg")
                              : @image-url("icons/bluetooth.svg");
                        colorize: root.bt-connected ? Theme.primary : Theme.on-surface;
                    }
                }

                // Material 3 Expressive Battery Pill
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 19px;
                        border-radius: 9.5px;
                        background: root.is-charging
                            ? Theme.privacy-green.with-alpha(0.22)
                            : (root.battery-pct < 20.0
                                ? Theme.error.with-alpha(0.22)
                                : Theme.surface-container-highest.with-alpha(0.82));

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 5px;
                            spacing: 2px;
                            alignment: center;

                            Text {
                                text: "\{Math.round(root.battery-pct)}%";
                                color: root.battery-pct < 20.0 ? Theme.error
                                     : (root.is-charging ? Theme.privacy-green : Theme.on-surface);
                                font-size: 10.5px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 13px;
                                    height: 13px;
                                    source: root.is-charging
                                        ? @image-url("icons/battery_charging_full.svg")
                                        : @image-url("icons/battery_full.svg");
                                    colorize: root.battery-pct < 20.0 ? Theme.error
                                            : (root.is-charging ? Theme.privacy-green : Theme.on-surface);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Center: Wall Clock
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.time-text;
            color: Theme.on-surface;
            font-size: Theme.font-body;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
