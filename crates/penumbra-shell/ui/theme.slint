export global Theme {
    // =========================================================================
    // Material 3 Expressive (M3E) Tonal Surface Hierarchy
    // Pure OLED Pitch-Black to High-Contrast Elevated Glass Containers
    // =========================================================================
    in-out property <color> surface: #141218;                  // Standard baseline dark surface
    in-out property <color> surface-dim: #110f15;              // Dimmed / recessed background
    in-out property <color> surface-bright: #38353d;           // Luminous high-contrast surface
    in-out property <color> surface-container-lowest: #0b0a0e; // Deepest OLED pitch black container (0dp)
    in-out property <color> surface-container-low: #17151d;    // Low-elevation card container (1dp)
    in-out property <color> surface-container: #1e1b24;        // Resting sheet / pastille container (2dp)
    in-out property <color> surface-container-high: #27232e;   // Elevated tile / slider chassis (3dp)
    in-out property <color> surface-container-highest: #36343b;// High-emphasis floating capsule (4dp)
    in-out property <color> surface-variant: #44474f;          // Chip outline, subtle separator

    // Backward-Compatible Aliases
    in-out property <color> base-surface: #0b0a0e;
    in-out property <color> surface-lowest: #17151d;
    in-out property <color> surface-low: #1e1b24;
    in-out property <color> surface-high: #27232e;
    in-out property <color> surface-highest: #36343b;

    // =========================================================================
    // Dynamic Tonal Accent Roles (Pixel Monet Palette)
    // =========================================================================
    // Primary: Dynamic Iris Periwinkle (Tonal 80 / 20 / 30 / 90)
    in-out property <color> primary: #ADC6FF;
    in-out property <color> on-primary: #002E69;
    in-out property <color> primary-container: #254070;
    in-out property <color> on-primary-container: #D8E2FF;
    in-out property <color> inverse-primary: #3B5E99;

    // Secondary: Cool Steel Slate (Tonal 80 / 20 / 30 / 90)
    in-out property <color> secondary: #BFC6DC;
    in-out property <color> on-secondary: #283141;
    in-out property <color> secondary-container: #3E4758;
    in-out property <color> on-secondary-container: #DBE2F9;

    // Tertiary: Expressive Wildflower Rose (Tonal 80 / 20 / 30 / 90)
    in-out property <color> tertiary: #EFB8C8;
    in-out property <color> on-tertiary: #492532;
    in-out property <color> tertiary-container: #633B48;
    in-out property <color> on-tertiary-container: #FFD8E4;

    // Error / Critical Alerts
    in-out property <color> error: #FFB4AB;
    in-out property <color> on-error: #690005;
    in-out property <color> error-container: #93000A;
    in-out property <color> on-error-container: #FFDAD6;

    // =========================================================================
    // Content & Boundary Roles
    // =========================================================================
    in-out property <color> on-surface: #E3E2E6;               // Primary typography & icons
    in-out property <color> on-surface-variant: #C4C6D0;       // Secondary label / caption text
    in-out property <color> inverse-surface: #E3E2E6;
    in-out property <color> inverse-on-surface: #303033;
    in-out property <color> outline: #8E9099;                  // Unselected boundary strokes
    in-out property <color> outline-variant: #44474F;          // Recessed borders & dividers

    // =========================================================================
    // Specular Fresnel Highlights & Glass Scrim Overlays
    // =========================================================================
    out property <color> specular-rim: #ffffff14;           // 8% white glass specular edge
    out property <color> specular-rim-active: #ffffff33;    // 20% active component glass edge
    out property <color> specular-rim-glow: #ffffff50;      // 31% focus highlight edge
    out property <color> glass-scrim-thin: #0b0a0e40;       // 25% organic scrim
    out property <color> glass-scrim-medium: #0b0a0e80;     // 50% organic scrim
    out property <color> glass-scrim-deep: #0b0a0ecc;       // 80% organic scrim
    out property <color> glass-card: #1e1b2488;             // 53% translucent blur pass-through

    // Hardware Sensor / Privacy Indicators
    out property <color> privacy-green: #48E885;
    out property <color> privacy-green-glow: #48E88533;
    out property <color> charging-accent: #48E885;

    // =========================================================================
    // Expressive Geometry Radii
    // =========================================================================
    out property <length> radius-pill: 9999px;              // Fluid capsules & pastilles
    out property <length> radius-card: 32px;                // Large sheets & modal surfaces
    out property <length> radius-tile: 28px;                // QuickSettings toggles (resting)
    out property <length> radius-tile-squash: 22px;         // QuickSettings toggles (pressed)
    out property <length> radius-squircle: 24px;            // Android 17 app icon squircles
    out property <length> radius-item: 16px;                // Notification pastilles & menu rows
    out property <length> radius-small: 16px;               // Small chips
    out property <length> radius-xs: 8px;                   // Micro badges & tags

    // =========================================================================
    // Expressive Durations
    // Canonical Bezier Curves (Use in Slint animate clauses):
    //   Standard:              cubic-bezier(0.2, 0.0, 0.0, 1.0)
    //   Emphasized Decelerate: cubic-bezier(0.05, 0.7, 0.1, 1.0)
    //   Emphasized Accelerate: cubic-bezier(0.3, 0.0, 0.8, 0.15)
    // =========================================================================
    out property <duration> duration-micro: 100ms;          // Micro haptic responses
    out property <duration> duration-short: 150ms;          // Touch squash & pastille state changes
    out property <duration> duration-medium: 300ms;         // Modal expansions & card morphing
    out property <duration> duration-long: 500ms;           // Drawer pull & layout restructuring

    // =========================================================================
    // Expressive Typography Hierarchy (Google Sans / Inter Scale)
    // =========================================================================
    out property <length> font-clock-large: 64px;           // Lockscreen hero clock
    out property <length> font-clock-mid: 42px;             // QuickSettings header clock
    out property <length> font-display: 36px;               // Large feature titles
    out property <length> font-headline: 32px;              // Primary drawer headers
    out property <length> font-title: 19px;                 // Tile titles & dialog titles
    out property <length> font-body: 14px;                  // Standard readable content
    out property <length> font-label: 12px;                 // Subtitles, badges, sliders
    out property <length> font-caption: 11px;               // Battery %, timestamps, micro tags
}
