import { Theme } from "theme.slint";
import { Icon } from "icon.slint";
import { NotificationData, NotificationCard, NotificationEmptyState, NotificationStack } from "notifications.slint";

export { NotificationData }

export struct TileData {
    id: string,
    title: string,
    subtitle: string,
    icon-name: string,
    active: bool,
    enabled: bool,
}

// =========================================================================
// Material 3 Expressive QSTile Component
// =========================================================================
export component QSTile inherits Rectangle {
    in property <string> title: "Internet";
    in property <string> subtitle: "Connected";
    in property <image> icon;
    in property <string> icon-name: "";
    in property <bool> is-active: false;
    in property <bool> has-chevron: true;

    callback clicked();
    callback chevron-clicked();
    callback long-pressed();

    property <bool> is-down: false;
    property <bool> did-long-press: false;
    property <float> touch-start-x: 0.0;
    property <float> touch-start-y: 0.0;

    height: 64px;
    background: transparent;

    // Tactile Touch Squash Inner Chassis (0.96x compression on press)
    inner-tile := Rectangle {
        x: root.is-down ? 2.5px : 0px;
        y: root.is-down ? 1.5px : 0px;
        width: parent.width - (root.is-down ? 5px : 0px);
        height: parent.height - (root.is-down ? 3px : 0px);
        border-radius: root.is-down ? 22px : (root.is-active ? 28px : 20px);
        background: root.is-active ? #d0bcff : (root.is-down ? #38353d : #2b2930);
        border-width: 1px;
        border-color: root.is-active ? #ffffff44 : Theme.specular-rim;
        clip: true;

        animate x, y, width, height { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate background { duration: 180ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate border-radius { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            spacing: 12px;
            alignment: center;

            Rectangle {
                width: 24px;
                height: 24px;
                background: transparent;

                if root.icon-name != "": Icon {
                    name: root.icon-name;
                    icon-size: 24px;
                    icon-color: root.is-active ? #381e72 : #e6e0e9;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    animate icon-color { duration: 180ms; easing: ease-out; }
                }
                if root.icon-name == "": Image {
                    source: root.icon;
                    width: 24px;
                    height: 24px;
                    colorize: root.is-active ? #381e72 : #e6e0e9;
                    animate colorize { duration: 180ms; easing: ease-out; }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.title;
                    font-size: 14px;
                    font-weight: 700;
                    color: root.is-active ? #381e72 : #e6e0e9;
                    overflow: elide;
                }

                if root.subtitle != "": Text {
                    text: root.subtitle;
                    font-size: 12px;
                    font-weight: 500;
                    color: root.is-active ? #381e72 : #cac4d0;
                    overflow: elide;
                }
            }

            if root.has-chevron: TouchArea {
                width: 28px;
                height: 28px;
                clicked => { root.chevron-clicked(); }
                Icon {
                    name: "chevron-right";
                    icon-size: 16px;
                    icon-color: root.is-active ? #381e72 : #cac4d0;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    animate icon-color { duration: 180ms; }
                }
            }
        }
    }

    lp-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.is-down) {
                root.did-long-press = true;
                root.long-pressed();
            }
        }
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.touch-start-x = self.mouse-x / 1px;
                root.touch-start-y = self.mouse-y / 1px;
                root.is-down = true;
                root.did-long-press = false;
                lp-timer.running = true;
            } else if (event.kind == PointerEventKind.move) {
                if (root.is-down) {
                    let dx = Math.abs((self.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((self.mouse-y / 1px) - root.touch-start-y);
                    if (dx > 12.0 || dy > 12.0) { lp-timer.running = false; }
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                lp-timer.running = false;
                if (root.is-down) {
                    root.is-down = false;
                    let dx = Math.abs((self.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((self.mouse-y / 1px) - root.touch-start-y);
                    if (!root.did-long-press && dx < 14.0 && dy < 14.0) {
                        root.clicked();
                    }
                }
            }
        }
    }
}

// =========================================================================
// Modern Slate Editor Tile Item (Android 17 1:1)
// =========================================================================
component EditTileItem inherits Rectangle {
    in property <string> title: "Tile";
    in property <string> subtitle: "Off";
    in property <string> icon-name: "wifi";
    in property <bool> is-removable: true;
    callback action();

    property <bool> is-down: false;

    height: 64px;
    background: transparent;

    inner-box := Rectangle {
        x: root.is-down ? 2px : 0px;
        y: root.is-down ? 1.5px : 0px;
        width: parent.width - (root.is-down ? 4px : 0px);
        height: parent.height - (root.is-down ? 3px : 0px);
        border-radius: root.is-down ? 18px : 22px;
        background: root.is-down ? #38343f : (root.is-removable ? #2b2735 : #1d1b20);
        border-width: 1px;
        border-color: root.is-removable ? #ffffff22 : Theme.specular-rim;
        clip: true;

        animate x, y, width, height { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate background { duration: 150ms; easing: ease-out; }
        animate border-radius { duration: 160ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 12px;
            spacing: 10px;
            alignment: center;

            Rectangle {
                width: 24px;
                height: 24px;
                background: transparent;

                Icon {
                    name: root.icon-name;
                    icon-size: 22px;
                    icon-color: root.is-removable ? #d0bcff : #938f99;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.title;
                    font-size: 13px;
                    font-weight: 700;
                    color: root.is-removable ? #e6e0e9 : #cac4d0;
                    overflow: elide;
                }

                if root.subtitle != "": Text {
                    text: root.subtitle;
                    font-size: 11px;
                    font-weight: 500;
                    color: root.is-removable ? #cac4d0 : #79747e;
                    overflow: elide;
                }
            }

            // Circular action badge: Minus for active tiles, Plus for available tiles
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: root.is-removable ? #492532 : #254070;
                border-width: 1px;
                border-color: root.is-removable ? #efb8c840 : #adc6ff40;

                Icon {
                    name: root.is-removable ? "minus" : "plus";
                    icon-size: 14px;
                    icon-color: root.is-removable ? #efb8c8 : #adc6ff;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.is-down = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.is-down = false;
            }
        }
        clicked => { root.action(); }
    }
}





// =========================================================================
// Capsule-Shaped Brightness Slider
// =========================================================================
component SliderPill inherits Rectangle {
    in-out property <float> value: 0.75;
    in property <string> icon-name: "brightness";
    in property <string> label: "Brightness";
    callback changed(float);

    property <length> stretch-offset: 0px;
    property <bool> is-dragging: false;

    height: 44px;
    background: transparent;

    inner-slider := Rectangle {
        property <length> squash-y: root.is-dragging ? 1.5px : 0px;
        property <length> visual-w: Math.clamp(parent.width + root.stretch-offset, parent.width - 24px, parent.width + 24px);

        x: (parent.width - self.visual-w) / 2;
        y: self.squash-y;
        width: self.visual-w;
        height: parent.height - 2 * self.squash-y;

        border-radius: 22px;
        background: #2b2930;
        border-width: 1px;
        border-color: root.is-dragging ? Theme.specular-rim-active : Theme.specular-rim;
        clip: true;

        animate x, y, width, height, border-color {
            duration: root.is-dragging ? 0ms : Theme.duration-short;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        // Active fill bar
        fill-bar := Rectangle {
            x: 0px;
            y: 0px;
            width: Math.clamp(parent.width * Math.clamp(root.value, 0.0, 1.0) + (root.stretch-offset > 0px ? root.stretch-offset : 0px), 0px, parent.width);
            height: parent.height;
            background: #d0bcff;
            border-radius: 22px;

            animate width {
                duration: root.is-dragging ? 0ms : Theme.duration-short;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    Icon {
                        name: "brightness";
                        icon-size: 18px;
                        icon-color: root.value > 0.08 ? #381e72 : #e6e0e9;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
                Text {
                    text: root.label;
                    font-size: 13px;
                    font-weight: 700;
                    color: root.value > 0.38 ? #381e72 : #e6e0e9;
                    vertical-alignment: center;
                }
            }

            // Low brightness / Night icon
            Rectangle {
                width: 24px;
                height: 24px;
                Icon {
                    name: "brightness-low";
                    icon-size: 18px;
                    icon-color: root.value > 0.90 ? #381e72 : #cac4d0;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }

    slider-touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.is-dragging = true;
                root.update-slider(slider-touch.mouse-x);
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.is-dragging = false;
                root.stretch-offset = 0px;
            }
        }
        moved => {
            if (slider-touch.pressed) {
                root.update-slider(slider-touch.mouse-x);
            }
        }
    }

    function update-slider(touch-x: length) {
        if (touch-x < 0px) {
            root.value = 0.0;
            let dx = Math.abs(touch-x / 1px);
            root.stretch-offset = -Math.sqrt(dx * 1.5) * 1px;
        } else if (touch-x > root.width) {
            root.value = 1.0;
            let dx = (touch-x - root.width) / 1px;
            root.stretch-offset = Math.sqrt(dx * 1.5) * 1px;
        } else {
            root.value = Math.clamp(touch-x / root.width, 0.0, 1.0);
            root.stretch-offset = 0px;
        }
        root.changed(root.value);
    }
}

// =========================================================================
// Material 3 Expressive Header / Action Icon Button
// =========================================================================
component HeaderIconButton inherits Rectangle {
    in property <string> icon-name;
    in property <bool> is-accent: false;
    callback clicked();

    property <bool> is-down: false;

    width: 38px;
    height: 38px;
    border-radius: 19px;
    background: root.is-accent ? (root.is-down ? #e8def8 : #d0bcff) : (root.is-down ? #38353d : #2b2930);
    border-width: 1px;
    border-color: root.is-accent ? #ffffff44 : Theme.specular-rim;

    animate background, border-radius { duration: 150ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

    Icon {
        name: root.icon-name;
        icon-size: 18px;
        icon-color: root.is-accent ? #381e72 : #e6e0e9;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.is-down = true; }
            else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.is-down = false; }
        }
        clicked => { root.clicked(); }
    }
}

// =========================================================================
// Material 3 Expressive Pill Action Button (Reset, Done)
// =========================================================================
component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> icon-name;
    in property <bool> is-accent: true;
    callback clicked();

    property <bool> is-down: false;

    height: 36px;
    border-radius: 18px;
    background: root.is-accent ? (root.is-down ? #e8def8 : #d0bcff) : (root.is-down ? #38353d : #2b2930);
    border-width: 1px;
    border-color: root.is-accent ? #ffffff44 : Theme.specular-rim;

    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;

        if root.icon-name != "": Icon {
            name: root.icon-name;
            icon-size: 16px;
            icon-color: root.is-accent ? #381e72 : #e6e0e9;
        }

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 700;
            color: root.is-accent ? #381e72 : #e6e0e9;
            vertical-alignment: center;
        }
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.is-down = true; }
            else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.is-down = false; }
        }
        clicked => { root.clicked(); }
    }
}

// =========================================================================
// Circular Icon Button ($48px round button)
// =========================================================================
export component SmallButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> accent: false;
    in property <length> button-width: 48px;
    callback clicked();

    property <bool> is-down: false;

    width: root.button-width;
    height: 48px;
    border-radius: 24px;
    background: root.accent ? (root.is-down ? #e8def8 : #d0bcff) : (root.is-down ? #38353d : #2b2930);
    border-width: 1px;
    border-color: root.accent ? #ffffff33 : Theme.specular-rim;

    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

    if root.icon != "": Icon {
        name: root.icon;
        icon-size: 20px;
        icon-color: root.accent ? #381e72 : #e6e0e9;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.icon == "": Text {
        text: root.label;
        font-size: 13px;
        font-weight: 700;
        color: root.accent ? #381e72 : #e6e0e9;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.is-down = true; }
            else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.is-down = false; }
        }
        clicked => { root.clicked(); }
    }
}

// =========================================================================
// QuickSettingsSlider: Dual-Tier Material 3 Expressive SystemUI Shade
// =========================================================================
export component QuickSettingsSlider inherits Rectangle {
    in-out property <length> slide-offset-y: -915px;
    in property <float> expansion-progress: 0.0;
    in-out property <bool> edit-mode: false;

    in-out property <float> brightness: 0.75;
    in-out property <float> volume: 0.60;
    in-out property <string> time-text: "10:33";
    in-out property <string> date-text: "Wednesday, Oct 21";
    in-out property <string> carrier-text: "Penumbra 5G";
    in property <int> battery-pct: 100;

    in property <[TileData]> active-tiles;
    in property <[TileData]> available-tiles;
    in property <[NotificationData]> notifications;

    callback close-requested();
    callback power-action();
    callback settings-action();
    callback brightness-changed(float);
    callback volume-changed(float);
    callback tile-clicked(string);
    callback tile-long-pressed(string);
    callback enter-edit-mode();
    callback exit-edit-mode();
    callback reset-tiles();
    callback reorder-tiles(int, int);
    callback remove-tile(string);
    callback add-tile(string);
    callback drag-delta(length);
    callback drag-released(length, float);
    callback fast-pull-up();
    callback notification-dismissed(int);
    callback clear-notifications();
    callback mode-changed(bool /* is_full_qs */);

    in-out property <bool> is-full-qs: false;
    property <length> pad: 16px;
    property <length> col-w: (self.width - 2 * root.pad - 12px) / 2;

    // Background remains strictly transparent to let compositor Dual-Kawase blur show through!
    background: transparent;

    pure function tile-at(index: int, default-id: string, default-title: string, default-icon: string) -> TileData {
        if (index >= 0 && index < root.active-tiles.length) {
            return root.active-tiles[index];
        }
        let avail-idx = index - root.active-tiles.length;
        if (avail-idx >= 0 && avail-idx < root.available-tiles.length) {
            return root.available-tiles[avail-idx];
        }
        return {
            id: default-id,
            title: default-title,
            subtitle: "Off",
            icon-name: default-icon,
            active: false,
            enabled: true,
        };
    }

    // =========================================================================
    // The Floating Drawer Chassis (Y = -screen_height * (1.0 - t))
    // =========================================================================
    chassis := Rectangle {
        x: 0px;
        y: root.slide-offset-y;
        width: parent.width;
        height: 915px;
        background: transparent;
        clip: false;

        // Full chassis background gesture receiver:
        // - Drag up anywhere on empty area to collapse the shade
        // - Swipe horizontally between Notifications and Quick Settings
        chassis-gesture-area := TouchArea {
            property <float> touch-start-x: 0.0;
            property <float> touch-start-y: 0.0;
            property <bool> is-dragging-v: false;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.touch-start-x = self.mouse-x / 1px;
                    self.touch-start-y = self.mouse-y / 1px;
                    self.is-dragging-v = false;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    let dx = (self.mouse-x / 1px) - self.touch-start-x;
                    let dy = (self.mouse-y / 1px) - self.touch-start-y;
                    if (self.is-dragging-v) {
                        if (dy < -20.0) {
                            root.fast-pull-up();
                        } else {
                            root.drag-released(dy * 1px, 0.0);
                        }
                    } else if (Math.abs(dx) > 35.0 && Math.abs(dx) > Math.abs(dy) * 1.3) {
                        // Horizontal swipe between tabs
                        if (dx < -35.0) {
                            root.is-full-qs = true; // swipe left -> Quick Settings
                            root.mode-changed(true);
                        } else if (dx > 35.0) {
                            root.is-full-qs = false; // swipe right -> Notifications
                            root.mode-changed(false);
                        }
                    }
                    self.is-dragging-v = false;
                }
            }
            moved => {
                if (self.pressed) {
                    let dy = (self.mouse-y / 1px) - self.touch-start-y;
                    let dx = (self.mouse-x / 1px) - self.touch-start-x;
                    if (dy < -15.0 && Math.abs(dy) > Math.abs(dx)) {
                        self.is-dragging-v = true;
                        root.drag-delta(dy * 1px);
                    }
                }
            }
        }

        // =====================================================================
        // VIEW A: NORMAL SYSTEMUI SHADE (Split Notifications vs Quick Settings)
        // =====================================================================
        normal-view := Rectangle {
            x: 0px;
            y: root.edit-mode ? -30px : 0px;
            width: parent.width;
            height: parent.height - 36px;
            opacity: root.edit-mode ? 0.0 : 1.0;
            visible: !root.edit-mode || self.opacity > 0.01;

            animate opacity, y {
                duration: 260ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            // -----------------------------------------------------------------
            // Header: Large Clock, Date, Status, Edit & Power Buttons
            // -----------------------------------------------------------------
            HorizontalLayout {
                x: root.pad;
                y: 12px;
                width: parent.width - 2 * root.pad;
                height: 48px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: root.time-text;
                        font-size: 30px;
                        font-weight: 800;
                        color: Theme.on-surface;
                        letter-spacing: -0.5px;
                    }
                    Text {
                        text: root.date-text;
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.on-surface-variant;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            Text {
                                text: root.carrier-text;
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.on-surface;
                            }
                            Icon { name: "wifi"; icon-size: 13px; icon-color: Theme.on-surface; }
                        }
                        Rectangle {
                            height: 20px;
                            width: 54px;
                            border-radius: 10px;
                            background: #48E885;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;
                                alignment: center;
                                Icon { name: "battery"; icon-size: 11px; icon-color: #003915; }
                                Text { text: "\{root.battery-pct}%"; font-size: 10px; font-weight: 800; color: #003915; }
                            }
                        }
                    }

                    // Edit Mode Trigger Button
                    HeaderIconButton {
                        icon-name: "edit";
                        clicked => { root.enter-edit-mode(); }
                    }

                    // Power Menu Trigger Button
                    HeaderIconButton {
                        icon-name: "power";
                        clicked => { root.power-action(); }
                    }
                }
            }

            // -----------------------------------------------------------------
            // Mode Selector Tabs: [ Notifications ] | [ Quick Settings ]
            // -----------------------------------------------------------------
            HorizontalLayout {
                x: root.pad;
                y: 66px;
                width: parent.width - 2 * root.pad;
                height: 38px;
                spacing: 10px;

                // Notifications Tab (Left Half)
                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: 19px;
                    background: !root.is-full-qs ? #d0bcff : #2b2930;
                    border-width: 1px;
                    border-color: !root.is-full-qs ? #ffffff44 : Theme.specular-rim;
                    clip: true;

                    TouchArea {
                        clicked => {
                            root.is-full-qs = false;
                            root.mode-changed(false);
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Icon {
                            name: "bell";
                            icon-size: 14px;
                            icon-color: !root.is-full-qs ? #381e72 : #e6e0e9;
                        }
                        Text {
                            text: "Notifications";
                            font-size: 12px;
                            font-weight: 700;
                            color: !root.is-full-qs ? #381e72 : #e6e0e9;
                            vertical-alignment: center;
                        }
                    }
                }

                // Quick Settings Tab (Right Half)
                Rectangle {
                    horizontal-stretch: 1;
                    height: 38px;
                    border-radius: 19px;
                    background: root.is-full-qs ? #d0bcff : #2b2930;
                    border-width: 1px;
                    border-color: root.is-full-qs ? #ffffff44 : Theme.specular-rim;
                    clip: true;

                    TouchArea {
                        clicked => {
                            root.is-full-qs = true;
                            root.mode-changed(true);
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Icon {
                            name: "settings";
                            icon-size: 14px;
                            icon-color: root.is-full-qs ? #381e72 : #e6e0e9;
                        }
                        Text {
                            text: "Quick Settings";
                            font-size: 12px;
                            font-weight: 700;
                            color: root.is-full-qs ? #381e72 : #e6e0e9;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // =================================================================
            // MODE 1: NOTIFICATIONS SCREEN (!root.is-full-qs)
            // =================================================================
            if !root.is-full-qs: HorizontalLayout {
                x: root.pad;
                y: 114px;
                width: parent.width - 2 * root.pad;
                height: 44px;
                spacing: 8px;

                for tile[idx] in root.active-tiles: Rectangle {
                    visible: idx < 4;
                    horizontal-stretch: 1;
                    height: 44px;
                    border-radius: 22px;
                    background: tile.active ? #d0bcff : #2b2930;
                    border-width: 1px;
                    border-color: tile.active ? #ffffff44 : Theme.specular-rim;
                    clip: true;

                    TouchArea {
                        clicked => { root.tile-clicked(tile.id); }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                // tactile
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        padding-left: 8px;
                        padding-right: 8px;

                        Icon {
                            name: tile.icon-name;
                            icon-size: 15px;
                            icon-color: tile.active ? #381e72 : #e6e0e9;
                        }

                        Text {
                            text: tile.title;
                            font-size: 11px;
                            font-weight: 700;
                            color: tile.active ? #381e72 : #e6e0e9;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if !root.is-full-qs: NotificationStack {
                x: root.pad;
                y: 168px;
                width: parent.width - 2 * root.pad;
                height: parent.height - 216px;
                notifications: root.notifications;
                dismiss-notification(i) => { root.notification-dismissed(i); }
                clear-all => { root.clear-notifications(); }
                open-settings => { root.settings-action(); }
            }

            // =================================================================
            // MODE 2: QUICK SETTINGS SCREEN (root.is-full-qs)
            // =================================================================
            if root.is-full-qs: SliderPill {
                x: root.pad;
                y: 114px;
                width: parent.width - 2 * root.pad;
                value <=> root.brightness;
                label: "Brightness";
                changed(v) => { root.brightness-changed(v); }
            }

            for tile[idx] in root.active-tiles: QSTile {
                x: Math.mod(idx, 2) == 0 ? root.pad : (root.pad + root.col-w + 12px);
                y: 174px + Math.floor(idx / 2) * 74px;
                width: root.col-w;
                visible: root.is-full-qs && idx < 8;
                title: tile.title;
                subtitle: tile.subtitle;
                icon-name: tile.icon-name;
                is-active: tile.active;
                clicked => { root.tile-clicked(tile.id); }
                chevron-clicked => { root.tile-clicked(tile.id); }
                long-pressed => { root.tile-long-pressed(tile.id); }
            }

            // Quick Settings Footer when in full QS mode
            if root.is-full-qs: Rectangle {
                x: root.pad;
                y: 478px;
                width: parent.width - 2 * root.pad;
                height: 50px;
                border-radius: 25px;
                background: #24221de0;
                border-width: 1px;
                border-color: Theme.specular-rim;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Icon { name: "volume-high"; icon-size: 16px; icon-color: #d0bcff; }
                        Text {
                            text: "Media Volume: \{Math.round(root.volume * 100)}%";
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.on-surface;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        HeaderIconButton {
                            icon-name: "edit";
                            clicked => { root.enter-edit-mode(); }
                        }

                        HeaderIconButton {
                            icon-name: "settings";
                            clicked => { root.settings-action(); }
                        }

                        HeaderIconButton {
                            icon-name: "power";
                            clicked => { root.power-action(); }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // VIEW B: MODERN SLATE EDITOR (1:1 with Android 17 / Pixel SystemUI)
        // =====================================================================
        slate-editor-view := Rectangle {
            x: 0px;
            y: root.edit-mode ? 0px : 30px;
            width: parent.width;
            height: parent.height - 36px;
            opacity: root.edit-mode ? 1.0 : 0.0;
            visible: root.edit-mode || self.opacity > 0.01;

            animate opacity, y {
                duration: 260ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            // Top App Bar
            HorizontalLayout {
                x: root.pad;
                y: 12px;
                width: parent.width - 2 * root.pad;
                height: 52px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    HeaderIconButton {
                        icon-name: "chevron-left";
                        clicked => { root.exit-edit-mode(); }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Edit tiles";
                            font-size: 20px;
                            font-weight: 800;
                            color: Theme.on-surface;
                        }
                        Text {
                            text: "Hold & drag to reorder";
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.on-surface-variant;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    // Reset button
                    PillButton {
                        text: "Reset";
                        icon-name: "restart";
                        is-accent: false;
                        clicked => { root.reset-tiles(); }
                    }

                    // Done button
                    PillButton {
                        text: "Done";
                        icon-name: "check";
                        is-accent: true;
                        clicked => { root.exit-edit-mode(); }
                    }
                }
            }

            // Slate Editor Scrollable Canvas
            Flickable {
                x: root.pad;
                y: 72px;
                width: parent.width - 2 * root.pad;
                height: parent.height - 84px;
                content-height: editor-content.min-height;

                editor-content := VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 50px;
                    spacing: 16px;

                    // 1. ACTIVE TILES SECTION
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "ACTIVE TILES";
                                font-size: 11px;
                                font-weight: 800;
                                color: #d0bcff;
                            }
                            Rectangle {
                                height: 20px;
                                border-radius: 10px;
                                background: #38353d;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "\{root.active-tiles.length} active";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #cac4d0;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Tiles visible in quick settings. Tap - to remove.";
                            font-size: 11px;
                            color: #938f99;
                        }
                    }

                    // Active Tiles 2-Column Grid
                    Rectangle {
                        width: 100%;
                        height: ((root.active-tiles.length + 1) / 2) * 72px;

                        for tile[idx] in root.active-tiles: EditTileItem {
                            x: Math.mod(idx, 2) == 0 ? 0px : (root.col-w + 12px);
                            y: Math.floor(idx / 2) * 72px;
                            width: root.col-w;
                            title: tile.title;
                            subtitle: tile.subtitle;
                            icon-name: tile.icon-name;
                            is-removable: true;
                            action => { root.remove-tile(tile.id); }
                        }
                    }

                    // 2. REORDER / DIVIDER BANNER
                    Rectangle {
                        height: 42px;
                        border-radius: 21px;
                        background: #2b2735;
                        border-width: 1px;
                        border-color: Theme.specular-rim;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            alignment: center;
                            Icon { name: "edit"; icon-size: 16px; icon-color: #d0bcff; }
                            Text {
                                text: "Hold and drag tiles to reorder";
                                font-size: 12px;
                                font-weight: 600;
                                color: #e6e0e9;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 3. AVAILABLE TILES SECTION
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "AVAILABLE TILES";
                                font-size: 11px;
                                font-weight: 800;
                                color: #adc6ff;
                            }
                            Rectangle {
                                height: 20px;
                                border-radius: 10px;
                                background: #252836;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "\{root.available-tiles.length} available";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #adc6ff;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Tap + to add tile to your active shade.";
                            font-size: 11px;
                            color: #938f99;
                        }
                    }

                    // Available Tiles 2-Column Grid
                    Rectangle {
                        width: 100%;
                        height: ((root.available-tiles.length + 1) / 2) * 72px;

                        for tile[idx] in root.available-tiles: EditTileItem {
                            x: Math.mod(idx, 2) == 0 ? 0px : (root.col-w + 12px);
                            y: Math.floor(idx / 2) * 72px;
                            width: root.col-w;
                            title: tile.title;
                            subtitle: tile.subtitle;
                            icon-name: tile.icon-name;
                            is-removable: false;
                            action => { root.add-tile(tile.id); }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // Drag Handle: Glued to bottom of visible drawer
        // ---------------------------------------------------------------------
        bottom-handle-bar := Rectangle {
            x: 0px;
            y: parent.height - 36px;
            width: parent.width;
            height: 36px;
            background: transparent;

            Rectangle {
                width: 72px;
                height: 5px;
                x: (parent.width - self.width) / 2;
                y: 16px;
                border-radius: 2.5px;
                background: Theme.specular-rim-glow;
                opacity: 0.85;
            }

            TouchArea {
                property <length> press-y: 0px;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.press-y = self.mouse-y;
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        let dy = self.mouse-y - self.press-y;
                        if (dy < -10px) {
                            root.fast-pull-up();
                        }
                    }
                }
                clicked => {
                    root.close-requested();
                }
            }
        }
    }
}
