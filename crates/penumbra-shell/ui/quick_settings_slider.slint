    border-color: root.is-accent ? #ffffff44 : Theme.specular-rim;

    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;
        alignment: center;

        if root.icon-name != "": Icon {
            name: root.icon-name;
            icon-size: 16px;
            icon-color: root.is-accent ? #381e72 : #e6e0e9;
        }

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 700;
            color: root.is-accent ? #381e72 : #e6e0e9;
            vertical-alignment: center;
        }
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.is-down = true; }
            else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.is-down = false; }
        }
        clicked => { root.clicked(); }
    }
}

// =========================================================================
// Circular Icon Button ($48px round button)
// =========================================================================
export component SmallButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> accent: false;
    in property <length> button-width: 48px;
    callback clicked();

    property <bool> is-down: false;

    width: root.button-width;
    height: 48px;
    border-radius: 24px;
    background: root.accent ? (root.is-down ? #e8def8 : #d0bcff) : (root.is-down ? #38353d : #2b2930);
    border-width: 1px;
    border-color: root.accent ? #ffffff33 : Theme.specular-rim;

    animate background { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

    if root.icon != "": Icon {
        name: root.icon;
        icon-size: 20px;
        icon-color: root.accent ? #381e72 : #e6e0e9;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.icon == "": Text {
        text: root.label;
        font-size: 13px;
        font-weight: 700;
        color: root.accent ? #381e72 : #e6e0e9;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.is-down = true; }
            else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.is-down = false; }
        }
        clicked => { root.clicked(); }
    }
}

// =========================================================================
// QuickSettingsSlider: Dual-Tier Material 3 Expressive SystemUI Shade
// =========================================================================
export component QuickSettingsSlider inherits Rectangle {
    in-out property <length> slide-offset-y: -915px;
    in property <float> expansion-progress: 0.0;
    in-out property <bool> edit-mode: false;

    in-out property <float> brightness: 0.75;
    in-out property <float> volume: 0.60;
    in-out property <string> time-text: "10:33";
    in-out property <string> date-text: "Wednesday, Oct 21";
    in-out property <string> carrier-text: "Penumbra 5G";
    in property <int> battery-pct: 100;

    in property <[TileData]> active-tiles;
    in property <[TileData]> available-tiles;
    in property <[NotificationData]> notifications;

    callback close-requested();
    callback power-action();
    callback settings-action();
    callback brightness-changed(float);
    callback volume-changed(float);
    callback tile-clicked(string);
    callback tile-long-pressed(string);
    callback enter-edit-mode();
    callback exit-edit-mode();
    callback reset-tiles();
    callback reorder-tiles(int, int);
    callback remove-tile(string);
    callback add-tile(string);
    callback drag-delta(length);
    callback drag-released(length, float);
    callback fast-pull-up();
    callback notification-dismissed(int);
    callback clear-notifications();
    callback mode-changed(bool /* is_full_qs */);

    in-out property <bool> is-full-qs: false;
    property <length> pad: 16px;
    property <length> col-w: (self.width - 2 * root.pad - 12px) / 2;

    // Background remains strictly transparent to let compositor Dual-Kawase blur show through!
    background: transparent;

    pure function tile-at(index: int, default-id: string, default-title: string, default-icon: string) -> TileData {
        if (index >= 0 && index < root.active-tiles.length) {
            return root.active-tiles[index];
        }
        let avail-idx = index - root.active-tiles.length;
        if (avail-idx >= 0 && avail-idx < root.available-tiles.length) {
            return root.available-tiles[avail-idx];
        }
        return {
            id: default-id,
            title: default-title,
            subtitle: "Off",
            icon-name: default-icon,
            active: false,
            enabled: true,
        };
    }

    // =========================================================================
    // The Floating Drawer Chassis (Y = -screen_height * (1.0 - t))
    // =========================================================================
    chassis := Rectangle {
        x: 0px;
        y: root.slide-offset-y;
        width: parent.width;
        height: 915px;
        background: transparent;
        clip: false;

        // Full chassis background gesture receiver:
        // - Drag up anywhere on empty area to collapse the shade
        // - Swipe horizontally between Notifications and Quick Settings
        chassis-gesture-area := TouchArea {
            property <float> touch-start-x: 0.0;
            property <float> touch-start-y: 0.0;
            property <bool> is-dragging-v: false;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.touch-start-x = self.mouse-x / 1px;
                    self.touch-start-y = self.mouse-y / 1px;
                    self.is-dragging-v = false;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    let dx = (self.mouse-x / 1px) - self.touch-start-x;
                    let dy = (self.mouse-y / 1px) - self.touch-start-y;
                    if (self.is-dragging-v) {
                        if (dy < -20.0) {
                            root.fast-pull-up();
                        } else {
                            root.drag-released(dy * 1px, 0.0);
                        }
                    } else if (Math.abs(dx) > 25.0 && Math.abs(dx) > Math.abs(dy) * 1.1) {
                        // Horizontal swipe between Notifications and Quick Settings
                        if (dx < -25.0) {
                            root.is-full-qs = true; // swipe left -> Quick Settings
                            root.mode-changed(true);
                        } else if (dx > 25.0) {
                            root.is-full-qs = false; // swipe right -> Notifications
                            root.mode-changed(false);
                        }
                    }
                    self.is-dragging-v = false;
                }
            }
            moved => {
                if (self.pressed) {
                    let dy = (self.mouse-y / 1px) - self.touch-start-y;
                    let dx = (self.mouse-x / 1px) - self.touch-start-x;
                    if (dy < -15.0 && Math.abs(dy) > Math.abs(dx)) {
                        self.is-dragging-v = true;
                        root.drag-delta(dy * 1px);
                    }
                }
            }
        }

        normal-view := Rectangle {
            x: 0px;
            y: root.edit-mode ? -30px : 0px;
            width: parent.width;
            height: parent.height - 36px;
            background: #101418e6;
            border-bottom-left-radius: 32px;
            border-bottom-right-radius: 32px;
            opacity: root.edit-mode ? 0.0 : 1.0;
            visible: !root.edit-mode || self.opacity > 0.01;
            clip: true;

            animate opacity, y {
                duration: 260ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            // =====================================================================
            // FLOATING STATUS PILLS (At the top of the shade card, starting from y: 8px)
            // =====================================================================
            floating-status-bar := HorizontalLayout {
                x: root.pad;
                y: 8px;
                width: parent.width - 2 * root.pad;
                height: 28px;
                alignment: space-between;

                // Date Pill (Left: Monday, Oct 26)
                date-pill := Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: #23282e;
                    border-width: 1px;
                    border-color: Theme.specular-rim;
                    clip: true;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.date-text;
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.on-surface;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // Status Pill (Right: Wifi, Bell, Battery 100%)
                status-pill := Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: #23282e;
                    border-width: 1px;
                    border-color: Theme.specular-rim;
                    clip: true;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 7px;
                        alignment: center;

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "wifi";
                                icon-size: 13px;
                                icon-color: Theme.on-surface;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "bell";
                                icon-size: 12px;
                                icon-color: Theme.on-surface;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                name: "battery";
                                icon-size: 13px;
                                icon-color: #a8c7fa;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "\{root.battery-pct}%";
                                font-size: 10px;
                                font-weight: 800;
                                color: #a8c7fa;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // =================================================================
            // SCREEN 1: NOTIFICATIONS SCREEN
            // =================================================================
            notifications-screen := Rectangle {
                x: root.is-full-qs ? -parent.width : 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                opacity: root.is-full-qs ? 0.0 : 1.0;
                visible: self.opacity > 0.01;

                animate x, opacity {
                    duration: 250ms;
                    easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
                }

                // Giant Android 17 Clock (16:19)
                Text {
                    x: root.pad + 4px;
                    y: 44px;
                    text: root.time-text;
                    font-size: 56px;
                    font-weight: 300;
                    color: #ffffff;
                    letter-spacing: -1.0px;
                }

                // Media Card
                MediaCard {
                    x: root.pad;
                    y: 114px;
                    width: parent.width - 2 * root.pad;
                }

                // Notifications Container Stack
                NotificationStack {
                    x: root.pad;
                    y: 256px;
                    width: parent.width - 2 * root.pad;
                    height: parent.height - 256px - 54px;
                    notifications: root.notifications;
                    dismiss-notification(i) => { root.notification-dismissed(i); }
                    clear-all => { root.clear-notifications(); }
                    open-settings => { root.settings-action(); }
                }

                // Bottom Footer: History (left), Clear all (center), Settings (right)
                HorizontalLayout {
                    x: root.pad;
                    y: parent.height - 48px;
                    width: parent.width - 2 * root.pad;
                    height: 40px;
                    alignment: space-between;

                    // History Button
                    HeaderIconButton {
                        icon-name: "restart";
                        clicked => { root.notification-dismissed(-1); }
                    }

                    // Clear All Rounded Pill Button
                    Rectangle {
                        height: 38px;
                        width: 124px;
                        border-radius: 19px;
                        background: clear-btn-touch.pressed ? #333942 : #23282e;
                        border-width: 1px;
                        border-color: Theme.specular-rim;

                        clear-btn-touch := TouchArea {
                            clicked => { root.clear-notifications(); }
                        }

                        Text {
                            text: "Clear all";
                            font-size: 12px;
                            font-weight: 700;
                            color: #a8c7fa;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Notification Settings Button
                    HeaderIconButton {
                        icon-name: "settings";
                        clicked => { root.settings-action(); }
                    }
                }
            }

            // =================================================================
            // SCREEN 2: QUICK SETTINGS SCREEN
            // =================================================================
            qs-screen := Rectangle {
                x: root.is-full-qs ? 0px : parent.width;
                y: 0px;
                width: parent.width;
                height: parent.height;
                opacity: root.is-full-qs ? 1.0 : 0.0;
                visible: self.opacity > 0.01;

                animate x, opacity {
                    duration: 250ms;
                    easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
                }

                // Battery Until Sub-indicator (1:1 Android 17 / Pixel SystemUI)
                Text {
                    x: parent.width - root.pad - 120px;
                    y: 38px;
                    text: "Until 02:00";
                    font-size: 10px;
                    font-weight: 600;
                    color: #94a3b8;
                    horizontal-alignment: right;
                }

                // Subheader Action Bar: Avatar, Edit Pencil, Settings Gear, Power Button
                HorizontalLayout {
                    x: root.pad;
                    y: 50px;
                    width: parent.width - 2 * root.pad;
                    height: 38px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;

                        // Avatar Circle
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 17px;
                            background: #333942;
                            border-width: 1px;
                            border-color: #ffffff33;
                            Icon {
                                name: "account";
                                icon-size: 18px;
                                icon-color: #a8c7fa;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        // Edit Button
                        HeaderIconButton {
                            icon-name: "edit";
                            clicked => { root.enter-edit-mode(); }
                        }

                        // Settings Gear Button
                        HeaderIconButton {
                            icon-name: "settings";
                            clicked => { root.settings-action(); }
                        }
                    }

                    // Power Button
                    HeaderIconButton {
                        icon-name: "power";
                        clicked => { root.power-action(); }
                    }
                }

                // Media Card
                MediaCard {
                    x: root.pad;
                    y: 94px;
                    width: parent.width - 2 * root.pad;
                }

                // Brightness Slider
                SliderPill {
                    x: root.pad;
                    y: 232px;
                    width: parent.width - 2 * root.pad;
                    value <=> root.brightness;
                    label: "Brightness";
                    changed(v) => { root.brightness-changed(v); }
                }

                // Quick Settings Tiles Flickable Grid
                Flickable {
                    x: root.pad;
                    y: 288px;
                    width: parent.width - 2 * root.pad;
                    height: parent.height - 288px - 8px;
                    content-height: 520px;

                    // Row 1: Internet & Bluetooth (2 large tiles)
                    QSTile {
                        x: 0px;
                        y: 0px;
                        width: root.col-w;
                        title: root.tile-at(0, "internet", "Internet", "wifi").title;
                        subtitle: root.tile-at(0, "internet", "Internet", "wifi").subtitle != "" ? root.tile-at(0, "internet", "Internet", "wifi").subtitle : "Demo SSID";
                        icon-name: "wifi";
                        is-active: root.tile-at(0, "internet", "Internet", "wifi").active;
                        clicked => { root.tile-clicked(root.tile-at(0, "internet", "Internet", "wifi").id); }
                        chevron-clicked => { root.tile-clicked(root.tile-at(0, "internet", "Internet", "wifi").id); }
                        long-pressed => { root.tile-long-pressed(root.tile-at(0, "internet", "Internet", "wifi").id); }
                    }

                    QSTile {
                        x: root.col-w + 12px;
                        y: 0px;
                        width: root.col-w;
                        title: root.tile-at(1, "bluetooth", "Bluetooth", "bluetooth").title;
                        subtitle: root.tile-at(1, "bluetooth", "Bluetooth", "bluetooth").subtitle;
                        icon-name: "bluetooth";
                        is-active: root.tile-at(1, "bluetooth", "Bluetooth", "bluetooth").active;
                        clicked => { root.tile-clicked(root.tile-at(1, "bluetooth", "Bluetooth", "bluetooth").id); }
                        chevron-clicked => { root.tile-clicked(root.tile-at(1, "bluetooth", "Bluetooth", "bluetooth").id); }
                        long-pressed => { root.tile-long-pressed(root.tile-at(1, "bluetooth", "Bluetooth", "bluetooth").id); }
                    }

                    // Row 2: Flashlight & Modes (2 large tiles)
                    QSTile {
                        x: 0px;
                        y: 68px;
                        width: root.col-w;
                        title: root.tile-at(2, "flashlight", "Flashlight", "flashlight").title;
                        subtitle: root.tile-at(2, "flashlight", "Flashlight", "flashlight").subtitle;
                        icon-name: "flashlight";
                        is-active: root.tile-at(2, "flashlight", "Flashlight", "flashlight").active;
                        clicked => { root.tile-clicked(root.tile-at(2, "flashlight", "Flashlight", "flashlight").id); }
                        chevron-clicked => { root.tile-clicked(root.tile-at(2, "flashlight", "Flashlight", "flashlight").id); }
                        long-pressed => { root.tile-long-pressed(root.tile-at(2, "flashlight", "Flashlight", "flashlight").id); }
                    }

                    QSTile {
                        x: root.col-w + 12px;
                        y: 68px;
                        width: root.col-w;
                        title: root.tile-at(3, "dnd", "Modes", "dnd").title;
                        subtitle: root.tile-at(3, "dnd", "Modes", "dnd").subtitle != "" ? root.tile-at(3, "dnd", "Modes", "dnd").subtitle : "No active modes";
                        icon-name: "dnd";
                        is-active: root.tile-at(3, "dnd", "Modes", "dnd").active;
                        clicked => { root.tile-clicked(root.tile-at(3, "dnd", "Modes", "dnd").id); }
                        chevron-clicked => { root.tile-clicked(root.tile-at(3, "dnd", "Modes", "dnd").id); }
                        long-pressed => { root.tile-long-pressed(root.tile-at(3, "dnd", "Modes", "dnd").id); }
                    }

                    // Row 3: 4 Squircle icons (Alarm, Airplane, Wallet, Auto-rotate)
                    HorizontalLayout {
                        x: 0px;
                        y: 136px;
                        width: parent.width;
                        height: 52px;
                        spacing: 8px;

                        QSSquircleTile {
                            horizontal-stretch: 1;
                            icon-name: "alarm";
                            is-active: false;
                            clicked => { root.tile-clicked("alarm"); }
                        }
                        QSSquircleTile {
                            horizontal-stretch: 1;
                            icon-name: "airplane";
                            is-active: root.tile-at(6, "airplane", "Airplane mode", "airplane").active;
                            clicked => { root.tile-clicked(root.tile-at(6, "airplane", "Airplane mode", "airplane").id); }
                        }
                        QSSquircleTile {
                            horizontal-stretch: 1;
                            icon-name: "wallet";
                            is-active: true;
                            clicked => { root.tile-clicked("wallet"); }
                        }
                        QSSquircleTile {
                            horizontal-stretch: 1;
                            icon-name: "rotation";
                            is-active: root.tile-at(4, "rotation", "Auto-rotate", "rotation").active;
                            clicked => { root.tile-clicked(root.tile-at(4, "rotation", "Auto-rotate", "rotation").id); }
                        }
                    }

                    // Row 4: Home & QR code scanner (2 large tiles)
                    QSTile {
                        x: 0px;
                        y: 196px;
                        width: root.col-w;
                        title: "Home";
                        subtitle: "";
                        icon-name: "home";
                        is-active: true;
                        clicked => { root.tile-clicked("home"); }
                    }

                    QSTile {
                        x: root.col-w + 12px;
                        y: 196px;
                        width: root.col-w;
                        title: "QR code scanner";
                        subtitle: "Off";
                        icon-name: "qr";
                        is-active: false;
                        clicked => { root.tile-clicked("qr"); }
                    }

                    // Row 5: Battery Saver & Cast (2 large tiles)
                    QSTile {
                        x: 0px;
                        y: 264px;
                        width: root.col-w;
                        title: root.tile-at(5, "battery_saver", "Battery Saver", "battery").title;
                        subtitle: root.tile-at(5, "battery_saver", "Battery Saver", "battery").subtitle;
                        icon-name: "battery";
                        is-active: root.tile-at(5, "battery_saver", "Battery Saver", "battery").active;
                        clicked => { root.tile-clicked(root.tile-at(5, "battery_saver", "Battery Saver", "battery").id); }
                        chevron-clicked => { root.tile-clicked(root.tile-at(5, "battery_saver", "Battery Saver", "battery").id); }
                        long-pressed => { root.tile-long-pressed(root.tile-at(5, "battery_saver", "Battery Saver", "battery").id); }
                    }

                    QSTile {
                        x: root.col-w + 12px;
                        y: 264px;
                        width: root.col-w;
                        title: "Cast";
                        subtitle: "";
                        icon-name: "cast";
                        is-active: false;
                        clicked => { root.tile-clicked("cast"); }
                    }

                    // Row 6: Screen record & Quick Share (2 large tiles)
                    QSTile {
                        x: 0px;
                        y: 332px;
                        width: root.col-w;
                        title: "Screen record";
                        subtitle: "Start";
                        icon-name: "recorder";
                        is-active: false;
                        clicked => { root.tile-clicked("recorder"); }
                    }

                    QSTile {
                        x: root.col-w + 12px;
                        y: 332px;
                        width: root.col-w;
                        title: "Quick Share";
                        subtitle: "Contacts";
                        icon-name: "share";
                        is-active: true;
                        clicked => { root.tile-clicked("share"); }
                    }

                    // Row 7: Security & privacy & Data Saver (2 large tiles)
                    QSTile {
                        x: 0px;
                        y: 400px;
                        width: root.col-w;
                        title: "Security & privacy";
                        subtitle: "Check status";
                        icon-name: "shield";
                        is-active: false;
                        clicked => { root.tile-clicked("security"); }
                    }

                    QSTile {
                        x: root.col-w + 12px;
                        y: 400px;
                        width: root.col-w;
                        title: "Data Saver";
                        subtitle: "Off";
                        icon-name: "dnd";
                        is-active: false;
                        clicked => { root.tile-clicked("datasaver"); }
                    }
                }
            }
        }

        // =====================================================================
        // VIEW B: MODERN SLATE EDITOR (1:1 with Android 17 / Pixel SystemUI)
        // =====================================================================
        slate-editor-view := Rectangle {
            x: 0px;
            y: root.edit-mode ? 0px : 30px;
            width: parent.width;
            height: parent.height - 36px;
            opacity: root.edit-mode ? 1.0 : 0.0;
            visible: root.edit-mode || self.opacity > 0.01;

            animate opacity, y {
                duration: 260ms;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            // Top App Bar
            HorizontalLayout {
                x: root.pad;
                y: 12px;
                width: parent.width - 2 * root.pad;
                height: 52px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    HeaderIconButton {
                        icon-name: "chevron-left";
                        clicked => { root.exit-edit-mode(); }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "Edit tiles";
                            font-size: 20px;
                            font-weight: 800;
                            color: Theme.on-surface;
                        }
                        Text {
                            text: "Hold & drag to reorder";
                            font-size: 12px;
                            font-weight: 500;
                            color: Theme.on-surface-variant;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    // Reset button
                    PillButton {
                        text: "Reset";
                        icon-name: "restart";
                        is-accent: false;
                        clicked => { root.reset-tiles(); }
                    }

                    // Done button
                    PillButton {
                        text: "Done";
                        icon-name: "check";
                        is-accent: true;
                        clicked => { root.exit-edit-mode(); }
                    }
                }
            }

            // Slate Editor Scrollable Canvas
            Flickable {
                x: root.pad;
                y: 72px;
                width: parent.width - 2 * root.pad;
                height: parent.height - 84px;
                content-height: editor-content.min-height;

                editor-content := VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 50px;
                    spacing: 16px;

                    // 1. ACTIVE TILES SECTION
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "ACTIVE TILES";
                                font-size: 11px;
                                font-weight: 800;
                                color: #d0bcff;
                            }
                            Rectangle {
                                height: 20px;
                                border-radius: 10px;
                                background: #38353d;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "\{root.active-tiles.length} active";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #cac4d0;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Tiles visible in quick settings. Tap - to remove.";
                            font-size: 11px;
                            color: #938f99;
                        }
                    }

                    // Active Tiles 2-Column Grid
                    Rectangle {
                        width: 100%;
                        height: ((root.active-tiles.length + 1) / 2) * 72px;

                        for tile[idx] in root.active-tiles: EditTileItem {
                            x: Math.mod(idx, 2) == 0 ? 0px : (root.col-w + 12px);
                            y: Math.floor(idx / 2) * 72px;
                            width: root.col-w;
                            title: tile.title;
                            subtitle: tile.subtitle;
                            icon-name: tile.icon-name;
                            is-removable: true;
                            action => { root.remove-tile(tile.id); }
                        }
                    }

                    // 2. REORDER / DIVIDER BANNER
                    Rectangle {
                        height: 42px;
                        border-radius: 21px;
                        background: #2b2735;
                        border-width: 1px;
                        border-color: Theme.specular-rim;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            alignment: center;
                            Icon { name: "edit"; icon-size: 16px; icon-color: #d0bcff; }
                            Text {
                                text: "Hold and drag tiles to reorder";
                                font-size: 12px;
                                font-weight: 600;
                                color: #e6e0e9;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // 3. AVAILABLE TILES SECTION
                    VerticalLayout {
                        spacing: 4px;
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "AVAILABLE TILES";
                                font-size: 11px;
                                font-weight: 800;
                                color: #adc6ff;
                            }
                            Rectangle {
                                height: 20px;
                                border-radius: 10px;
                                background: #252836;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "\{root.available-tiles.length} available";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #adc6ff;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Tap + to add tile to your active shade.";
                            font-size: 11px;
                            color: #938f99;
                        }
                    }

                    // Available Tiles 2-Column Grid
                    Rectangle {
                        width: 100%;
                        height: ((root.available-tiles.length + 1) / 2) * 72px;

                        for tile[idx] in root.available-tiles: EditTileItem {
                            x: Math.mod(idx, 2) == 0 ? 0px : (root.col-w + 12px);
                            y: Math.floor(idx / 2) * 72px;
                            width: root.col-w;
                            title: tile.title;
                            subtitle: tile.subtitle;
                            icon-name: tile.icon-name;
                            is-removable: false;
                            action => { root.add-tile(tile.id); }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // Drag Handle: Glued to bottom of visible drawer
        // ---------------------------------------------------------------------
        bottom-handle-bar := Rectangle {
            x: 0px;
            y: parent.height - 36px;
            width: parent.width;
            height: 36px;
            background: transparent;

            Rectangle {
                width: 72px;
                height: 5px;
                x: (parent.width - self.width) / 2;
                y: 16px;
                border-radius: 2.5px;
                background: Theme.specular-rim-glow;
                opacity: 0.85;
            }

            TouchArea {
                property <length> press-y: 0px;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.press-y = self.mouse-y;
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        let dy = self.mouse-y - self.press-y;
                        if (dy < -10px) {
                            root.fast-pull-up();
                        }
                    }
                }
                clicked => {
                    root.close-requested();
                }
            }
        }
    }
}
