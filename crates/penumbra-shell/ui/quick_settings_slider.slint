import { Theme } from "theme.slint";
import { Icon } from "icon.slint";

export struct TileData {
    id: string,
    title: string,
    subtitle: string,
    icon-name: string,
    active: bool,
    enabled: bool,
}

export struct NotificationData {
    app: string,
    title: string,
    body: string,
}

// Single morphing tile: `morph` 0.0 = compact icon cell, 1.0 = full pastille.
// Stacked Notification Pastille with swipe-to-dismiss gesture
component NotificationCard inherits Rectangle {
    in property <NotificationData> data;
    in property <int> index;
    callback dismiss(int);

    property <length> swipe-x: 0px;
    property <float> touch-start-x: 0.0;
    property <bool> is-swiping: false;

    height: 72px;
    background: transparent;

    card := Rectangle {
        x: root.swipe-x;
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius-item;
        background: Theme.surface-container-low;
        border-width: 1px;
        border-color: Theme.specular-rim;
        opacity: 1.0 - Math.clamp(Math.abs(root.swipe-x) / 180px, 0.0, 1.0);

        animate x { duration: root.is-swiping ? 0ms : 200ms; easing: ease-out; }
        animate opacity { duration: root.is-swiping ? 0ms : 200ms; easing: ease-out; }

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.touch-start-x = self.mouse-x / 1px;
                    root.is-swiping = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.is-swiping = false;
                    if (Math.abs(root.swipe-x) > 100px) {
                        root.dismiss(root.index);
                    } else {
                        root.swipe-x = 0px;
                    }
                }
            }
            moved => {
                if (self.pressed) {
                    let dx = (self.mouse-x / 1px) - root.touch-start-x;
                    root.swipe-x = dx * 1px;
                }
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            alignment: center;

            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: Theme.radius-pill;
                background: Theme.primary-container;
                Icon {
                    name: "bell";
                    icon-size: 19px;
                    icon-color: Theme.primary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text { text: root.data.app; font-size: Theme.font-caption; color: Theme.on-surface-variant; overflow: elide; }
                Text { text: root.data.title; font-size: Theme.font-body; font-weight: 700; color: Theme.on-surface; overflow: elide; }
                Text { text: root.data.body; font-size: Theme.font-caption; color: Theme.on-surface-variant; overflow: elide; }
            }
        }
    }
}

// Single morphing tile: `morph` 0.0 = compact icon cell, 1.0 = full pastille.
// Material 3 Expressive tactile squash: 0.96x compression on pointer down.
component TileView inherits Rectangle {
    in property <float> morph: 1.0;
    in property <TileData> data;
    callback clicked();
    callback long-pressed();

    property <float> touch-start-x: 0.0;
    property <float> touch-start-y: 0.0;
    property <bool> is-down: false;
    property <bool> did-long-press: false;

    background: transparent;
    opacity: root.data.enabled ? 1.0 : 0.5;

    lp-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.is-down) {
                root.did-long-press = true;
                root.long-pressed();
            }
        }
    }

    // Inner tile container that compresses 0.96x on pointer down
    inner-tile := Rectangle {
        property <length> squash-dx: root.is-down ? 2.5px : 0px;
        property <length> squash-dy: root.is-down ? 1.5px : 0px;

        x: self.squash-dx;
        y: self.squash-dy;
        width: parent.width - 2 * self.squash-dx;
        height: parent.height - 2 * self.squash-dy;

        border-radius: root.is-down ? Theme.radius-tile-squash : (Theme.radius-item + (Theme.radius-tile - Theme.radius-item) * root.morph);
        background: !root.data.enabled ? Theme.surface-container-low : (root.data.active ? (root.is-down ? Theme.primary.brighter(8%) : Theme.primary) : (root.is-down ? Theme.surface-container-highest : Theme.surface-container-high));
        border-width: 1px;
        border-color: root.data.active ? Theme.specular-rim-active : Theme.specular-rim;
        clip: true;

        animate x, y, width, height, border-radius {
            duration: Theme.duration-short;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }
        animate background, border-color {
            duration: Theme.duration-short;
            easing: ease-out;
        }

        // Icon badge slides from the cell centre (compact QQS) to the left edge (expanded QS).
        Rectangle {
            width: 38px;
            height: 38px;
            x: (parent.width - self.width) / 2 * (1.0 - root.morph) + 12px * root.morph;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-pill;
            background: root.data.active ? Theme.on-primary : Theme.surface-container-highest;

            animate x, background {
                duration: Theme.duration-short;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }

            Icon {
                name: root.data.icon-name;
                icon-size: 19px;
                icon-color: root.data.active ? Theme.primary : Theme.on-surface;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            x: 58px;
            width: Math.max(0px, parent.width - 66px);
            y: 0px;
            height: parent.height;
            alignment: center;
            spacing: 2px;
            opacity: Math.clamp((root.morph - 0.25) / 0.55, 0.0, 1.0);

            Text {
                text: root.data.title;
                font-size: Theme.font-body;
                font-weight: 700;
                color: root.data.active ? Theme.on-primary : Theme.on-surface;
                overflow: elide;
            }
            Text {
                text: root.data.subtitle;
                font-size: Theme.font-caption;
                color: root.data.active ? Theme.on-primary : Theme.on-surface-variant;
                overflow: elide;
            }
        }
    }

    TouchArea {
        pointer-event(event) => {
            if (!root.data.enabled) { return; }
            if (event.kind == PointerEventKind.down) {
                root.touch-start-x = self.mouse-x / 1px;
                root.touch-start-y = self.mouse-y / 1px;
                root.is-down = true;
                root.did-long-press = false;
                lp-timer.running = true;
            } else if (event.kind == PointerEventKind.move) {
                if (root.is-down) {
                    let dx = Math.abs((self.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((self.mouse-y / 1px) - root.touch-start-y);
                    if (dx > 12.0 || dy > 12.0) {
                        lp-timer.running = false;
                    }
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                lp-timer.running = false;
                if (root.is-down) {
                    root.is-down = false;
                    let dx = Math.abs((self.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((self.mouse-y / 1px) - root.touch-start-y);
                    if (!root.did-long-press && dx < 12.0 && dy < 12.0) {
                        root.clicked();
                    }
                }
            }
        }
    }
}

component SliderPill inherits Rectangle {
    in-out property <float> value: 0.75;
    in property <string> icon-name: "brightness";
    in property <string> label: "Brightness";
    callback changed(float);

    property <length> stretch-offset: 0px;
    property <bool> is-dragging: false;

    // Dynamic icon morphing based on fill ratio
    property <string> resolved-icon: root.icon-name == "brightness"
        ? (root.value < 0.35 ? "brightness-low" : "brightness")
        : (root.icon-name == "volume"
            ? (root.value <= 0.01 ? "volume-mute" : (root.value < 0.5 ? "volume-low" : "volume"))
            : root.icon-name);

    height: 52px;
    background: transparent;

    inner-slider := Rectangle {
        property <length> squash-y: root.is-dragging ? 1.5px : 0px;
        property <length> visual-w: Math.clamp(parent.width + root.stretch-offset, parent.width - 24px, parent.width + 24px);

        x: (parent.width - self.visual-w) / 2;
        y: self.squash-y;
        width: self.visual-w;
        height: parent.height - 2 * self.squash-y;

        border-radius: Theme.radius-pill;
        background: Theme.surface-container-high;
        border-width: 1px;
        border-color: root.is-dragging ? Theme.specular-rim-active : Theme.specular-rim;
        clip: true;

        animate x, y, width, height, border-color {
            duration: root.is-dragging ? 0ms : Theme.duration-short;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        // Active fill level with boundary stretch expansion
        fill-bar := Rectangle {
            x: 0px;
            y: 0px;
            width: Math.clamp(parent.width * Math.clamp(root.value, 0.0, 1.0) + (root.stretch-offset > 0px ? root.stretch-offset : 0px), 0px, parent.width);
            height: parent.height;
            background: Theme.primary;
            border-radius: Theme.radius-pill;

            animate width {
                duration: root.is-dragging ? 0ms : Theme.duration-short;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }
        }

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            spacing: 12px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Rectangle {
                    width: 22px;
                    height: 22px;
                    Icon {
                        name: root.resolved-icon;
                        icon-size: 20px;
                        icon-color: root.value > 0.08 ? Theme.on-primary : Theme.on-surface;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Text {
                    text: root.label;
                    font-size: Theme.font-label;
                    font-weight: 700;
                    color: root.value > 0.38 ? Theme.on-primary : Theme.on-surface;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "\{Math.round(root.value * 100.0)}%";
                font-size: Theme.font-caption;
                font-weight: 700;
                color: root.value > 0.88 ? Theme.on-primary : Theme.on-surface-variant;
                vertical-alignment: center;
            }
        }
    }

    slider-touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.is-dragging = true;
                root.update-slider(slider-touch.mouse-x);
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.is-dragging = false;
                root.stretch-offset = 0px;
            }
        }
        moved => {
            if (slider-touch.pressed) {
                root.update-slider(slider-touch.mouse-x);
            }
        }
    }

    function update-slider(touch-x: length) {
        if (touch-x < 0px) {
            root.value = 0.0;
            let dx = Math.abs(touch-x / 1px);
            root.stretch-offset = -Math.sqrt(dx * 1.5) * 1px;
        } else if (touch-x > root.width) {
            root.value = 1.0;
            let dx = (touch-x - root.width) / 1px;
            root.stretch-offset = Math.sqrt(dx * 1.5) * 1px;
        } else {
            root.value = Math.clamp(touch-x / root.width, 0.0, 1.0);
            root.stretch-offset = 0px;
        }
        root.changed(root.value);
    }
}

component SmallButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> accent: false;
    in property <length> button-width: 30px;
    callback clicked();
    width: root.button-width;
    height: 30px;
    border-radius: 15px;
    background: root.accent ? Theme.primary : Theme.surface-highest;
    if root.icon != "": Icon {
        name: root.icon;
        icon-size: 16px;
        icon-color: root.accent ? Theme.on-primary : Theme.on-surface;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.icon == "": Text {
        text: root.label;
        font-size: 12px;
        font-weight: 700;
        color: root.accent ? Theme.on-primary : Theme.on-surface;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component QuickSettingsSlider inherits Rectangle {
    // Rust drives `slide-offset-y` in [-915px, 0px]; the visible shade height is its offset from closed.
    in-out property <length> slide-offset-y: -915px;
    in property <float> expansion-progress: 0.0;
    in-out property <bool> edit-mode: false;

    in-out property <float> brightness: 0.75;
    in-out property <float> volume: 0.60;
    in-out property <string> time-text: "12:00";
    in-out property <string> date-text: "Wednesday, Oct 21";
    in-out property <string> carrier-text: "Penumbra 5G";
    in property <int> battery-pct: 100;

    in property <[TileData]> active-tiles;
    in property <[TileData]> available-tiles;
    in property <[NotificationData]> notifications;

    callback close-requested();
    callback power-action();
    callback settings-action();
    callback brightness-changed(float);
    callback volume-changed(float);
    callback tile-clicked(string /* id */);
    callback tile-long-pressed(string /* id */);
    callback enter-edit-mode();
    callback exit-edit-mode();
    callback reset-tiles();
    callback reorder-tiles(int, int);
    callback remove-tile(string);
    callback add-tile(string);
    callback drag-delta(length /* dy */);
    callback drag-released(length /* current_y */, float /* velocity */);
    callback fast-pull-up();
    callback notification-dismissed(int);
    callback clear-notifications();

    // Visible shade height in px (0 = closed .. 915 = fully open).
    property <length> disp: Math.clamp(root.slide-offset-y + 915px, 0px, 915px);
    // Stage 1 (QQS + notifications) up to ~300px, then continuous morph to full QS by ~700px.
    property <float> morph: root.edit-mode ? 1.0 : Math.clamp((root.disp - 300px) / 400px, 0.0, 1.0);
    property <length> pad: 16px;
    property <length> grid-top: 108px;
    property <int> n-tiles: root.active-tiles.length;
    property <length> grid-h: Math.ceil(root.n-tiles / 2) * 76px;
    property <length> tiles-h: 64px + (Math.max(root.grid-h, 64px) - 64px) * root.morph;
    property <length> below-tiles: root.grid-top + root.tiles-h + 12px;
    property <length> qs-block-h: 48px + 8px + 48px + 8px + 72px + 12px;

    background: transparent;

    // Tap or swipe up on the scrim below the shade to dismiss.
    scrim-touch := TouchArea {
        y: root.disp;
        width: parent.width;
        height: Math.max(0px, parent.height - self.y);
        property <length> press-y: 0px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.press-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                let dy = self.mouse-y - self.press-y;
                if (dy < -15px) {
                    root.fast-pull-up();
                } else if (Math.abs(dy) < 12px) {
                    root.close-requested();
                }
            }
        }
    }

    // The shade is a window that reveals fixed content (clip), not a card that translates.
    chassis := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.disp;
        background: transparent;
        border-bottom-left-radius: 28px;
        border-bottom-right-radius: 28px;
        clip: true;

        // Full-body gesture listener for swiping / dragging anywhere on the shade background
        shade-touch := TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            property <length> press-y: 0px;
            property <length> last-pos-y: 0px;
            property <float> velocity: 0.0;
            property <bool> is-dragging: false;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.press-y = self.mouse-y;
                    self.last-pos-y = self.mouse-y;
                    self.velocity = 0.0;
                    self.is-dragging = false;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    let total-dy = self.mouse-y - self.press-y;
                    if (self.is-dragging) {
                        if (self.velocity < -120.0 || total-dy < -40px) {
                            root.fast-pull-up();
                        } else {
                            root.drag-released(root.slide-offset-y, self.velocity);
                        }
                    } else if (total-dy < -25px || self.velocity < -120.0) {
                        root.fast-pull-up();
                    }
                    self.is-dragging = false;
                }
            }

            moved => {
                if (self.pressed) {
                    let total-dy = self.mouse-y - self.press-y;
                    let delta = self.mouse-y - self.last-pos-y;
                    self.velocity = self.velocity * 0.6 + (delta / 1px / 0.016) * 0.4;
                    self.last-pos-y = self.mouse-y;

                    if (Math.abs(total-dy) > 6px) {
                        self.is-dragging = true;
                        root.drag-delta(delta);
                    }
                }
            }
        }

        // ---- Header ----
        VerticalLayout {
            x: root.pad;
            y: 46px;
            width: parent.width - 2 * root.pad - 150px;
            height: 44px;
            spacing: 2px;
            alignment: center;
            Text {
                text: root.time-text;
                font-size: 22px + 8px * root.morph;
                font-weight: 800;
                color: Theme.on-surface;
            }
            Text {
                text: "\{root.date-text} • \{root.carrier-text} • \{root.battery-pct}%";
                font-size: 11px;
                color: Theme.on-surface-variant;
                overflow: elide;
            }
        }
        HorizontalLayout {
            x: parent.width - root.pad - 138px;
            y: 51px;
            width: 138px;
            height: 34px;
            spacing: 6px;
            alignment: end;
            if root.morph > 0.5 || root.edit-mode: SmallButton {
                icon: "edit";
                button-width: 34px;
                accent: root.edit-mode;
                clicked => { if (root.edit-mode) { root.exit-edit-mode(); } else { root.enter-edit-mode(); } }
            }
            SmallButton { icon: "settings"; button-width: 34px; clicked => { root.settings-action(); } }
            SmallButton { icon: "power"; button-width: 34px; clicked => { root.power-action(); } }
        }

        // ---- Normal mode ----
        if !root.edit-mode: Rectangle {
            width: parent.width;
            height: parent.height;

            // Morphing tiles: compact 4-up strip -> 2-column pastille grid
            for tile[i] in root.active-tiles: TileView {
                property <length> cw4: (parent.width - 2 * root.pad - 30px) / 4;
                property <length> cw2: (parent.width - 2 * root.pad - 12px) / 2;
                property <length> cx: root.pad + i * (self.cw4 + 10px);
                property <length> ex: root.pad + Math.mod(i, 2) * (self.cw2 + 12px);
                property <length> ey: root.grid-top + Math.floor(i / 2) * 76px;
                morph: root.morph;
                data: tile;
                // tiles beyond the 4th only exist in the full grid
                visible: i < 4 || root.morph > 0.02;
                opacity: i < 4 ? 1.0 : root.morph;
                x: i < 4 ? self.cx + (self.ex - self.cx) * root.morph : self.ex;
                y: root.grid-top + (self.ey - root.grid-top) * root.morph;
                width: i < 4 ? self.cw4 + (self.cw2 - self.cw4) * root.morph : self.cw2;
                height: 64px;
                clicked => { root.tile-clicked(tile.id); }
                long-pressed => { root.tile-long-pressed(tile.id); }
            }

            // Sliders + media (Stage 2)
            if root.morph > 0.05: Rectangle {
                x: root.pad;
                y: root.below-tiles;
                width: parent.width - 2 * root.pad;
                height: root.qs-block-h;
                opacity: Math.clamp((root.morph - 0.15) / 0.6, 0.0, 1.0);

                SliderPill {
                    y: 0px;
                    value <=> root.brightness;
                    icon-name: "brightness";
                    label: "Brightness";
                    changed(v) => { root.brightness-changed(v); }
                }
                SliderPill {
                    y: 56px;
                    value <=> root.volume;
                    icon-name: "volume";
                    label: "Media volume";
                    changed(v) => { root.volume-changed(v); }
                }
                Rectangle {
                    y: 112px;
                    height: 72px;
                    border-radius: Theme.radius-tile;
                    background: Theme.surface-low;
                    border-width: 1px;
                    border-color: Theme.specular-rim;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 12px;
                            background: Theme.primary-container;
                            Icon { name: "music"; icon-size: 22px; icon-color: Theme.primary; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "Nothing playing"; font-size: 13px; font-weight: 700; color: Theme.on-surface; }
                            Text { text: "MPRIS player"; font-size: 11px; color: Theme.on-surface-variant; }
                        }
                    }
                }
            }

            // Notification stack: sits under the compact strip, gets pushed down as QS expands
            VerticalLayout {
                x: root.pad;
                y: root.below-tiles + root.qs-block-h * root.morph;
                width: parent.width - 2 * root.pad;
                spacing: 10px;

                if root.notifications.length == 0: Text {
                    text: "No notifications";
                    font-size: Theme.font-label;
                    color: Theme.on-surface-variant;
                    horizontal-alignment: center;
                }

                for n[idx] in root.notifications: NotificationCard {
                    data: n;
                    index: idx;
                    dismiss(i) => { root.notification-dismissed(i); }
                }

                if root.notifications.length > 0: HorizontalLayout {
                    alignment: end;
                    padding-top: 4px;
                    Rectangle {
                        height: 32px;
                        width: 92px;
                        border-radius: Theme.radius-pill;
                        background: clear-btn-touch.pressed ? Theme.surface-container-highest : Theme.surface-container-high;
                        border-width: 1px;
                        border-color: Theme.specular-rim;
                        animate background { duration: Theme.duration-short; }

                        clear-btn-touch := TouchArea {
                            clicked => { root.clear-notifications(); }
                        }

                        Text {
                            text: "Clear all";
                            font-size: Theme.font-caption;
                            font-weight: 700;
                            color: Theme.primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ---- Edit mode ----
        if root.edit-mode: Rectangle {
            width: parent.width;
            height: parent.height;
            property <length> cw: (parent.width - 2 * root.pad - 10px) / 2;

            Text {
                x: root.pad;
                y: 88px;
                text: "Reorder with arrows, remove with close";
                font-size: 12px;
                font-weight: 600;
                color: Theme.on-surface-variant;
            }
            for tile[i] in root.active-tiles: Rectangle {
                x: root.pad + Math.mod(i, 2) * (parent.cw + 10px);
                y: 112px + Math.floor(i / 2) * 64px;
                width: parent.cw;
                height: 56px;
                border-radius: 16px;
                background: Theme.surface-high;
                border-width: 1px;
                border-color: Theme.specular-rim;
                Text { x: 12px; width: parent.width - 108px; text: tile.title; font-size: 12px; font-weight: 600; color: Theme.on-surface; vertical-alignment: center; overflow: elide; }
                HorizontalLayout {
                    x: parent.width - 96px;
                    y: 13px;
                    width: 90px;
                    spacing: 3px;
                    SmallButton { icon: "chevron-left"; button-width: 28px; clicked => { root.reorder-tiles(i, i - 1); } }
                    SmallButton { icon: "chevron-right"; button-width: 28px; clicked => { root.reorder-tiles(i, i + 1); } }
                    SmallButton { icon: "close"; button-width: 28px; clicked => { root.remove-tile(tile.id); } }
                }
            }

            Rectangle {
                x: root.pad;
                y: 112px + Math.ceil(root.active-tiles.length / 2) * 64px + 8px;
                width: parent.width - 2 * root.pad;
                height: 1px;
                background: Theme.specular-rim;
            }
            Text {
                x: root.pad;
                y: 112px + Math.ceil(root.active-tiles.length / 2) * 64px + 18px;
                text: "Available tiles — tap + to add";
                font-size: 12px;
                font-weight: 600;
                color: Theme.on-surface-variant;
            }
            for tile[i] in root.available-tiles: Rectangle {
                x: root.pad + Math.mod(i, 2) * (parent.cw + 10px);
                y: 112px + Math.ceil(root.active-tiles.length / 2) * 64px + 42px + Math.floor(i / 2) * 64px;
                width: parent.cw;
                height: 56px;
                border-radius: 16px;
                background: Theme.surface-low;
                border-width: 1px;
                border-color: Theme.specular-rim;
                Text { x: 12px; width: parent.width - 52px; text: tile.title; font-size: 12px; color: Theme.on-surface; vertical-alignment: center; overflow: elide; }
                SmallButton {
                    x: parent.width - 40px;
                    y: 13px;
                    icon: "plus";
                    accent: true;
                    clicked => { root.add-tile(tile.id); }
                }
            }

            SmallButton {
                x: root.pad;
                y: 790px;
                label: "Reset";
                button-width: 96px;
                clicked => { root.reset-tiles(); }
            }
            SmallButton {
                x: parent.width - root.pad - 96px;
                y: 790px;
                label: "Done";
                accent: true;
                button-width: 96px;
                clicked => { root.exit-edit-mode(); }
            }
        }

        // ---- Drag handle, glued to the bottom of the visible shade ----
        Rectangle {
            x: 0px;
            y: parent.height - 36px;
            width: parent.width;
            height: 36px;
            background: transparent;

            Rectangle {
                width: 48px;
                height: 5px;
                x: (parent.width - self.width) / 2;
                y: 22px;
                border-radius: 2.5px;
                background: Theme.specular-rim-glow;
                opacity: root.disp > 880px ? 0.4 : 1.0;
            }

            handle-touch := TouchArea {
                property <length> press-y: 0px;
                property <length> last-pos-y: 0px;
                property <float> velocity: 0.0;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        self.press-y = handle-touch.mouse-y;
                        self.last-pos-y = handle-touch.mouse-y;
                        self.velocity = 0.0;
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                        let total-dy = handle-touch.mouse-y - self.press-y;
                        if (self.velocity < -120.0 || total-dy < -30px) {
                            root.fast-pull-up();
                        } else {
                            root.drag-released(root.slide-offset-y, self.velocity);
                        }
                    }
                }

                moved => {
                    if (handle-touch.pressed) {
                        // mouse-y is relative to this (moving) area, so the delta is the true finger motion.
                        let delta = handle-touch.mouse-y - self.last-pos-y;
                        // low-pass filtered velocity in px/s assuming ~60Hz motion events
                        self.velocity = self.velocity * 0.6 + (delta / 1px / 0.016) * 0.4;
                        self.last-pos-y = handle-touch.mouse-y;
                        root.drag-delta(delta);
                    }
                }
            }
        }
    }
}
