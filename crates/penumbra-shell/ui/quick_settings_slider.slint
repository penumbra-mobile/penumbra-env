import { Theme } from "theme.slint";
import { Icon } from "icon.slint";
import { NotificationData, NotificationCard, NotificationEmptyState, NotificationStack } from "notifications.slint";

export { NotificationData }

export struct TileData {
    id: string,
    title: string,
    subtitle: string,
    icon-name: string,
    active: bool,
    enabled: bool,
}

// =========================================================================
// Android 17 Marquee / Horizontal Scrolling Text Component
// =========================================================================
export component MarqueeText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 14px;
    in property <int> font-weight: 500;
    in property <color> text-color: #ffffff;

    width: 100%;
    horizontal-stretch: 1;
    clip: true;
    background: transparent;

    property <length> scroll-offset: 0px;
    property <bool> is-overflowing: txt.preferred-width > root.width && root.width > 10px;

    marquee-timer := Timer {
        interval: 35ms;
        running: root.is-overflowing;
        triggered => {
            if (root.is-overflowing) {
                root.scroll-offset = root.scroll-offset - 1.2px;
                if (root.scroll-offset < -(txt.preferred-width + 24px)) {
                    root.scroll-offset = 12px;
                }
            } else {
                root.scroll-offset = 0px;
            }
        }
    }

    txt := Text {
        x: root.is-overflowing ? root.scroll-offset : 0px;
        y: 0px;
        height: parent.height;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.text-color;
        vertical-alignment: center;
    }
}

// =========================================================================
// Material 3 Expressive QSTile Component
// =========================================================================
export component QSTile inherits Rectangle {
    in property <string> title: "Internet";
    in property <string> subtitle: "Connected";
    in property <image> icon;
    in property <string> icon-name: "";
    in property <bool> is-active: false;
    in property <bool> has-chevron: true;

    callback clicked();
    callback chevron-clicked();
    callback long-pressed();

    property <bool> is-down: false;
    property <bool> did-long-press: false;
    property <float> touch-start-x: 0.0;
    property <float> touch-start-y: 0.0;

    height: 64px;
    background: transparent;

    // Tactile Touch Squash Inner Chassis (0.96x compression on press)
    inner-tile := Rectangle {
        x: root.is-down ? 2.5px : 0px;
        y: root.is-down ? 1.5px : 0px;
        width: parent.width - (root.is-down ? 5px : 0px);
        height: parent.height - (root.is-down ? 3px : 0px);
        border-radius: root.is-down ? 22px : (root.is-active ? 28px : 20px);
        background: root.is-active ? #a8c7fa : (root.is-down ? #38353d : #23282e);
        border-width: 1px;
        border-color: root.is-active ? #ffffff44 : Theme.specular-rim;
        clip: true;

        animate x, y, width, height { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate background { duration: 180ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate border-radius { duration: 200ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: transparent;

                    if root.icon-name != "": Icon {
                        name: root.icon-name;
                        icon-size: 24px;
                        icon-color: root.is-active ? #04324a : #e6e0e9;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        animate icon-color { duration: 180ms; easing: ease-out; }
                    }
                    if root.icon-name == "": Image {
                        source: root.icon;
                        width: 24px;
                        height: 24px;
                        colorize: root.is-active ? #04324a : #e6e0e9;
                        animate colorize { duration: 180ms; easing: ease-out; }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                MarqueeText {
                    height: 18px;
                    text: root.title;
                    font-size: 14px;
                    font-weight: 700;
                    text-color: root.is-active ? #04324a : #e6e0e9;
                }

                if root.subtitle != "": MarqueeText {
                    height: 16px;
                    text: root.subtitle;
                    font-size: 12px;
                    font-weight: 500;
                    text-color: root.is-active ? #04324a : #cac4d0;
                }
            }

            if root.has-chevron: VerticalLayout {
                alignment: center;
                TouchArea {
                    width: 28px;
                    height: 28px;
                    clicked => { root.chevron-clicked(); }
                    Icon {
                        name: "chevron-right";
                        icon-size: 16px;
                        icon-color: root.is-active ? #04324a : #cac4d0;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        animate icon-color { duration: 180ms; }
                    }
                }
            }
        }
    }

    lp-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.is-down) {
                root.did-long-press = true;
                root.long-pressed();
            }
        }
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.touch-start-x = self.mouse-x / 1px;
                root.touch-start-y = self.mouse-y / 1px;
                root.is-down = true;
                root.did-long-press = false;
                lp-timer.running = true;
            } else if (event.kind == PointerEventKind.move) {
                if (root.is-down) {
                    let dx = Math.abs((self.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((self.mouse-y / 1px) - root.touch-start-y);
                    if (dx > 12.0 || dy > 12.0) { lp-timer.running = false; }
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                lp-timer.running = false;
                if (root.is-down) {
                    root.is-down = false;
                    let dx = Math.abs((self.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((self.mouse-y / 1px) - root.touch-start-y);
                    if (!root.did-long-press && dx < 14.0 && dy < 14.0) {
                        root.clicked();
                    }
                }
            }
        }
    }
}

// =========================================================================
// Modern Slate Editor Tile Item (Android 17 1:1)
// =========================================================================
component EditTileItem inherits Rectangle {
    in property <string> title: "Tile";
    in property <string> subtitle: "Off";
    in property <string> icon-name: "wifi";
    in property <bool> is-removable: true;
    callback action();

    property <bool> is-down: false;

    height: 64px;
    background: transparent;

    inner-box := Rectangle {
        x: root.is-down ? 2px : 0px;
        y: root.is-down ? 1.5px : 0px;
        width: parent.width - (root.is-down ? 4px : 0px);
        height: parent.height - (root.is-down ? 3px : 0px);
        border-radius: root.is-down ? 18px : 22px;
        background: root.is-down ? #38343f : (root.is-removable ? #2b2735 : #1d1b20);
        border-width: 1px;
        border-color: root.is-removable ? #ffffff22 : Theme.specular-rim;
        clip: true;

        animate x, y, width, height { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate background { duration: 150ms; easing: ease-out; }
        animate border-radius { duration: 160ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 12px;
            spacing: 10px;
            alignment: center;

            Rectangle {
                width: 24px;
                height: 24px;
                background: transparent;

                Icon {
                    name: root.icon-name;
                    icon-size: 22px;
                    icon-color: root.is-removable ? #d0bcff : #938f99;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.title;
                    font-size: 13px;
                    font-weight: 700;
                    color: root.is-removable ? #e6e0e9 : #cac4d0;
                    overflow: elide;
                }

                if root.subtitle != "": Text {
                    text: root.subtitle;
                    font-size: 11px;
                    font-weight: 500;
                    color: root.is-removable ? #cac4d0 : #79747e;
                    overflow: elide;
                }
            }

            // Circular action badge: Minus for active tiles, Plus for available tiles
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: root.is-removable ? #492532 : #254070;
                border-width: 1px;
                border-color: root.is-removable ? #efb8c840 : #adc6ff40;

                Icon {
                    name: root.is-removable ? "minus" : "plus";
                    icon-size: 14px;
                    icon-color: root.is-removable ? #efb8c8 : #adc6ff;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.is-down = true;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.is-down = false;
            }
        }
        clicked => { root.action(); }
    }
}





// =========================================================================
// Android 17 / Pixel Expressive Media Player Card
// =========================================================================
export component MediaCard inherits Rectangle {
    in property <string> title: "Qi2 (Not) Ready - Android Faithful #82";
    in property <string> artist: "Android Faithful • VIDEO";
    in property <string> device: "This phone";
    in property <float> progress: 0.38;
    in property <bool> is-playing: false;
    callback play-pause();
    callback prev();
    callback next();

    height: 136px;
    border-radius: 26px;
    background: #0d3b52;
    border-width: 1px;
    border-color: #38bdf833;
    clip: true;

    // Deep cyan gradient background
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(135deg, #093144 0%, #154c64 50%, #0d384c 100%);
    }

    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;

        // Top Row: Podcast / Audio Icon & Device Chip
        HorizontalLayout {
            alignment: space-between;
            height: 24px;

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: #ffffff22;
                Icon {
                    name: "music";
                    icon-size: 14px;
                    icon-color: #e0f2fe;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            Rectangle {
                height: 22px;
                border-radius: 11px;
                background: #ffffff26;
                border-width: 1px;
                border-color: #ffffff33;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: center;
                    Icon { name: "phone"; icon-size: 11px; icon-color: #ffffff; }
                    Text {
                        text: root.device;
                        font-size: 10px;
                        font-weight: 600;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Middle Row: Title + Artist and Large Play Button
        HorizontalLayout {
            spacing: 12px;
            alignment: space-between;

            VerticalLayout {
                spacing: 2px;
                alignment: center;
                horizontal-stretch: 1;

                MarqueeText {
                    height: 18px;
                    text: root.title;
                    font-size: 13px;
                    font-weight: 700;
                    text-color: #ffffff;
                }
                MarqueeText {
                    height: 15px;
                    text: root.artist;
                    font-size: 11px;
                    font-weight: 500;
                    text-color: #7dd3fc;
                }
            }

            // Play / Pause Circle Button
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: play-touch.pressed ? #e2e8f0 : #ffffff;

                play-touch := TouchArea {
                    clicked => { root.play-pause(); }
                }

                Icon {
                    name: root.is-playing ? "pause" : "play";
                    icon-size: 20px;
                    icon-color: #0f172a;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // Bottom Controls: Replay 10s, Seekbar, Forward 10s, Speed 1x, Next
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            height: 28px;

            // Replay 10
            TouchArea {
                width: 24px;
                height: 24px;
                Icon {
                    name: "replay-10";
                    icon-size: 16px;
                    icon-color: #bae6fd;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            // Seekbar
            Rectangle {
                horizontal-stretch: 1;
                height: 4px;
                border-radius: 2px;
                background: #ffffff33;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * root.progress;
                    height: parent.height;
                    border-radius: 2px;
                    background: #38bdf8;
                }
            }

            // Forward 10
            TouchArea {
                width: 24px;
                height: 24px;
                Icon {
                    name: "forward-10";
                    icon-size: 16px;
                    icon-color: #bae6fd;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            // Speed
            Rectangle {
                width: 24px;
                height: 20px;
                Text {
                    text: "1x";
                    font-size: 11px;
                    font-weight: 700;
                    color: #bae6fd;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Skip next
            TouchArea {
                width: 24px;
                height: 24px;
                clicked => { root.next(); }
                Icon {
                    name: "skip-next";
                    icon-size: 16px;
                    icon-color: #bae6fd;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }
}

// =========================================================================
// Android 17 Material 3 Expressive Squircle Tile (Row 3 4-button row)
// =========================================================================
export component QSSquircleTile inherits Rectangle {
    in property <string> icon-name;
    in property <bool> is-active: false;
    callback clicked();

    property <bool> is-down: false;

    height: 52px;
    background: transparent;

    inner-box := Rectangle {
        x: root.is-down ? 2px : 0px;
        y: root.is-down ? 1px : 0px;
        width: parent.width - (root.is-down ? 4px : 0px);
        height: parent.height - (root.is-down ? 2px : 0px);
        border-radius: root.is-down ? 18px : 22px;
        background: root.is-active ? #a8c7fa : (root.is-down ? #38353d : #23282e);
        border-width: 1px;
        border-color: root.is-active ? #ffffff44 : Theme.specular-rim;

        animate x, y, width, height { duration: 120ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate background { duration: 180ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

        Icon {
            name: root.icon-name;
            icon-size: 22px;
            icon-color: root.is-active ? #04324a : #e6e0e9;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            animate icon-color { duration: 180ms; }
        }
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.is-down = true; }
            else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.is-down = false; }
        }
        clicked => { root.clicked(); }
    }
}

// =========================================================================
// Capsule-Shaped Brightness Slider
// =========================================================================
component SliderPill inherits Rectangle {
    in-out property <float> value: 0.75;
    in property <string> icon-name: "brightness";
    in property <string> label: "Brightness";
    callback changed(float);

    property <length> stretch-offset: 0px;
    property <bool> is-dragging: false;

    height: 44px;
    background: transparent;

    inner-slider := Rectangle {
        property <length> squash-y: root.is-dragging ? 1.5px : 0px;
        property <length> visual-w: Math.clamp(parent.width + root.stretch-offset, parent.width - 24px, parent.width + 24px);

        x: (parent.width - self.visual-w) / 2;
        y: self.squash-y;
        width: self.visual-w;
        height: parent.height - 2 * self.squash-y;

        border-radius: 22px;
        background: #23282e;
        border-width: 1px;
        border-color: root.is-dragging ? Theme.specular-rim-active : Theme.specular-rim;
        clip: true;

        animate x, y, width, height, border-color {
            duration: root.is-dragging ? 0ms : Theme.duration-short;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        // Active fill bar
        fill-bar := Rectangle {
            x: 0px;
            y: 0px;
            width: Math.clamp(parent.width * Math.clamp(root.value, 0.0, 1.0) + (root.stretch-offset > 0px ? root.stretch-offset : 0px), 0px, parent.width);
            height: parent.height;
            background: #a8c7fa;
            border-radius: 22px;

            animate width {
                duration: root.is-dragging ? 0ms : Theme.duration-short;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }
        }

        // Vertical thumb separator
        Rectangle {
            x: Math.clamp(fill-bar.width - 2px, 0px, parent.width - 4px);
            y: 8px;
            width: 4px;
            height: parent.height - 16px;
            border-radius: 2px;
            background: #04324a88;
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    Icon {
                        name: "brightness";
                        icon-size: 18px;
                        icon-color: root.value > 0.08 ? #04324a : #e6e0e9;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
                Text {
                    text: root.label;
                    font-size: 13px;
                    font-weight: 700;
                    color: root.value > 0.38 ? #04324a : #e6e0e9;
                    vertical-alignment: center;
                }
            }

            // Low brightness / Night icon
            Rectangle {
                width: 24px;
                height: 24px;
                Icon {
                    name: "brightness-low";
                    icon-size: 18px;
                    icon-color: root.value > 0.90 ? #04324a : #cac4d0;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }

    slider-touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.is-dragging = true;
                root.update-slider(slider-touch.mouse-x);
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.is-dragging = false;
                root.stretch-offset = 0px;
            }
        }
        moved => {
            if (slider-touch.pressed) {
                root.update-slider(slider-touch.mouse-x);
            }
        }
    }

    function update-slider(touch-x: length) {
        if (touch-x < 0px) {
            root.value = 0.0;
            let dx = Math.abs(touch-x / 1px);
            root.stretch-offset = -Math.sqrt(dx * 1.5) * 1px;
        } else if (touch-x > root.width) {
            root.value = 1.0;
            let dx = (touch-x - root.width) / 1px;
            root.stretch-offset = Math.sqrt(dx * 1.5) * 1px;
        } else {
            root.value = Math.clamp(touch-x / root.width, 0.0, 1.0);
            root.stretch-offset = 0px;
        }
        root.changed(root.value);
    }
}

// =========================================================================
// Material 3 Expressive Header / Action Icon Button
// =========================================================================
component HeaderIconButton inherits Rectangle {
    in property <string> icon-name;
    in property <bool> is-accent: false;
    callback clicked();

    property <bool> is-down: false;

    width: 38px;
    height: 38px;
    border-radius: 19px;
    background: root.is-accent ? (root.is-down ? #e8def8 : #d0bcff) : (root.is-down ? #38353d : #2b2930);
    border-width: 1px;
    border-color: root.is-accent ? #ffffff44 : Theme.specular-rim;

    animate background, border-radius { duration: 150ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }

    Icon {
        name: root.icon-name;
        icon-size: 18px;
        icon-color: root.is-accent ? #381e72 : #e6e0e9;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { root.is-down = true; }
            else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.is-down = false; }
        }
        clicked => { root.clicked(); }
    }
}

// =========================================================================
// Material 3 Expressive Pill Action Button (Reset, Done)
// =========================================================================
component PillButton inherits Rectangle {
