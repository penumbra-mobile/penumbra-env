import { Theme } from "theme.slint";
import { Icon } from "icon.slint";

export struct TileData {
    id: string,
    title: string,
    subtitle: string,
    icon-name: string,
    active: bool,
    enabled: bool,
}

export struct NotificationData {
    app: string,
    title: string,
    body: string,
}

// =========================================================================
// Material 3 Expressive Action Pill Chip
// =========================================================================
component ActionChip inherits Rectangle {
    in property <string> label;
    callback clicked();

    height: 30px;
    border-radius: 15px;
    background: #36342e;
    border-width: 1px;
    border-color: Theme.specular-rim;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: #E3E2E6;
            vertical-alignment: center;
        }
    }

    TouchArea { clicked => { root.clicked(); } }
}

// =========================================================================
// Material 3 Expressive Notification Card (Grouped inside Glass Sheet)
// =========================================================================
component NotificationCard inherits Rectangle {
    in property <NotificationData> data;
    in property <int> index;
    callback dismiss(int);

    property <length> swipe-x: 0px;
    property <float> touch-start-x: 0.0;
    property <bool> is-swiping: false;

    height: 86px;
    background: transparent;

    card := Rectangle {
        x: root.swipe-x;
        width: parent.width;
        height: parent.height;
        border-radius: 20px;
        background: #2a2822a0;
        border-width: 1px;
        border-color: Theme.specular-rim;
        opacity: 1.0 - Math.clamp(Math.abs(root.swipe-x) / 180px, 0.0, 1.0);

        animate x { duration: root.is-swiping ? 0ms : 200ms; easing: ease-out; }
        animate opacity { duration: root.is-swiping ? 0ms : 200ms; easing: ease-out; }

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.touch-start-x = self.mouse-x / 1px;
                    root.is-swiping = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.is-swiping = false;
                    if (Math.abs(root.swipe-x) > 100px) {
                        root.dismiss(root.index);
                    } else {
                        root.swipe-x = 0px;
                    }
                }
            }
            moved => {
                if (self.pressed) {
                    let dx = (self.mouse-x / 1px) - root.touch-start-x;
                    root.swipe-x = dx * 1px;
                }
            }
        }

        VerticalLayout {
            padding: 10px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 4px;

            // Header line: Avatar, App name • time, expand chevron
            HorizontalLayout {
                spacing: 10px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: Theme.primary;
                        Icon {
                            name: "bell";
                            icon-size: 13px;
                            icon-color: Theme.on-primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    Text {
                        text: "\{root.data.app} • acum";
                        font-size: 11px;
                        font-weight: 500;
                        color: Theme.on-surface-variant;
                    }
                }

                Icon {
                    name: "chevron-down";
                    icon-size: 14px;
                    icon-color: Theme.on-surface-variant;
                }
            }

            // Body text
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.data.title;
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.on-surface;
                    overflow: elide;
                }
                Text {
                    text: root.data.body;
                    font-size: 11px;
                    color: Theme.on-surface-variant;
                    overflow: elide;
                }
            }

            // Quick actions line
            HorizontalLayout {
                spacing: 8px;
                ActionChip { label: "Răspunde"; }
                ActionChip { label: "Marchează ca citit"; }
            }
        }
    }
}

// =========================================================================
// Material 3 Expressive Wide Pastille Tile
// =========================================================================
component WideTile inherits Rectangle {
    in property <TileData> data;
    callback clicked();
    callback long-pressed();

    property <bool> is-down: false;
    property <bool> did-long-press: false;
    property <float> touch-start-x: 0.0;
    property <float> touch-start-y: 0.0;

    height: 54px;
    background: transparent;
    opacity: root.data.enabled ? 1.0 : 0.5;

    lp-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.is-down) {
                root.did-long-press = true;
                root.long-pressed();
            }
        }
    }

    inner := Rectangle {
        property <length> squash-dx: root.is-down ? 2px : 0px;
        property <length> squash-dy: root.is-down ? 1px : 0px;

        x: self.squash-dx;
        y: self.squash-dy;
        width: parent.width - 2 * self.squash-dx;
        height: parent.height - 2 * self.squash-dy;

        border-radius: root.is-down ? 23px : 27px;
        // Monet Sand / Butter pale accent when active, elevated dark container when inactive
        background: root.data.active ? (root.is-down ? #DFD6B9 : #E8E0C5) : (root.is-down ? #32302b : #252420);
        border-width: 1px;
        border-color: root.data.active ? #ffffff33 : Theme.specular-rim;
        clip: true;

        animate x, y, width, height, border-radius {
            duration: Theme.duration-short;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 12px;
            alignment: start;

            Rectangle {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                Icon {
                    name: root.data.icon-name;
                    icon-size: 20px;
                    icon-color: root.data.active ? #3D3720 : #E3E2E6;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.data.title;
                    font-size: 13px;
                    font-weight: 700;
                    color: root.data.active ? #3D3720 : #E3E2E6;
                    overflow: elide;
                }
                if root.data.subtitle != "": Text {
                    text: root.data.subtitle;
                    font-size: 10px;
                    font-weight: 500;
                    color: root.data.active ? #564F34 : Theme.on-surface-variant;
                    overflow: elide;
                }
            }
        }
    }

    TouchArea {
        pointer-event(event) => {
            if (!root.data.enabled) { return; }
            if (event.kind == PointerEventKind.down) {
                root.touch-start-x = self.mouse-x / 1px;
                root.touch-start-y = self.mouse-y / 1px;
                root.is-down = true;
                root.did-long-press = false;
                lp-timer.running = true;
            } else if (event.kind == PointerEventKind.move) {
                if (root.is-down) {
                    let dx = Math.abs((self.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((self.mouse-y / 1px) - root.touch-start-y);
                    if (dx > 12.0 || dy > 12.0) { lp-timer.running = false; }
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                lp-timer.running = false;
                if (root.is-down) {
                    root.is-down = false;
                    let dx = Math.abs((self.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((self.mouse-y / 1px) - root.touch-start-y);
                    if (!root.did-long-press && dx < 12.0 && dy < 12.0) {
                        root.clicked();
                    }
                }
            }
        }
    }
}

// =========================================================================
// Material 3 Expressive Compact Squircle Tile (Wi-Fi / Mobile Data)
// =========================================================================
component CompactTile inherits Rectangle {
    in property <TileData> data;
    callback clicked();
    callback long-pressed();

    property <bool> is-down: false;
    property <bool> did-long-press: false;
    property <float> touch-start-x: 0.0;
    property <float> touch-start-y: 0.0;

    height: 54px;
    background: transparent;
    opacity: root.data.enabled ? 1.0 : 0.5;

    lp-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.is-down) {
                root.did-long-press = true;
                root.long-pressed();
            }
        }
    }

    inner := Rectangle {
        property <length> squash-dx: root.is-down ? 2px : 0px;
        property <length> squash-dy: root.is-down ? 1px : 0px;

        x: self.squash-dx;
        y: self.squash-dy;
        width: parent.width - 2 * self.squash-dx;
        height: parent.height - 2 * self.squash-dy;

        border-radius: root.is-down ? 22px : 26px;
        background: root.data.active ? (root.is-down ? #DFD6B9 : #E8E0C5) : (root.is-down ? #32302b : #252420);
        border-width: 1px;
        border-color: root.data.active ? #ffffff33 : Theme.specular-rim;
        clip: true;

        animate x, y, width, height, border-radius {
            duration: Theme.duration-short;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        Icon {
            name: root.data.icon-name;
            icon-size: 22px;
            icon-color: root.data.active ? #3D3720 : #E3E2E6;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    TouchArea {
        pointer-event(event) => {
            if (!root.data.enabled) { return; }
            if (event.kind == PointerEventKind.down) {
                root.touch-start-x = self.mouse-x / 1px;
                root.touch-start-y = self.mouse-y / 1px;
                root.is-down = true;
                root.did-long-press = false;
                lp-timer.running = true;
            } else if (event.kind == PointerEventKind.move) {
                if (root.is-down) {
                    let dx = Math.abs((self.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((self.mouse-y / 1px) - root.touch-start-y);
                    if (dx > 12.0 || dy > 12.0) { lp-timer.running = false; }
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                lp-timer.running = false;
                if (root.is-down) {
                    root.is-down = false;
                    let dx = Math.abs((self.mouse-x / 1px) - root.touch-start-x);
                    let dy = Math.abs((self.mouse-y / 1px) - root.touch-start-y);
                    if (!root.did-long-press && dx < 12.0 && dy < 12.0) {
                        root.clicked();
                    }
                }
            }
        }
    }
}

// =========================================================================
// Material 3 Expressive Brightness Slider Pill (Screenshot 3)
// =========================================================================
component SliderPill inherits Rectangle {
    in-out property <float> value: 0.75;
    in property <string> icon-name: "brightness";
    in property <string> label: "Brightness";
    callback changed(float);

    property <length> stretch-offset: 0px;
    property <bool> is-dragging: false;

    height: 46px;
    background: transparent;

    inner-slider := Rectangle {
        property <length> squash-y: root.is-dragging ? 1.5px : 0px;
        property <length> visual-w: Math.clamp(parent.width + root.stretch-offset, parent.width - 24px, parent.width + 24px);

        x: (parent.width - self.visual-w) / 2;
        y: self.squash-y;
        width: self.visual-w;
        height: parent.height - 2 * self.squash-y;

        border-radius: Theme.radius-pill;
        background: #252420;
        border-width: 1px;
        border-color: root.is-dragging ? Theme.specular-rim-active : Theme.specular-rim;
        clip: true;

        animate x, y, width, height, border-color {
            duration: root.is-dragging ? 0ms : Theme.duration-short;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        // Active fill bar with Monet sand color
        fill-bar := Rectangle {
            x: 0px;
            y: 0px;
            width: Math.clamp(parent.width * Math.clamp(root.value, 0.0, 1.0) + (root.stretch-offset > 0px ? root.stretch-offset : 0px), 0px, parent.width);
            height: parent.height;
            background: #E8E0C5;
            border-radius: Theme.radius-pill;

            animate width {
                duration: root.is-dragging ? 0ms : Theme.duration-short;
                easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 10px;
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    Icon {
                        name: "brightness";
                        icon-size: 18px;
                        icon-color: root.value > 0.08 ? #3D3720 : #E3E2E6;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
                Text {
                    text: root.label;
                    font-size: Theme.font-label;
                    font-weight: 700;
                    color: root.value > 0.38 ? #3D3720 : #E3E2E6;
                    vertical-alignment: center;
                }
            }

            // Auto-brightness / Night light symbol on right
            Rectangle {
                width: 24px;
                height: 24px;
                Icon {
                    name: "brightness-low";
                    icon-size: 18px;
                    icon-color: root.value > 0.90 ? #3D3720 : #A6A49B;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }
    }

    slider-touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.is-dragging = true;
                root.update-slider(slider-touch.mouse-x);
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.is-dragging = false;
                root.stretch-offset = 0px;
            }
        }
        moved => {
            if (slider-touch.pressed) {
                root.update-slider(slider-touch.mouse-x);
            }
        }
    }

    function update-slider(touch-x: length) {
        if (touch-x < 0px) {
            root.value = 0.0;
            let dx = Math.abs(touch-x / 1px);
            root.stretch-offset = -Math.sqrt(dx * 1.5) * 1px;
        } else if (touch-x > root.width) {
            root.value = 1.0;
            let dx = (touch-x - root.width) / 1px;
            root.stretch-offset = Math.sqrt(dx * 1.5) * 1px;
        } else {
            root.value = Math.clamp(touch-x / root.width, 0.0, 1.0);
            root.stretch-offset = 0px;
        }
        root.changed(root.value);
    }
}

// =========================================================================
// Circular Action Chip Button ($48px round button in Screenshot 3)
// =========================================================================
export component SmallButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> accent: false;
    in property <length> button-width: 48px;
    callback clicked();

    width: root.button-width;
    height: 48px;
    border-radius: 24px;
    background: root.accent ? #E8E0C5 : #252420;
    border-width: 1px;
    border-color: root.accent ? #ffffff33 : Theme.specular-rim;

    if root.icon != "": Icon {
        name: root.icon;
        icon-size: 20px;
        icon-color: root.accent ? #3D3720 : #E3E2E6;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.icon == "": Text {
        text: root.label;
        font-size: 13px;
        font-weight: 700;
        color: root.accent ? #3D3720 : #E3E2E6;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

// =========================================================================
// QuickSettingsSlider: Android 17 Material 3 Expressive Dual-Mode Architecture
// Mode A: Notifications Shade (Screenshot 2, 4, 5)
// Mode B: Full Quick Settings (Screenshot 3)
// =========================================================================
export component QuickSettingsSlider inherits Rectangle {
    in-out property <length> slide-offset-y: -915px;
    in property <float> expansion-progress: 0.0;
    in-out property <bool> edit-mode: false;

    in-out property <float> brightness: 0.75;
    in-out property <float> volume: 0.60;
    in-out property <string> time-text: "10:33";
    in-out property <string> date-text: "lun., 26 oct.";
    in-out property <string> carrier-text: "Vodafone RO";
    in property <int> battery-pct: 100;

    in property <[TileData]> active-tiles;
    in property <[TileData]> available-tiles;
    in property <[NotificationData]> notifications;

    callback close-requested();
    callback power-action();
    callback settings-action();
    callback brightness-changed(float);
    callback volume-changed(float);
    callback tile-clicked(string);
    callback tile-long-pressed(string);
    callback enter-edit-mode();
    callback exit-edit-mode();
    callback reset-tiles();
    callback reorder-tiles(int, int);
    callback remove-tile(string);
    callback add-tile(string);
    callback drag-delta(length);
    callback drag-released(length, float);
    callback fast-pull-up();
    callback notification-dismissed(int);
    callback clear-notifications();

    // Pull displacement: 0 (closed) .. 915px (fully open).
    property <length> disp: Math.clamp(root.slide-offset-y + 915px, 0px, 915px);
    // Smooth transition between Notifications Shade and Full Quick Settings
    property <float> morph: root.edit-mode ? 1.0 : Math.clamp((root.disp - 380px) / 300px, 0.0, 1.0);
    property <bool> is-full-qs: root.edit-mode || root.morph > 0.45;
    property <length> pad: 16px;

    // Direct spring translation: content slides in smoothly from above the screen!
    property <length> slide-y: -290px + Math.min(root.disp, 290px);

    // Completely transparent root: allows compositor Dual-Kawase blur to show through!
    background: transparent;

    // Scrim touch area: dismisses shade on tap outside content
    scrim-touch := TouchArea {
        enabled: root.disp > 20px;
        y: root.disp;
        width: parent.width;
        height: Math.max(0px, parent.height - self.y);
        property <length> press-y: 0px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.press-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                let dy = self.mouse-y - self.press-y;
                if (dy < -15px) {
                    root.fast-pull-up();
                } else if (Math.abs(dy) < 12px) {
                    root.close-requested();
                }
            }
        }
    }

    // =========================================================================
    // The Floating Quick Settings Assembly (Translates with Spring Physics)
    // =========================================================================
    chassis := Rectangle {
        x: 0px;
        y: root.slide-y;
        width: parent.width;
        height: root.disp - root.slide-y;
        background: transparent;
        clip: false;

        // Full-screen background touch area for drag gestures
        shade-touch := TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;

            property <length> press-y: 0px;
            property <length> last-pos-y: 0px;
            property <float> velocity: 0.0;
            property <bool> is-dragging: false;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.press-y = self.mouse-y;
                    self.last-pos-y = self.mouse-y;
                    self.velocity = 0.0;
                    self.is-dragging = false;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    let total-dy = self.mouse-y - self.press-y;
                    if (self.is-dragging) {
                        if (self.velocity < -120.0 || total-dy < -40px) {
                            root.fast-pull-up();
                        } else {
                            root.drag-released(root.slide-offset-y, self.velocity);
                        }
                    } else if (total-dy < -25px || self.velocity < -120.0) {
                        root.fast-pull-up();
                    }
                    self.is-dragging = false;
                }
            }

            moved => {
                if (self.pressed) {
                    let total-dy = self.mouse-y - self.press-y;
                    let delta = self.mouse-y - self.last-pos-y;
                    self.velocity = self.velocity * 0.6 + (delta / 1px / 0.016) * 0.4;
                    self.last-pos-y = self.mouse-y;

                    if (Math.abs(total-dy) > 6px) {
                        self.is-dragging = true;
                        root.drag-delta(delta);
                    }
                }
            }
        }

        // =====================================================================
        // MODE A: Notifications Shade (Screenshot 2, 4, 5)
        // =====================================================================
        if !root.is-full-qs: notif-mode := Rectangle {
            width: parent.width;
            height: parent.height;

            // Status bar line: Time, Date, Status Icons, Battery Pill
            HorizontalLayout {
                x: root.pad;
                y: 12px;
                width: parent.width - 2 * root.pad;
                height: 32px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: root.time-text;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.on-surface;
                    }
                    Text {
                        text: root.date-text;
                        font-size: 13px;
                        font-weight: 500;
                        color: Theme.on-surface;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    Icon { name: "bell"; icon-size: 16px; icon-color: Theme.on-surface; }
                    Icon { name: "wifi"; icon-size: 16px; icon-color: Theme.on-surface; }
                    Rectangle {
                        height: 22px;
                        width: 58px;
                        border-radius: 11px;
                        background: #48E885;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;
                            Icon { name: "battery"; icon-size: 12px; icon-color: #003915; }
                            Text { text: "\{root.battery-pct}%"; font-size: 11px; font-weight: 800; color: #003915; }
                        }
                    }
                }
            }

            // Quick Actions: Exactly 2 Rows (Screenshot 2 & 4)
            property <length> r1-wide-w: parent.width - 2 * root.pad - 172px - 16px;
            property <length> r2-w: (parent.width - 2 * root.pad - 10px) / 2;

            // Row 1: Wi-Fi squircle + Mobile Data squircle + Bluetooth wide
            CompactTile {
                x: root.pad;
                y: 48px;
                width: 82px;
                data: root.active-tiles[0];
                clicked => { root.tile-clicked(root.active-tiles[0].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[0].id); }
            }
            CompactTile {
                x: root.pad + 90px;
                y: 48px;
                width: 82px;
                data: root.active-tiles[1];
                clicked => { root.tile-clicked(root.active-tiles[1].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[1].id); }
            }
            WideTile {
                x: root.pad + 180px;
                y: 48px;
                width: parent.width - 2 * root.pad - 180px;
                data: root.active-tiles[2];
                clicked => { root.tile-clicked(root.active-tiles[2].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[2].id); }
            }

            // Row 2: Flashlight wide + Wallet wide
            WideTile {
                x: root.pad;
                y: 110px;
                width: parent.r2-w;
                data: root.active-tiles[3];
                clicked => { root.tile-clicked(root.active-tiles[3].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[3].id); }
            }
            WideTile {
                x: root.pad + parent.r2-w + 10px;
                y: 110px;
                width: parent.r2-w;
                data: root.active-tiles[4];
                clicked => { root.tile-clicked(root.active-tiles[4].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[4].id); }
            }

            // Unified Notification Sheet (Screenshot 4 & 5)
            Rectangle {
                x: root.pad;
                y: 172px;
                width: parent.width - 2 * root.pad;
                height: Math.max(140px, parent.height - 180px);
                border-radius: 28px;
                background: #23211be6;
                border-width: 1px;
                border-color: Theme.specular-rim;
                clip: true;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    if root.notifications.length == 0: Text {
                        text: "No notifications";
                        font-size: Theme.font-label;
                        color: Theme.on-surface-variant;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        height: 80px;
                    }

                    for n[idx] in root.notifications: NotificationCard {
                        data: n;
                        index: idx;
                        dismiss(i) => { root.notification-dismissed(i); }
                    }

                    // Silent / Weather section (Screenshot 2 & 5)
                    HorizontalLayout {
                        alignment: space-between;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        Text {
                            text: "Silențioase";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.on-surface-variant;
                        }
                        Icon { name: "close"; icon-size: 14px; icon-color: Theme.on-surface-variant; }
                    }

                    Rectangle {
                        height: 52px;
                        border-radius: 18px;
                        background: #2a2822a0;
                        border-width: 1px;
                        border-color: Theme.specular-rim;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;
                            alignment: start;
                            Rectangle {
                                width: 22px;
                                height: 22px;
                                y: (parent.height - self.height) / 2;
                                Icon { name: "brightness"; icon-size: 18px; icon-color: #E8E0C5; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text { text: "Ghermănești, RO"; font-size: 12px; font-weight: 700; color: #E3E2E6; }
                                Text { text: "11°C • RealFeel 10°"; font-size: 11px; color: Theme.on-surface-variant; }
                            }
                        }
                    }

                    // Bottom footer: History, Clear all pill, Settings (Screenshot 2)
                    HorizontalLayout {
                        alignment: space-between;
                        padding-top: 8px;

                        // History icon
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 19px;
                            background: #2f2d26;
                            border-width: 1px;
                            border-color: Theme.specular-rim;
                            Icon { name: "refresh"; icon-size: 18px; icon-color: #E3E2E6; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        }

                        // Clear all notifications pill button
                        Rectangle {
                            height: 38px;
                            width: 190px;
                            border-radius: 19px;
                            background: clear-btn-touch.pressed ? #3d3b34 : #2f2d26;
                            border-width: 1px;
                            border-color: Theme.specular-rim;

                            clear-btn-touch := TouchArea { clicked => { root.clear-notifications(); } }
                            Text {
                                text: "Șterge toate notificările";
                                font-size: 12px;
                                font-weight: 700;
                                color: #E8E0C5;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Notification settings icon
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 19px;
                            background: #2f2d26;
                            border-width: 1px;
                            border-color: Theme.specular-rim;
                            Icon { name: "settings"; icon-size: 18px; icon-color: #E3E2E6; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            TouchArea { clicked => { root.settings-action(); } }
                        }
                    }
                }
            }
        }

        // =====================================================================
        // MODE B: Full Quick Settings (Screenshot 3)
        // =====================================================================
        if root.is-full-qs: qs-mode := Rectangle {
            width: parent.width;
            height: parent.height;

            // Header line: Big clock, Date, Carrier, Battery Pill (Screenshot 3)
            HorizontalLayout {
                x: root.pad;
                y: 12px;
                width: parent.width - 2 * root.pad;
                height: 52px;
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: root.time-text;
                        font-size: 30px;
                        font-weight: 800;
                        color: Theme.on-surface;
                    }
                    Text {
                        text: root.date-text;
                        font-size: 13px;
                        font-weight: 500;
                        color: Theme.on-surface-variant;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Text {
                            text: root.carrier-text;
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.on-surface;
                        }
                        Icon { name: "wifi"; icon-size: 14px; icon-color: Theme.on-surface; }
                    }
                    Rectangle {
                        height: 22px;
                        width: 140px;
                        border-radius: 11px;
                        background: #48E885;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 4px;
                            alignment: center;
                            Icon { name: "battery"; icon-size: 12px; icon-color: #003915; }
                            Text { text: "\{root.battery-pct}% Până la 23:00"; font-size: 11px; font-weight: 800; color: #003915; }
                        }
                    }
                }
            }

            // Brightness Slider: Exactly at top of tiles (Screenshot 3)
            SliderPill {
                x: root.pad;
                y: 72px;
                width: parent.width - 2 * root.pad;
                value <=> root.brightness;
                label: "Brightness";
                changed(v) => { root.brightness-changed(v); }
            }

            // 4 Rows of Pastille Tiles (Screenshot 3)
            property <length> r-w: (parent.width - 2 * root.pad - 10px) / 2;

            // Row 1: Wi-Fi squircle + Mobile Data squircle + Bluetooth wide
            CompactTile {
                x: root.pad;
                y: 128px;
                width: 82px;
                data: root.active-tiles[0];
                clicked => { root.tile-clicked(root.active-tiles[0].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[0].id); }
            }
            CompactTile {
                x: root.pad + 90px;
                y: 128px;
                width: 82px;
                data: root.active-tiles[1];
                clicked => { root.tile-clicked(root.active-tiles[1].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[1].id); }
            }
            WideTile {
                x: root.pad + 180px;
                y: 128px;
                width: parent.width - 2 * root.pad - 180px;
                data: root.active-tiles[2];
                clicked => { root.tile-clicked(root.active-tiles[2].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[2].id); }
            }

            // Row 2: Lanternă + Portofel
            WideTile {
                x: root.pad;
                y: 190px;
                width: parent.r-w;
                data: root.active-tiles[3];
                clicked => { root.tile-clicked(root.active-tiles[3].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[3].id); }
            }
            WideTile {
                x: root.pad + parent.r-w + 10px;
                y: 190px;
                width: parent.r-w;
                data: root.active-tiles[4];
                clicked => { root.tile-clicked(root.active-tiles[4].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[4].id); }
            }

            // Row 3: Auto-rotate + Battery Saver
            WideTile {
                x: root.pad;
                y: 252px;
                width: parent.r-w;
                data: root.active-tiles[5];
                clicked => { root.tile-clicked(root.active-tiles[5].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[5].id); }
            }
            WideTile {
                x: root.pad + parent.r-w + 10px;
                y: 252px;
                width: parent.r-w;
                data: root.active-tiles[6];
                clicked => { root.tile-clicked(root.active-tiles[6].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[6].id); }
            }

            // Row 4: Mod Avion + Night Light
            WideTile {
                x: root.pad;
                y: 314px;
                width: parent.r-w;
                data: root.active-tiles[7];
                clicked => { root.tile-clicked(root.active-tiles[7].id); }
                long-pressed => { root.tile-long-pressed(root.active-tiles[7].id); }
            }
            WideTile {
                x: root.pad + parent.r-w + 10px;
                y: 314px;
                width: parent.r-w;
                data: root.available-tiles[0];
                clicked => { root.tile-clicked(root.available-tiles[0].id); }
                long-pressed => { root.tile-long-pressed(root.available-tiles[0].id); }
            }

            // Build indicator & page dots (Screenshot 3)
            HorizontalLayout {
                x: root.pad;
                y: 384px;
                width: parent.width - 2 * root.pad;
                alignment: space-between;

                Text {
                    text: "17 (CP3A.261005.002.A1)";
                    font-size: 11px;
                    color: Theme.outline;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    Rectangle { width: 14px; height: 5px; border-radius: 2.5px; background: #E8E0C5; }
                    Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: #44433e; }
                    Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: #44433e; }
                }

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: #252420;
                    border-width: 1px;
                    border-color: Theme.specular-rim;
                    Icon { name: "edit"; icon-size: 16px; icon-color: #E3E2E6; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    TouchArea { clicked => { if (root.edit-mode) { root.exit-edit-mode(); } else { root.enter-edit-mode(); } } }
                }
            }

            // Bottom Right Action Chips: Settings & Power (Screenshot 3)
            HorizontalLayout {
                x: parent.width - root.pad - 110px;
                y: parent.height - 72px;
                width: 110px;
                height: 48px;
                spacing: 12px;
                alignment: end;

                SmallButton {
                    icon: "settings";
                    button-width: 48px;
                    clicked => { root.settings-action(); }
                }
                SmallButton {
                    icon: "power";
                    button-width: 48px;
                    clicked => { root.power-action(); }
                }
            }
        }

        // ---------------------------------------------------------------------
        // Drag Handle: Glued to bottom of visible shade
        // ---------------------------------------------------------------------
        Rectangle {
            x: 0px;
            y: parent.height - 24px;
            width: parent.width;
            height: 24px;
            background: transparent;

            Rectangle {
                width: 44px;
                height: 4px;
                x: (parent.width - self.width) / 2;
                y: 10px;
                border-radius: 2px;
                background: Theme.specular-rim-glow;
                opacity: root.disp > 880px ? 0.35 : 0.85;
            }
        }
    }
}
