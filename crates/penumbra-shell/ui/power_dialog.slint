import { Theme } from "theme.slint";
import { Icon } from "icon.slint";

component PowerActionRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> icon-name;
    in property <color> container-color;
    in property <color> badge-color;
    in property <color> icon-tint;
    in property <color> title-color;
    in property <bool> enabled: true;
    callback clicked();

    height: 62px;
    background: transparent;

    inner := Rectangle {
        x: touch.pressed ? 4px : 0px;
        y: touch.pressed ? 1.5px : 0px;
        width: parent.width - (touch.pressed ? 8px : 0px);
        height: parent.height - (touch.pressed ? 3px : 0px);
        border-radius: touch.pressed ? Theme.radius-item : 22px;
        background: root.container-color;
        border-width: 1px;
        border-color: touch.pressed ? Theme.specular-rim-active : Theme.specular-rim;

        animate x, y, width, height, border-radius {
            duration: Theme.duration-micro;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        touch := TouchArea {
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 16px;
            spacing: 14px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: touch.pressed ? 14px : 20px;
                    background: root.badge-color;

                    animate border-radius {
                        duration: Theme.duration-micro;
                        easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
                    }

                    Icon {
                        name: root.icon-name;
                        icon-color: root.icon-tint;
                        icon-size: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.title;
                    color: root.title-color;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {
                    text: root.subtitle;
                    color: Theme.on-surface-variant;
                    font-size: Theme.font-caption;
                    font-weight: 500;
                }
            }
        }
    }
}

export component PowerDialog inherits Rectangle {
    in-out property <bool> open: false;
    callback power-off();
    callback reboot();
    callback logout();
    callback cancel();

    opacity: root.open ? 1.0 : 0.0;
    visible: self.opacity > 0.01;
    width: 100%;
    height: 100%;
    background: transparent;

    animate opacity {
        duration: root.open ? Theme.duration-medium : Theme.duration-short;
        easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
    }

    // Scrim backdrop
    TouchArea {
        enabled: root.open;
        width: 100%;
        height: 100%;
        clicked => { root.cancel(); }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.glass-scrim-deep;
        }
    }

    // Centered Material 3 Expressive Power Card
    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.open ? 0px : 24px);
        width: 328px;
        height: 360px;
        background: Theme.surface-container-high;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.specular-rim-active;
        drop-shadow-blur: 48px;
        drop-shadow-color: Theme.glass-scrim-deep;
        drop-shadow-offset-y: 12px;
        clip: true;

        animate y {
            duration: root.open ? Theme.duration-medium : Theme.duration-short;
            easing: cubic-bezier(0.05, 0.7, 0.1, 1.0);
        }

        VerticalLayout {
            padding-top: 22px;
            padding-bottom: 18px;
            padding-left: 18px;
            padding-right: 18px;
            spacing: 10px;

            Text {
                text: @tr("Device options");
                color: Theme.on-surface;
                font-size: Theme.font-title;
                font-weight: 700;
                horizontal-alignment: center;
            }

            PowerActionRow {
                title: @tr("Power off");
                subtitle: @tr("Shut down device");
                icon-name: "power";
                container-color: Theme.error-container;
                badge-color: Theme.error;
                icon-tint: Theme.on-error;
                title-color: Theme.on-error-container;
                enabled: root.open;
                clicked => { root.power-off(); }
            }

            PowerActionRow {
                title: @tr("Restart");
                subtitle: @tr("Reboot system");
                icon-name: "restart";
                container-color: Theme.tertiary-container;
                badge-color: Theme.tertiary;
                icon-tint: Theme.on-tertiary;
                title-color: Theme.on-tertiary-container;
                enabled: root.open;
                clicked => { root.reboot(); }
            }

            PowerActionRow {
                title: @tr("Sign out");
                subtitle: @tr("End current session");
                icon-name: "logout";
                container-color: Theme.secondary-container;
                badge-color: Theme.secondary;
                icon-tint: Theme.on-secondary;
                title-color: Theme.on-secondary-container;
                enabled: root.open;
                clicked => { root.logout(); }
            }

            // Cancel Pill Button with 0.96x touch squash
            Rectangle {
                height: 46px;
                background: transparent;

                Rectangle {
                    x: cancel-touch.pressed ? 6px : 0px;
                    y: cancel-touch.pressed ? 1.5px : 0px;
                    width: parent.width - (cancel-touch.pressed ? 12px : 0px);
                    height: parent.height - (cancel-touch.pressed ? 3px : 0px);
                    background: cancel-touch.pressed ? Theme.surface-bright : Theme.surface-container-highest;
                    border-radius: Theme.radius-pill;
                    border-width: 1px;
                    border-color: Theme.specular-rim;

                    animate x, y, width, height, background {
                        duration: Theme.duration-micro;
                        easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
                    }

                    cancel-touch := TouchArea {
                        enabled: root.open;
                        clicked => { root.cancel(); }
                    }

                    Text {
                        text: @tr("Cancel");
                        color: Theme.on-surface;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
