import { Theme } from "theme.slint";
import { Icon } from "icon.slint";

export struct NotificationData {
    id: string,
    app: string,
    title: string,
    body: string,
    time-text: string,
}

// Material 3 Expressive Notification Card
export component NotificationCard inherits Rectangle {
    in property <NotificationData> data;
    in property <int> index;
    callback dismiss(int);
    callback clicked(int);

    property <length> swipe-x: 0px;
    property <float> touch-start-x: 0.0;
    property <float> touch-start-y: 0.0;
    property <bool> is-swiping: false;
    property <bool> is-pressed: false;

    height: 108px;
    background: transparent;

    card := Rectangle {
        property <length> squash-inset-x: (root.is-pressed && !root.is-swiping) ? 3px : 0px;
        property <length> squash-inset-y: (root.is-pressed && !root.is-swiping) ? 1.5px : 0px;

        x: root.swipe-x + self.squash-inset-x;
        y: self.squash-inset-y;
        width: parent.width - 2 * self.squash-inset-x;
        height: parent.height - 2 * self.squash-inset-y;
        border-radius: (root.is-pressed && !root.is-swiping) ? Theme.radius-tile-squash : Theme.radius-squircle;
        background: root.is-pressed ? Theme.surface-container-highest : Theme.surface-container-high;
        border-width: 1px;
        border-color: root.is-pressed ? Theme.specular-rim-active : Theme.specular-rim;
        clip: true;
        opacity: 1.0 - Math.clamp(Math.abs(root.swipe-x) / 160px, 0.0, 1.0);

        animate x { duration: root.is-swiping ? 0ms : 220ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate y, width, height, border-radius { duration: Theme.duration-micro; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate opacity { duration: root.is-swiping ? 0ms : 220ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate background { duration: Theme.duration-short; }

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.touch-start-x = self.mouse-x / 1px;
                    root.touch-start-y = self.mouse-y / 1px;
                    root.is-pressed = true;
                    root.is-swiping = false;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.is-pressed = false;
                    if (root.is-swiping) {
                        root.is-swiping = false;
                        if (Math.abs(root.swipe-x) > 85px) {
                            root.dismiss(root.index);
                        } else {
                            root.swipe-x = 0px;
                        }
                    } else if (event.kind == PointerEventKind.up) {
                        root.clicked(root.index);
                    }
                }
            }
            moved => {
                if (self.pressed) {
                    let dx = (self.mouse-x / 1px) - root.touch-start-x;
                    let dy = (self.mouse-y / 1px) - root.touch-start-y;
                    if (Math.abs(dx) > 10.0 && Math.abs(dx) > Math.abs(dy) * 1.2) {
                        root.is-swiping = true;
                        root.swipe-x = dx * 1px;
                    }
                }
            }
        }

        VerticalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 4px;

            // Header line: App icon, App name, Dot, Timestamp
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    // App icon badge (Monet primary-container)
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: Theme.primary-container;

                        Icon {
                            name: "bell";
                            icon-size: 12px;
                            icon-color: Theme.on-primary-container;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Text {
                        text: root.data.app;
                        font-size: Theme.font-label;
                        font-weight: 700;
                        color: Theme.primary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "•";
                        font-size: 10px;
                        color: Theme.on-surface-variant;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.data.time-text != "" ? root.data.time-text : "now";
                        font-size: Theme.font-caption;
                        font-weight: 500;
                        color: Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }

                // Dismiss pill button
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: dismiss-ta.pressed ? Theme.surface-bright : transparent;

                    dismiss-ta := TouchArea {
                        clicked => { root.dismiss(root.index); }
                    }

                    Icon {
                        name: "close";
                        icon-size: 14px;
                        icon-color: Theme.on-surface-variant;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Title
            Text {
                text: root.data.title;
                font-size: Theme.font-body;
                font-weight: 700;
                color: Theme.on-surface;
                overflow: elide;
            }

            // Body
            Text {
                text: root.data.body;
                font-size: Theme.font-label;
                font-weight: 400;
                color: Theme.on-surface-variant;
                overflow: elide;
            }
        }
    }
}

// Material 3 Expressive Notification Empty State
export component NotificationEmptyState inherits Rectangle {
    callback swipe-up();

    TouchArea {
        width: 100%;
        height: 100%;
        property <length> press-y: 0px;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.press-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (self.mouse-y - self.press-y < -15px) {
                    root.swipe-up();
                }
            }
        }
    }

    VerticalLayout {
        spacing: 12px;
        alignment: center;

        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 28px;
            background: Theme.surface-container-high;
            border-width: 1px;
            border-color: Theme.specular-rim;
            x: (parent.width - self.width) / 2;

            Icon {
                name: "bell";
                icon-size: 26px;
                icon-color: Theme.primary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: @tr("No notifications");
            font-size: 16px;
            font-weight: 700;
            color: Theme.on-surface;
            horizontal-alignment: center;
        }

        Text {
            text: @tr("You're all caught up");
            font-size: Theme.font-label;
            font-weight: 400;
            color: Theme.on-surface-variant;
            horizontal-alignment: center;
        }
    }
}

// Notification Stack Container
export component NotificationStack inherits Rectangle {
    in property <[NotificationData]> notifications;
    in property <bool> clock-alarm-active: false;
    in property <bool> clock-alarm-ringing: false;
    in property <string> clock-alarm-text: "";
    in property <bool> clock-timer-active: false;
    in property <bool> clock-timer-running: false;
    in property <bool> clock-timer-ringing: false;
    in property <string> clock-timer-text: "";
    callback dismiss-notification(int);
    callback clear-all();
    callback open-settings();
    callback swipe-up();
    callback clock-alarm-snooze();
    callback clock-alarm-dismiss();
    callback clock-alarm-disable();
    callback clock-timer-toggle();
    callback clock-timer-add-min();
    callback clock-timer-cancel();
    callback clock-open-app();

    border-radius: Theme.radius-tile;
    background: Theme.glass-card;
    border-width: 1px;
    border-color: Theme.specular-rim;
    clip: true;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: stack-layout.min-height;
        interactive: stack-layout.min-height > self.height;

        stack-layout := VerticalLayout {
            padding: 14px;
            spacing: 10px;

            // Header row: Section Title, Count badge & Clear all pill
            HorizontalLayout {
                alignment: space-between;
                padding-left: 4px;
                padding-right: 4px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: @tr("Notifications");
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.on-surface;
                        vertical-alignment: center;
                    }

                    if root.notifications.length > 0: Rectangle {
                        height: 20px;
                        border-radius: Theme.radius-pill;
                        background: Theme.primary-container;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "\{root.notifications.length}";
                                font-size: Theme.font-caption;
                                font-weight: 700;
                                color: Theme.on-primary-container;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.notifications.length > 0: Rectangle {
                    height: 26px;
                    border-radius: Theme.radius-pill;
                    background: clear-ta.pressed ? Theme.surface-bright : Theme.surface-container-highest;
                    border-width: 1px;
                    border-color: Theme.specular-rim;

                    animate background { duration: Theme.duration-micro; }

                    clear-ta := TouchArea {
                        clicked => { root.clear-all(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: @tr("Clear all");
                            font-size: Theme.font-caption;
                            font-weight: 600;
                            color: Theme.primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Empty state
            if root.notifications.length == 0 && !root.clock-alarm-active && !root.clock-alarm-ringing && !root.clock-timer-active && !root.clock-timer-ringing: NotificationEmptyState {
                height: 200px;
                swipe-up => { root.swipe-up(); }
            }

            // Live Alarm Notification Card
            if root.clock-alarm-active || root.clock-alarm-ringing: Rectangle {
                border-radius: Theme.radius-item;
                background: root.clock-alarm-ringing ? Theme.primary-container : Theme.surface-container;
                border-width: 1px;
                border-color: root.clock-alarm-ringing ? Theme.specular-rim-active : Theme.specular-rim;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        TouchArea { clicked => { root.clock-open-app(); } }
                        Rectangle {
                            width: 34px; height: 34px; border-radius: 17px;
                            background: root.clock-alarm-ringing ? Theme.primary : Theme.primary-container;
                            Path {
                                width: 18px; height: 18px;
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                viewbox-width: 24; viewbox-height: 24;
                                commands: "M12 5 A 8 8 0 1 1 11.99 5 Z M12 9 V13 L15 15 M5 3 L2 6 M19 3 L22 6";
                                stroke: root.clock-alarm-ringing ? Theme.on-primary : Theme.on-primary-container;
                                stroke-width: 2px; stroke-line-cap: round; stroke-line-join: round; fill: transparent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: root.clock-alarm-ringing ? @tr("Alarm Ringing") : @tr("Upcoming Alarm");
                                font-size: Theme.font-caption;
                                font-weight: 700;
                                color: root.clock-alarm-ringing ? Theme.on-primary-container : Theme.primary;
                            }
                            Text {
                                text: root.clock-alarm-text;
                                font-size: Theme.font-body;
                                font-weight: 600;
                                color: root.clock-alarm-ringing ? Theme.on-primary-container : Theme.on-surface;
                                overflow: elide;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if root.clock-alarm-ringing: Rectangle {
                            horizontal-stretch: 1; height: 30px; border-radius: Theme.radius-pill;
                            background: Theme.surface-container-highest;
                            Text { text: @tr("Snooze 10m"); font-size: 12px; font-weight: 600; color: Theme.on-surface; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.clock-alarm-snooze(); } }
                        }
                        if root.clock-alarm-ringing: Rectangle {
                            horizontal-stretch: 1; height: 30px; border-radius: Theme.radius-pill;
                            background: Theme.primary;
                            Text { text: @tr("Dismiss"); font-size: 12px; font-weight: 700; color: Theme.on-primary; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.clock-alarm-dismiss(); } }
                        }
                        if !root.clock-alarm-ringing: Rectangle {
                            horizontal-stretch: 1; height: 30px; border-radius: Theme.radius-pill;
                            background: Theme.surface-container-highest;
                            Text { text: @tr("Open Clock"); font-size: 12px; font-weight: 600; color: Theme.on-surface; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.clock-open-app(); } }
                        }
                        if !root.clock-alarm-ringing: Rectangle {
                            horizontal-stretch: 1; height: 30px; border-radius: Theme.radius-pill;
                            background: Theme.surface-container-high;
                            Text { text: @tr("Turn Off"); font-size: 12px; font-weight: 600; color: Theme.on-surface-variant; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.clock-alarm-disable(); } }
                        }
                    }
                }
            }

            // Live Timer Notification Card with Interactive Controls
            if root.clock-timer-active || root.clock-timer-ringing: Rectangle {
                border-radius: Theme.radius-item;
                background: root.clock-timer-ringing ? Theme.primary-container : Theme.surface-container;
                border-width: 1px;
                border-color: root.clock-timer-ringing ? Theme.specular-rim-active : Theme.specular-rim;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        TouchArea { clicked => { root.clock-open-app(); } }
                        Rectangle {
                            width: 34px; height: 34px; border-radius: 17px;
                            background: root.clock-timer-ringing ? Theme.primary : Theme.primary-container;
                            Path {
                                width: 18px; height: 18px;
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                viewbox-width: 24; viewbox-height: 24;
                                commands: "M9 3 H15 M12 6 A 8 8 0 1 1 11.99 6 Z M12 10 V14 L14.5 15.5";
                                stroke: root.clock-timer-ringing ? Theme.on-primary : Theme.on-primary-container;
                                stroke-width: 2px; stroke-line-cap: round; stroke-line-join: round; fill: transparent;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: root.clock-timer-ringing ? @tr("Timer Done") : (root.clock-timer-running ? @tr("Timer Running") : @tr("Timer Paused"));
                                font-size: Theme.font-caption;
                                font-weight: 700;
                                color: root.clock-timer-ringing ? Theme.on-primary-container : Theme.primary;
                            }
                            Text {
                                text: root.clock-timer-text;
                                font-size: 16px;
                                font-weight: 700;
                                color: root.clock-timer-ringing ? Theme.on-primary-container : Theme.on-surface;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1; height: 30px; border-radius: Theme.radius-pill;
                            background: Theme.primary;
                            Text {
                                text: root.clock-timer-ringing ? @tr("Stop") : (root.clock-timer-running ? @tr("Pause") : @tr("Resume"));
                                font-size: 12px; font-weight: 700; color: Theme.on-primary;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.clock-timer-toggle(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 30px; border-radius: Theme.radius-pill;
                            background: Theme.surface-container-highest;
                            Text { text: "+1m"; font-size: 12px; font-weight: 600; color: Theme.on-surface; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.clock-timer-add-min(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1; height: 30px; border-radius: Theme.radius-pill;
                            background: Theme.surface-container-high;
                            Text { text: @tr("Cancel"); font-size: 12px; font-weight: 600; color: Theme.on-surface-variant; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.clock-timer-cancel(); } }
                        }
                    }
                }
            }

            // Notification cards list
            for notif[idx] in root.notifications: NotificationCard {
                data: notif;
                index: idx;
                dismiss(i) => { root.dismiss-notification(i); }
            }
        }
    }
}
