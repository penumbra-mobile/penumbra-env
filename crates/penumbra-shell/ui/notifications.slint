import { Theme } from "theme.slint";
import { Icon } from "icon.slint";

export struct NotificationData {
    id: string,
    app: string,
    title: string,
    body: string,
    time-text: string,
}

// =========================================================================
// Material 3 Expressive Notification Card
// =========================================================================
export component NotificationCard inherits Rectangle {
    in property <NotificationData> data;
    in property <int> index;
    callback dismiss(int);
    callback clicked(int);

    property <length> swipe-x: 0px;
    property <float> touch-start-x: 0.0;
    property <float> touch-start-y: 0.0;
    property <bool> is-swiping: false;
    property <bool> is-pressed: false;

    height: 112px;
    background: transparent;

    card := Rectangle {
        x: root.swipe-x;
        width: parent.width;
        height: parent.height;
        border-radius: 22px;
        background: root.is-pressed ? #2d3238 : #23282e;
        border-width: 1px;
        border-color: Theme.specular-rim;
        clip: true;
        opacity: 1.0 - Math.clamp(Math.abs(root.swipe-x) / 160px, 0.0, 1.0);

        animate x { duration: root.is-swiping ? 0ms : 220ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate opacity { duration: root.is-swiping ? 0ms : 220ms; easing: cubic-bezier(0.2, 0.0, 0.0, 1.0); }
        animate background { duration: 150ms; }

        TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.touch-start-x = self.mouse-x / 1px;
                    root.touch-start-y = self.mouse-y / 1px;
                    root.is-pressed = true;
                    root.is-swiping = false;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.is-pressed = false;
                    if (root.is-swiping) {
                        root.is-swiping = false;
                        if (Math.abs(root.swipe-x) > 85px) {
                            root.dismiss(root.index);
                        } else {
                            root.swipe-x = 0px;
                        }
                    } else if (event.kind == PointerEventKind.up) {
                        root.clicked(root.index);
                    }
                }
            }
            moved => {
                if (self.pressed) {
                    let dx = (self.mouse-x / 1px) - root.touch-start-x;
                    let dy = (self.mouse-y / 1px) - root.touch-start-y;
                    if (Math.abs(dx) > 10.0 && Math.abs(dx) > Math.abs(dy) * 1.2) {
                        root.is-swiping = true;
                        root.swipe-x = dx * 1px;
                    }
                }
            }
        }

        VerticalLayout {
            padding-top: 10px;
            padding-bottom: 10px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 4px;

            // Header line: App icon, App name, Dot, Timestamp
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    // App icon badge
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        background: #a8c7fa;

                        Icon {
                            name: "bell";
                            icon-size: 12px;
                            icon-color: #04324a;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Text {
                        text: root.data.app;
                        font-size: 12px;
                        font-weight: 700;
                        color: #a8c7fa;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "•";
                        font-size: 10px;
                        color: Theme.on-surface-variant;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.data.time-text != "" ? root.data.time-text : "now";
                        font-size: 11px;
                        font-weight: 500;
                        color: Theme.on-surface-variant;
                        vertical-alignment: center;
                    }
                }

                // Dismiss button
                TouchArea {
                    width: 24px;
                    height: 24px;
                    clicked => { root.dismiss(root.index); }

                    Icon {
                        name: "close";
                        icon-size: 14px;
                        icon-color: Theme.on-surface-variant;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Title
            Text {
                text: root.data.title;
                font-size: 13px;
                font-weight: 700;
                color: Theme.on-surface;
                overflow: elide;
            }

            // Body
            Text {
                text: root.data.body;
                font-size: 12px;
                font-weight: 400;
                color: Theme.on-surface-variant;
                overflow: elide;
            }
        }
    }
}

// =========================================================================
// Material 3 Expressive Notification Empty State
// =========================================================================
export component NotificationEmptyState inherits Rectangle {
    callback swipe-up();

    TouchArea {
        width: 100%;
        height: 100%;
        property <length> press-y: 0px;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                self.press-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (self.mouse-y - self.press-y < -15px) {
                    root.swipe-up();
                }
            }
        }
    }

    VerticalLayout {
        spacing: 12px;
        alignment: center;

        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 28px;
            background: #23282e;
            border-width: 1px;
            border-color: Theme.specular-rim;
            x: (parent.width - self.width) / 2;

            Icon {
                name: "bell";
                icon-size: 26px;
                icon-color: #938f99;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: "No notifications";
            font-size: 16px;
            font-weight: 700;
            color: Theme.on-surface;
            horizontal-alignment: center;
        }

        Text {
            text: "You're all caught up!";
            font-size: 12px;
            font-weight: 400;
            color: Theme.on-surface-variant;
            horizontal-alignment: center;
        }
    }
}

// =========================================================================
// Notification Stack Container
// =========================================================================
export component NotificationStack inherits Rectangle {
    in property <[NotificationData]> notifications;
    callback dismiss-notification(int);
    callback clear-all();
    callback open-settings();
    callback swipe-up();

    border-radius: 28px;
    background: #181c20bb;
    border-width: 1px;
    border-color: Theme.specular-rim;
    clip: true;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: stack-layout.min-height;

        stack-layout := VerticalLayout {
            padding: 14px;
            spacing: 10px;

            // Header row: Section Title & Count badge
            HorizontalLayout {
                alignment: space-between;
                padding-left: 4px;
                padding-right: 4px;

                Text {
                    text: "NOTIFICATIONS";
                    font-size: 11px;
                    font-weight: 800;
                    color: #a8c7fa;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                }

                if root.notifications.length > 0: Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    background: #38353d;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "\{root.notifications.length}";
                            font-size: 11px;
                            font-weight: 700;
                            color: #a8c7fa;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Empty state
            if root.notifications.length == 0: NotificationEmptyState {
                height: 200px;
                swipe-up => { root.swipe-up(); }
            }

            // Notification cards list
            for notif[idx] in root.notifications: NotificationCard {
                data: notif;
                index: idx;
                dismiss(i) => { root.dismiss-notification(i); }
            }
        }
    }
}
