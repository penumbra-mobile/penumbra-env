export component DesktopIcon inherits Rectangle {
    in property <string> name: "grid";
    in property <color> icon-color: #E3E2E6;
    in property <length> icon-size: 18px;

    width: root.icon-size;
    height: root.icon-size;

    property <string> d: root.name == "grid" ? "M4 4 H9 V9 H4 Z M15 4 H20 V9 H15 Z M4 15 H9 V20 H4 Z M15 15 H20 V20 H15 Z"
        : root.name == "search" ? "M11 4 A 7 7 0 1 0 11 18 A 7 7 0 1 0 11 4 Z M16 16 L21 21"
        : root.name == "wifi" ? "M2 9 Q12 -1 22 9 M5 12.5 Q12 6 19 12.5 M8.5 16 Q12 12.5 15.5 16 M11.5 19 A 0.5 0.5 0 1 0 12.5 19 A 0.5 0.5 0 1 0 11.5 19 Z"
        : root.name == "battery" ? "M3 8 L19 8 L19 16 L3 16 Z M21 11 L21 13 M6 11 L14 11 L14 13 L6 13 Z"
        : root.name == "volume" ? "M4 9 L8 9 L13 5 L13 19 L8 15 L4 15 Z M16 9 Q18.5 12 16 15 M18.5 6.5 Q22 12 18.5 17.5"
        : root.name == "power" ? "M6.34 6.34 A 8 8 0 1 0 17.66 6.34 M12 3 L12 12"
        : root.name == "close" ? "M6 6 L18 18 M18 6 L6 18"
        : root.name == "terminal" ? "M4 4 L11 12 L4 20 M12 20 L20 20"
        : root.name == "browser" ? "M12 2 A 10 10 0 1 0 12 22 A 10 10 0 1 0 12 2 Z M2 12 H22 M12 2 A 15 15 0 0 1 12 22 A 15 15 0 0 1 12 2 Z"
        : root.name == "folder" ? "M2 6 A 2 2 0 0 1 4 4 L9 4 L11 7 L20 7 A 2 2 0 0 1 22 9 L22 18 A 2 2 0 0 1 20 20 L4 20 A 2 2 0 0 1 2 18 Z"
        : root.name == "edit" ? "M4 20 L8 19 L19 8 L16 5 L5 16 Z"
        : root.name == "settings" ? "M4 7 L20 7 M4 17 L20 17 M9 4 L9 10 M15 14 L15 20"
        : "M4 4 H9 V9 H4 Z M15 4 H20 V9 H15 Z M4 15 H9 V20 H4 Z M15 15 H20 V20 H15 Z";

    Path {
        width: 100%;
        height: 100%;
        commands: root.d;
        stroke: root.icon-color;
        stroke-width: 1.8px;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
    }
}
