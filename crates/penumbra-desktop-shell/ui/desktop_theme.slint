export global DesktopTheme {
    // Material 3 Expressive Tonal Glass Hierarchy for Desktop Mode
    in-out property <color> surface: #121016;
    in-out property <color> surface-glass: #14121acc;
    in-out property <color> panel-bg: #14121ae6;
    in-out property <color> dock-bg: #181520dd;
    in-out property <color> modal-bg: #1a1724f2;
    in-out property <color> scrim-bg: #00000088;

    // Specular highlight rims and borders
    in-out property <color> border-subtle: #ffffff18;
    in-out property <color> border-focused: #ffffff30;
    in-out property <color> specular-rim: #ffffff22;

    // Monet Accent Roles
    in-out property <color> primary: #ADC6FF;
    in-out property <color> on-primary: #002E69;
    in-out property <color> primary-container: #254070;
    in-out property <color> on-primary-container: #D8E2FF;

    in-out property <color> secondary-container: #3E4758;
    in-out property <color> on-secondary-container: #DBE2F9;

    in-out property <color> tertiary: #EFB8C8;
    in-out property <color> on-tertiary: #492532;

    // Functional & Status Colors
    in-out property <color> on-surface: #E3E2E6;
    in-out property <color> on-surface-variant: #C4C6D0;
    in-out property <color> on-surface-muted: #8E9099;
    in-out property <color> error: #FFB4AB;
    in-out property <color> success: #7BD0A2;

    // Hover & Active States
    in-out property <color> hover-tint: #ffffff12;
    in-out property <color> active-tint: #ffffff24;

    // Desktop Dimensions & Typography
    in-out property <length> panel-height: 36px;
    in-out property <length> dock-height: 64px;
    in-out property <length> font-title: 15px;
    in-out property <length> font-body: 13px;
    in-out property <length> font-caption: 11px;
}
