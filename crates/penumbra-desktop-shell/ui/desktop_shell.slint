import { DesktopTheme } from "desktop_theme.slint";
import { DesktopIcon } from "desktop_icon.slint";

export struct DesktopAppEntry {
    id: string,
    name: string,
    exec: string,
    category: string,
    icon-name: string,
    icon: image,
    has-icon: bool,
}

export struct DesktopDockApp {
    id: string,
    name: string,
    icon-name: string,
    icon: image,
    has-icon: bool,
    is-running: bool,
    is-active: bool,
}

// Wallpaper + right-click context menu (Layer::Background)
component DesktopMenuRow inherits Rectangle {
    in property <string> label;
    in property <string> icon-name;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: ta.has-hover ? DesktopTheme.hover-tint : transparent;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            DesktopIcon {
                name: root.icon-name;
                icon-size: 14px;
                icon-color: DesktopTheme.on-surface-variant;
            }
        }

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 500;
            color: DesktopTheme.on-surface;
            vertical-alignment: center;
        }
    }
}

export component DesktopWallpaperWindow inherits Window {
    in property <image> wallpaper;
    in property <bool> has-wallpaper: false;
    in-out property <bool> menu-open: false;
    in-out property <length> menu-x: 100px;
    in-out property <length> menu-y: 100px;

    callback open-terminal();
    callback open-files();
    callback open-launcher();
    callback open-settings(string);

    background: #0d0f14;

    if !root.has-wallpaper: Rectangle {
        width: 100%;
        height: 100%;
        background: DesktopTheme.surface;
    }

    if root.has-wallpaper: Image {
        width: 100%;
        height: 100%;
        source: root.wallpaper;
        image-fit: cover;
    }

    bg-ta := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.right) {
                    root.menu-x = Math.clamp(self.mouse-x, 12px, root.width - 212px);
                    root.menu-y = Math.clamp(self.mouse-y, 38px, root.height - 250px);
                    root.menu-open = true;
                } else {
                    root.menu-open = false;
                }
            }
        }
    }

    if root.menu-open: Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: 204px;
        height: menu-col.preferred-height;
        border-radius: 12px;
        background: DesktopTheme.modal-bg;
        border-width: 1px;
        border-color: DesktopTheme.specular-rim;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000099;
        drop-shadow-offset-y: 6px;

        menu-col := VerticalLayout {
            padding: 6px;
            spacing: 2px;

            DesktopMenuRow {
                label: @tr("Open Terminal");
                icon-name: "terminal";
                clicked => { root.menu-open = false; root.open-terminal(); }
            }
            DesktopMenuRow {
                label: @tr("Open Files");
                icon-name: "folder";
                clicked => { root.menu-open = false; root.open-files(); }
            }
            DesktopMenuRow {
                label: @tr("Applications");
                icon-name: "grid";
                clicked => { root.menu-open = false; root.open-launcher(); }
            }

            Rectangle { height: 1px; background: DesktopTheme.border-subtle; }

            DesktopMenuRow {
                label: @tr("Wallpaper & style");
                icon-name: "edit";
                clicked => { root.menu-open = false; root.open-settings("appearance"); }
            }
            DesktopMenuRow {
                label: @tr("Display settings");
                icon-name: "settings";
                clicked => { root.menu-open = false; root.open-settings("display"); }
            }
        }
    }
}

// Top desktop panel (Layer::Top, 36px)
export component DesktopPanelWindow inherits Window {
    in-out property <int> active-workspace: 1;
    in-out property <int> total-workspaces: 4;
    in-out property <string> time-text: "15:45";
    in-out property <string> date-text: "Thu, Oct 29";
    in-out property <float> battery-pct: 100.0;
    in-out property <bool> is-charging: false;
    in-out property <bool> wifi-connected: true;
    in-out property <string> wifi-ssid: "Wi-Fi";
    in-out property <int> wifi-signal: 4;
    in-out property <bool> launcher-active: false;
    in-out property <string> active-applet: "";

    callback toggle-launcher();
    callback switch-workspace(int);
    callback open-applet(string); // "time", "network", "audio", "battery", "power"
    callback time-clicked();

    height: DesktopTheme.panel-height;
    background: transparent;

    Rectangle {
        width: 100%;
        height: 100%;
        background: DesktopTheme.panel-bg;
        Rectangle {
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: DesktopTheme.border-subtle;
        }

        // Left: workspaces and applications launcher
        HorizontalLayout {
            x: 10px;
            y: (parent.height - self.height) / 2;
            width: self.preferred-width;
            height: 26px;
            spacing: 6px;
            alignment: start;

                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;

                    for ws in [1, 2, 3, 4]: Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 8px;
                        background: ws == root.active-workspace
                            ? DesktopTheme.primary-container
                            : (ws-touch.has-hover ? DesktopTheme.hover-tint : transparent);

                        animate background { duration: 100ms; }

                        Text {
                            text: ws;
                            font-size: 11px;
                            font-weight: ws == root.active-workspace ? 700 : 500;
                            color: ws == root.active-workspace ? DesktopTheme.on-primary-container : DesktopTheme.on-surface-variant;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        ws-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.switch-workspace(ws);
                            }
                        }
                    }
                }

                Rectangle {
                    width: launcher-hl.preferred-width;
                    height: 26px;
                    border-radius: 8px;
                    background: root.launcher-active
                        ? DesktopTheme.primary-container
                        : (launcher-touch.has-hover ? DesktopTheme.hover-tint : transparent);

                    animate background { duration: 100ms; }

                    launcher-hl := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 5px;
                        alignment: center;

                        Text {
                            text: @tr("Applications");
                            font-size: 12px;
                            font-weight: 600;
                            color: root.launcher-active ? DesktopTheme.on-primary-container : DesktopTheme.on-surface;
                            vertical-alignment: center;
                        }
                    }

                    launcher-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-launcher();
                        }
                    }
                }
        }

        // Center: date and clock
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: clock-hl.preferred-width;
            height: 26px;
            border-radius: 8px;
            background: root.active-applet == "time"
                ? DesktopTheme.primary-container
                : (clock-touch.has-hover ? DesktopTheme.hover-tint : transparent);

            animate background { duration: 100ms; }

            clock-hl := HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                alignment: center;

                Text {
                    text: root.date-text + "  " + root.time-text;
                    font-size: 12px;
                    font-weight: 600;
                    color: root.active-applet == "time" ? DesktopTheme.on-primary-container : DesktopTheme.on-surface;
                    vertical-alignment: center;
                }
            }

            clock-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open-applet("time");
                    root.time-clicked();
                }
            }
        }

        // Right: audio, network, battery, power applets
        HorizontalLayout {
            x: parent.width - self.width - 10px;
            y: (parent.height - self.height) / 2;
            width: self.preferred-width;
            height: 26px;
            spacing: 4px;
            alignment: end;

                Rectangle {
                    width: 28px;
                    height: 26px;
                    border-radius: 8px;
                    background: root.active-applet == "audio"
                        ? DesktopTheme.primary-container
                        : (aud-touch.has-hover ? DesktopTheme.hover-tint : transparent);

                    animate background { duration: 100ms; }

                    DesktopIcon {
                        name: "volume";
                        icon-size: 14px;
                        icon-color: root.active-applet == "audio" ? DesktopTheme.on-primary-container : DesktopTheme.on-surface;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    aud-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-applet("audio"); }
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 26px;
                    border-radius: 8px;
                    background: root.active-applet == "network"
                        ? DesktopTheme.primary-container
                        : (net-touch.has-hover ? DesktopTheme.hover-tint : transparent);

                    animate background { duration: 100ms; }

                    DesktopIcon {
                        name: "wifi";
                        icon-size: 14px;
                        icon-color: root.active-applet == "network"
                            ? DesktopTheme.on-primary-container
                            : (root.wifi-connected ? DesktopTheme.on-surface : DesktopTheme.on-surface-muted);
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    net-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-applet("network"); }
                    }
                }

                Rectangle {
                    width: bat-hl.preferred-width;
                    height: 26px;
                    border-radius: 8px;
                    background: root.active-applet == "battery"
                        ? DesktopTheme.primary-container
                        : (bat-touch.has-hover ? DesktopTheme.hover-tint : transparent);

                    animate background { duration: 100ms; }

                    bat-hl := HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        spacing: 4px;
                        alignment: center;

                        VerticalLayout {
                            width: 14px;
                            height: 100%;
                            alignment: center;

                            DesktopIcon {
                                name: "battery";
                                icon-size: 14px;
                                icon-color: root.is-charging
                                    ? DesktopTheme.success
                                    : (root.battery-pct < 20.0 ? DesktopTheme.error : DesktopTheme.on-surface);
                            }
                        }

                        Text {
                            text: Math.round(root.battery-pct) + "%";
                            font-size: 11px;
                            font-weight: 600;
                            color: root.active-applet == "battery" ? DesktopTheme.on-primary-container : DesktopTheme.on-surface;
                            vertical-alignment: center;
                        }
                    }

                    bat-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-applet("battery"); }
                    }
                }

                Rectangle {
                    width: 28px;
                    height: 26px;
                    border-radius: 8px;
                    background: root.active-applet == "power"
                        ? DesktopTheme.error
                        : (power-touch.has-hover ? DesktopTheme.hover-tint : transparent);

                    animate background { duration: 100ms; }

                    DesktopIcon {
                        name: "power";
                        icon-size: 14px;
                        icon-color: root.active-applet == "power" ? DesktopTheme.surface : DesktopTheme.on-surface;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    power-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-applet("power");
                        }
                    }
                }
        }
    }
}

// Bottom dock (Layer::Top, 64px)
export component DesktopDockWindow inherits Window {
    in-out property <[DesktopDockApp]> dock-apps: [];
    in-out property <bool> launcher-active: false;

    callback app-clicked(string);
    callback launcher-clicked();

    height: DesktopTheme.dock-height;
    background: transparent;

    HorizontalLayout {
        alignment: center;

        Rectangle {
            height: 58px;
            y: 3px;
            border-radius: 20px;
            background: DesktopTheme.dock-bg;
            border-width: 1px;
            border-color: DesktopTheme.specular-rim;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 8px;
                alignment: center;

                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: apps-touch.pressed ? 12px : 16px;
                    background: root.launcher-active
                        ? DesktopTheme.primary-container
                        : (apps-touch.has-hover ? DesktopTheme.hover-tint : DesktopTheme.surface);
                    border-width: 1px;
                    border-color: root.launcher-active ? DesktopTheme.primary : DesktopTheme.border-subtle;

                    animate background, border-radius { duration: 120ms; }

                    DesktopIcon {
                        name: "grid";
                        icon-size: 22px;
                        icon-color: root.launcher-active ? DesktopTheme.on-primary-container : DesktopTheme.primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    apps-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.launcher-clicked();
                        }
                    }
                }

                if root.dock-apps.length > 0: VerticalLayout {
                    width: 1px;
                    height: 48px;
                    alignment: center;

                    Rectangle {
                        width: 1px;
                        height: 28px;
                        background: DesktopTheme.border-subtle;
                    }
                }

                for app in root.dock-apps: Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: app-touch.pressed ? 12px : 16px;
                    background: app.is-active
                        ? DesktopTheme.primary-container
                        : (app-touch.has-hover ? DesktopTheme.hover-tint : transparent);

                    animate background, border-radius { duration: 120ms; }

                    if app.has-icon: Image {
                        source: app.icon;
                        width: 34px;
                        height: 34px;
                        image-fit: contain;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    if !app.has-icon: DesktopIcon {
                        name: app.icon-name;
                        icon-size: 24px;
                        icon-color: app.is-active ? DesktopTheme.on-primary-container : DesktopTheme.on-surface;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    if app.is-running: Rectangle {
                        width: app.is-active ? 16px : 5px;
                        height: 4px;
                        border-radius: 2px;
                        background: app.is-active ? DesktopTheme.primary : DesktopTheme.on-surface-muted;
                        x: (parent.width - self.width) / 2;
                        y: parent.height - 5px;
                        animate width { duration: 140ms; }
                    }

                    app-touch := TouchArea {
                        clicked => {
                            root.app-clicked(app.id);
                        }
                    }
                }
            }
        }
    }
}

// Application launcher overlay (Layer::Overlay)
export component DesktopLauncherWindow inherits Window {
    in-out property <bool> is-open: false;
    in-out property <string> search-text: "";
    in-out property <string> calc-result: "";
    in-out property <string> active-category: "All";
    in-out property <[DesktopAppEntry]> apps: [];

    callback search-query-changed(string);
    callback category-selected(string);
    callback app-clicked(string, string); // (id, exec)
    callback close-requested();

    changed is-open => {
        if (self.is-open) {
            search-input.focus();
        }
    }

    background: transparent;

    // Fullscreen Scrim Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: DesktopTheme.scrim-bg;
        opacity: root.is-open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;

        animate opacity { duration: 150ms; }

        scrim-touch := TouchArea {
            clicked => {
                root.close-requested();
            }
        }

        Rectangle {
            width: Math.min(820px, parent.width - 64px);
            height: Math.min(600px, parent.height - 120px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (root.is-open ? 0px : 18px);
            border-radius: 28px;
            background: DesktopTheme.modal-bg;
            border-width: 1px;
            border-color: DesktopTheme.specular-rim;
            clip: true;

            animate y { duration: 170ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }

            // Absorb clicks inside the launcher card so only clicking the outer scrim closes it
            TouchArea {}

            VerticalLayout {
                padding-top: 22px;
                padding-bottom: 16px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 16px;

                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: Math.min(480px, parent.width - 48px);
                        height: 44px;
                        border-radius: 22px;
                        background: DesktopTheme.surface;
                        border-width: 1px;
                        border-color: search-input.has-focus ? DesktopTheme.primary : DesktopTheme.border-subtle;

                        animate border-color { duration: 120ms; }

                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 10px;

                            VerticalLayout {
                                alignment: center;
                                DesktopIcon {
                                    name: "search";
                                    icon-size: 18px;
                                    icon-color: search-input.has-focus ? DesktopTheme.primary : DesktopTheme.on-surface-variant;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 100%;
                                background: transparent;

                                if root.search-text == "": Text {
                                    x: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    text: @tr("Search apps or =calculate...");
                                    font-size: DesktopTheme.font-body;
                                    color: DesktopTheme.on-surface-muted;
                                    vertical-alignment: center;
                                }

                                search-input := TextInput {
                                    x: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.search-text;
                                    font-size: DesktopTheme.font-body;
                                    color: DesktopTheme.on-surface;
                                    vertical-alignment: center;
                                    single-line: true;

                                    edited => {
                                        root.search-text = self.text;
                                        root.search-query-changed(self.text);
                                    }
                                    accepted => {
                                        if root.apps.length > 0 {
                                            root.app-clicked(root.apps[0].id, root.apps[0].exec);
                                        }
                                    }
                                }
                            }

                            if root.search-text != "": VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: search-clear-ta.has-hover ? DesktopTheme.hover-tint : transparent;

                                    DesktopIcon {
                                        name: "close";
                                        icon-size: 14px;
                                        icon-color: DesktopTheme.on-surface-variant;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    search-clear-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.search-text = "";
                                            root.search-query-changed("");
                                            search-input.focus();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.calc-result != "": HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: Math.min(480px, parent.width - 48px);
                        height: 44px;
                        border-radius: 14px;
                        background: DesktopTheme.primary-container;
                        border-width: 1px;
                        border-color: DesktopTheme.primary;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;
                            Text {
                                text: @tr("Calculator");
                                font-size: DesktopTheme.font-caption;
                                font-weight: 600;
                                color: DesktopTheme.on-primary-container;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "= " + root.calc-result;
                                font-size: DesktopTheme.font-title;
                                font-weight: 700;
                                color: DesktopTheme.on-primary-container;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    height: 34px;
                    alignment: center;

                    for cat in ["All", "Internet", "Utilities", "System", "Development", "Office", "Multimedia"]: Rectangle {
                        width: cat-hl.preferred-width;
                        height: 32px;
                        border-radius: 16px;
                        background: cat == root.active-category ? DesktopTheme.primary : (cat-touch.has-hover ? DesktopTheme.hover-tint : DesktopTheme.surface);
                        border-width: 1px;
                        border-color: cat == root.active-category ? DesktopTheme.primary : DesktopTheme.border-subtle;

                        animate background { duration: 150ms; }

                        cat-hl := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;

                            Text {
                                text: cat == "All" ? @tr("All") :
                                      cat == "Internet" ? @tr("Internet") :
                                      cat == "Utilities" ? @tr("Utilities") :
                                      cat == "System" ? @tr("System") :
                                      cat == "Development" ? @tr("Development") :
                                      cat == "Office" ? @tr("Office") :
                                      cat == "Multimedia" ? @tr("Multimedia") : cat;
                                font-size: DesktopTheme.font-caption;
                                font-weight: 600;
                                color: cat == root.active-category ? DesktopTheme.on-primary : DesktopTheme.on-surface-variant;
                                vertical-alignment: center;
                            }
                        }

                        cat-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.active-category = cat;
                                root.category-selected(cat);
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: DesktopTheme.border-subtle;
                }

                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    if root.apps.length == 0: Text {
                        width: 100%;
                        height: 100%;
                        text: @tr("No matching applications");
                        font-size: DesktopTheme.font-body;
                        color: DesktopTheme.on-surface-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.apps.length > 0: Flickable {
                        width: 100%;
                        height: 100%;
                        content-height: grid-container.height;

                        grid-container := Rectangle {
                            width: parent.width;
                            property <int> cols: Math.max(1, Math.floor(parent.width / 132px));
                            property <length> col-w: parent.width / grid-container.cols;
                            height: Math.max(1, Math.ceil(root.apps.length / grid-container.cols)) * 114px + 12px;

                            for app[idx] in root.apps: Rectangle {
                                x: Math.mod(idx, grid-container.cols) * grid-container.col-w + (grid-container.col-w - self.width) / 2;
                                y: Math.floor(idx / grid-container.cols) * 114px + 4px;
                                width: 124px;
                                height: 106px;
                                border-radius: card-touch.pressed ? 14px : 18px;
                                background: card-touch.has-hover ? DesktopTheme.hover-tint : transparent;
                                border-width: 1px;
                                border-color: card-touch.has-hover ? DesktopTheme.border-subtle : transparent;

                                animate background, border-radius { duration: 120ms; }

                                VerticalLayout {
                                    padding-top: 10px;
                                    padding-bottom: 8px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    alignment: center;

                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 58px;
                                            height: 58px;
                                            background: transparent;

                                            Rectangle {
                                                width: card-touch.pressed ? 52px : 56px;
                                                height: card-touch.pressed ? 52px : 56px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 16px;
                                                background: DesktopTheme.surface;
                                                border-width: 1px;
                                                border-color: DesktopTheme.specular-rim;
                                                clip: true;

                                                animate width, height { duration: 100ms; }

                                                if app.has-icon: Image {
                                                    source: app.icon;
                                                    width: parent.width * 0.78;
                                                    height: parent.height * 0.78;
                                                    image-fit: contain;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                if !app.has-icon: DesktopIcon {
                                                    name: app.icon-name;
                                                    icon-size: 26px;
                                                    icon-color: DesktopTheme.primary;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: app.name;
                                        font-size: DesktopTheme.font-caption;
                                        font-weight: 600;
                                        color: DesktopTheme.on-surface;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                        width: 100%;
                                    }
                                }

                                card-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.app-clicked(app.id, app.exec);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
