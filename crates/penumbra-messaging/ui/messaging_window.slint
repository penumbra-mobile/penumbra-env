export struct ThreadRow {
    peer-number: string,
    display-name: string,
    initials: string,
    last-message: string,
    time-label: string,
    unread-count: int,
}

export struct ChatBubble {
    id: string,
    text: string,
    outgoing: bool,
    time-label: string,
}

export struct ContactPickRow {
    name: string,
    phone: string,
    initials: string,
}

component MsgIcon inherits Rectangle {
    in property <string> name: "message";
    in property <length> icon-size: 20px;
    in property <color> icon-color: #ffffff;

    width: root.icon-size;
    height: root.icon-size;
    background: transparent;

    if root.name == "message": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z";
    }
    if root.name == "contacts": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z";
    }
    if root.name == "person": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z";
    }
    if root.name == "person-add": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z";
    }
    if root.name == "add": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z";
    }
    if root.name == "back": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z";
    }
    if root.name == "phone": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z";
    }
    if root.name == "send": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M2.01 21L23 12 2.01 3 2 10l15 2-15 2z";
    }
    if root.name == "search": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z";
    }
    if root.name == "close": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z";
    }
    if root.name == "delete": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z";
    }
    if root.name == "copy": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.icon-color;
        commands: "M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z";
    }
}

export component MessagingWindow inherits Window {
    title: @tr("Messages");
    preferred-width: 412px;
    preferred-height: 841px;
    background: root.bg-color;

    in-out property <color> bg-color: #0b0a0e;
    in-out property <color> surface-low: #17151d;
    in-out property <color> surface-high: #27232e;
    in-out property <color> primary: #d0bcff;
    in-out property <color> on-primary: #381e72;
    in-out property <color> primary-container: #4f378b;
    in-out property <color> on-primary-container: #eaddff;
    in-out property <color> on-surface: #e6e1e5;
    in-out property <color> on-surface-variant: #cac4d0;

    in property <[ThreadRow]> threads: [];
    in property <[ChatBubble]> messages: [];
    in property <[ContactPickRow]> contact-suggestions: [];
    in-out property <string> active-peer: "";
    in-out property <string> active-peer-name: "";
    in-out property <bool> composing-new: false;
    in-out property <string> thread-search: "";
    in-out property <string> new-recipient: "";
    in-out property <string> draft-text: "";
    in-out property <string> status-banner: "";
    in-out property <bool> sending: false;

    in-out property <bool> confirm-delete-thread: false;
    in-out property <string> action-msg-id: "";
    in-out property <string> action-msg-text: "";

    callback open-thread(string);
    callback back-to-threads();
    callback send-message(string, string);
    callback delete-message(string, string);
    callback delete-thread(string);
    callback copy-message(string);
    callback thread-search-changed(string);
    callback recipient-filter-changed(string);
    callback call-number(string);
    callback add-contact-number(string);
    callback open-contacts();

    // Threads list
    if root.active-peer == "" && !root.composing-new: VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 12px;

        HorizontalLayout {
            alignment: space-between;
            height: 44px;
            Text {
                text: @tr("Messages");
                font-size: 26px;
                font-weight: 700;
                color: root.on-surface;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    height: 44px;
                    border-radius: 16px;
                    background: contacts-btn-ta.pressed ? root.primary-container : root.surface-high;
                    border-width: 1px;
                    border-color: #ffffff14;
                    animate background { duration: 100ms; }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            MsgIcon { name: "contacts"; icon-size: 16px; icon-color: root.primary; }
                        }
                        Text {
                            text: @tr("Contacts");
                            font-size: 13px;
                            font-weight: 600;
                            color: root.primary;
                            vertical-alignment: center;
                        }
                    }
                    contacts-btn-ta := TouchArea { clicked => { root.open-contacts(); } }
                }
                Rectangle {
                    height: 44px;
                    border-radius: 16px;
                    background: new-btn-ta.pressed ? root.primary : root.primary-container;
                    border-width: 1px;
                    border-color: #ffffff1f;
                    animate background { duration: 100ms; }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            MsgIcon { name: "add"; icon-size: 16px; icon-color: root.on-primary-container; }
                        }
                        Text {
                            text: @tr("New");
                            font-size: 13px;
                            font-weight: 700;
                            color: root.on-primary-container;
                            vertical-alignment: center;
                        }
                    }
                    new-btn-ta := TouchArea {
                        clicked => {
                            root.new-recipient = "";
                            root.recipient-filter-changed("");
                            root.composing-new = true;
                        }
                    }
                }
            }
        }

        // Conversation search bar
        Rectangle {
            height: 46px;
            border-radius: 23px;
            background: root.surface-low;
            border-width: 1px;
            border-color: #ffffff14;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 6px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    MsgIcon { name: "search"; icon-size: 18px; icon-color: root.on-surface-variant; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                    if root.thread-search == "": Text {
                        text: @tr("Search conversations");
                        font-size: 14px;
                        color: root.on-surface-variant.with-alpha(0.65);
                        vertical-alignment: center;
                    }
                    TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.thread-search;
                        font-size: 14px;
                        color: root.on-surface;
                        vertical-alignment: center;
                        single-line: true;
                        edited => { root.thread-search-changed(self.text); }
                    }
                }
                if root.thread-search != "": Rectangle {
                    width: 44px;
                    height: 44px;
                    background: transparent;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 15px;
                        background: root.surface-high;
                        MsgIcon {
                            name: "close";
                            icon-size: 14px;
                            icon-color: root.on-surface-variant;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.thread-search = "";
                            root.thread-search-changed("");
                        }
                    }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: threads-col.min-height + 24px;
            threads-col := VerticalLayout {
                width: parent.width;
                spacing: 8px;

                if root.threads.length == 0: Rectangle {
                    height: 140px;
                    border-radius: 18px;
                    background: root.surface-low;
                    border-width: 1px;
                    border-color: #ffffff14;
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: center;
                            MsgIcon {
                                name: root.thread-search == "" ? "message" : "search";
                                icon-size: 28px;
                                icon-color: root.on-surface-variant;
                            }
                        }
                        Text {
                            text: root.thread-search == "" ? @tr("No conversations yet") : @tr("No matching conversations");
                            font-size: 15px;
                            font-weight: 500;
                            color: root.on-surface-variant;
                            horizontal-alignment: center;
                        }
                    }
                }

                for th in root.threads: Rectangle {
                    height: 76px;
                    border-radius: 18px;
                    background: th-ta.pressed ? root.surface-high : root.surface-low;
                    border-width: 1px;
                    border-color: th.unread-count > 0 ? root.primary.with-alpha(0.45) : (th-ta.pressed ? #ffffff26 : #ffffff14);
                    animate background { duration: 100ms; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 16px;
                        spacing: 12px;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 44px;
                                height: 44px;
                                border-radius: 22px;
                                background: root.primary-container;
                                border-width: 1px;
                                border-color: #ffffff1a;
                                if th.initials != "": Text {
                                    text: th.initials;
                                    font-size: 16px;
                                    font-weight: 700;
                                    color: root.on-primary-container;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                if th.initials == "": HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        MsgIcon { name: "person"; icon-size: 20px; icon-color: root.on-primary-container; }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: th.display-name != "" ? th.display-name : th.peer-number;
                                    font-size: 16px;
                                    font-weight: th.unread-count > 0 ? 700 : 600;
                                    color: root.on-surface;
                                    overflow: elide;
                                }
                                Text {
                                    text: th.time-label;
                                    font-size: 11px;
                                    font-weight: th.unread-count > 0 ? 700 : 500;
                                    color: th.unread-count > 0 ? root.primary : root.on-surface-variant;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: th.last-message;
                                    font-size: 13px;
                                    font-weight: th.unread-count > 0 ? 600 : 400;
                                    color: th.unread-count > 0 ? root.on-surface : root.on-surface-variant;
                                    overflow: elide;
                                }
                                if th.unread-count > 0: Rectangle {
                                    min-width: 22px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: root.primary;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: th.unread-count > 99 ? "99+" : th.unread-count;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: root.on-primary;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    th-ta := TouchArea {
                        clicked => { root.open-thread(th.peer-number); }
                    }
                }
            }
        }
    }

    // New conversation recipient entry and contact picker
    if root.composing-new && root.active-peer == "": VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 12px;
            height: 44px;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: comp-back-ta.pressed ? root.primary-container : root.surface-high;
                border-width: 1px;
                border-color: #ffffff14;
                MsgIcon {
                    name: "back";
                    icon-size: 18px;
                    icon-color: root.on-surface;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                comp-back-ta := TouchArea { clicked => { root.composing-new = false; } }
            }
            Text {
                text: @tr("New conversation");
                font-size: 20px;
                font-weight: 700;
                color: root.on-surface;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 50px;
            border-radius: 25px;
            background: root.surface-low;
            border-width: 1px;
            border-color: #ffffff14;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 4px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    MsgIcon { name: "search"; icon-size: 18px; icon-color: root.on-surface-variant; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                    if root.new-recipient == "": Text {
                        text: @tr("Enter name or phone number");
                        font-size: 14px;
                        color: root.on-surface-variant.with-alpha(0.65);
                        vertical-alignment: center;
                    }
                    TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.new-recipient;
                        font-size: 15px;
                        color: root.on-surface;
                        vertical-alignment: center;
                        single-line: true;
                        edited => { root.recipient-filter-changed(self.text); }
                        accepted => {
                            if (root.new-recipient != "") {
                                root.composing-new = false;
                                root.open-thread(root.new-recipient);
                            }
                        }
                    }
                }
                if root.new-recipient != "": Rectangle {
                    width: 44px;
                    height: 44px;
                    background: transparent;
                    Rectangle {
                        width: 30px;
                        height: 30px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        border-radius: 15px;
                        background: root.surface-high;
                        MsgIcon {
                            name: "close";
                            icon-size: 14px;
                            icon-color: root.on-surface-variant;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.new-recipient = "";
                            root.recipient-filter-changed("");
                        }
                    }
                }
            }
        }

        if root.new-recipient != "": Rectangle {
            height: 46px;
            border-radius: 16px;
            background: start-ta.pressed ? root.primary : root.primary-container;
            border-width: 1px;
            border-color: #ffffff1f;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Text {
                    text: @tr("Start chat with ") + root.new-recipient;
                    font-size: 14px;
                    font-weight: 700;
                    color: root.on-primary-container;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            start-ta := TouchArea {
                clicked => {
                    root.composing-new = false;
                    root.open-thread(root.new-recipient);
                }
            }
        }

        if root.contact-suggestions.length > 0: Text {
            text: @tr("Contacts");
            font-size: 12px;
            font-weight: 700;
            color: root.on-surface-variant;
        }

        Flickable {
            vertical-stretch: 1;
            content-height: pick-col.min-height + 16px;
            pick-col := VerticalLayout {
                width: parent.width;
                spacing: 8px;
                for c in root.contact-suggestions: Rectangle {
                    height: 64px;
                    border-radius: 16px;
                    background: pick-ta.pressed ? root.surface-high : root.surface-low;
                    border-width: 1px;
                    border-color: #ffffff14;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: root.primary-container;
                                Text {
                                    text: c.initials;
                                    font-size: 15px;
                                    font-weight: 700;
                                    color: root.on-primary-container;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text { text: c.name; font-size: 15px; font-weight: 600; color: root.on-surface; overflow: elide; }
                            Text { text: c.phone; font-size: 12px; color: root.on-surface-variant; overflow: elide; }
                        }
                    }
                    pick-ta := TouchArea {
                        clicked => {
                            root.composing-new = false;
                            root.open-thread(c.phone);
                        }
                    }
                }
            }
        }
    }

    // Active chat thread view
    if root.active-peer != "": VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            height: 44px;

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: chat-back-ta.pressed ? root.primary-container : root.surface-high;
                border-width: 1px;
                border-color: #ffffff14;
                MsgIcon {
                    name: "back";
                    icon-size: 18px;
                    icon-color: root.on-surface;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                chat-back-ta := TouchArea { clicked => { root.back-to-threads(); } }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.active-peer-name != "" ? root.active-peer-name : root.active-peer;
                    font-size: 17px;
                    font-weight: 700;
                    color: root.on-surface;
                    overflow: elide;
                }
                if root.active-peer-name != "": Text {
                    text: root.active-peer;
                    font-size: 12px;
                    color: root.on-surface-variant;
                    overflow: elide;
                }
            }

            if root.active-peer-name == "": Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: save-peer-ta.pressed ? root.primary-container : root.surface-high;
                border-width: 1px;
                border-color: #ffffff14;
                MsgIcon {
                    name: "person-add";
                    icon-size: 18px;
                    icon-color: root.primary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                save-peer-ta := TouchArea { clicked => { root.add-contact-number(root.active-peer); } }
            }

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: del-thread-ta.pressed ? #93000a : root.surface-high;
                border-width: 1px;
                border-color: #ffffff14;
                MsgIcon {
                    name: "delete";
                    icon-size: 18px;
                    icon-color: root.on-surface-variant;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                del-thread-ta := TouchArea { clicked => { root.confirm-delete-thread = true; } }
            }

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: chat-call-ta.pressed ? #1b5e20 : #2e7d32;
                border-width: 1px;
                border-color: #a3e8b033;
                MsgIcon {
                    name: "phone";
                    icon-size: 18px;
                    icon-color: #ffffff;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                chat-call-ta := TouchArea { clicked => { root.call-number(root.active-peer); } }
            }
        }

        if root.status-banner != "": Rectangle {
            height: 44px;
            border-radius: 14px;
            background: #93000a;
            border-width: 1px;
            border-color: #ffb4a933;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 4px;
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.status-banner;
                    font-size: 12px;
                    font-weight: 500;
                    color: #ffdad6;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    width: 44px;
                    height: 44px;
                    background: transparent;
                    MsgIcon {
                        name: "close";
                        icon-size: 16px;
                        icon-color: #ffdad6;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    TouchArea { clicked => { root.status-banner = ""; } }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: msgs-col.min-height + 16px;
            content-y: Math.min(0px, self.height - msgs-col.min-height - 16px);
            msgs-col := VerticalLayout {
                width: parent.width;
                spacing: 8px;

                if root.messages.length == 0: Rectangle {
                    height: 120px;
                    border-radius: 18px;
                    background: root.surface-low;
                    border-width: 1px;
                    border-color: #ffffff14;
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: center;
                            MsgIcon { name: "message"; icon-size: 24px; icon-color: root.on-surface-variant; }
                        }
                        Text {
                            text: @tr("No messages yet");
                            font-size: 14px;
                            color: root.on-surface-variant;
                            horizontal-alignment: center;
                        }
                    }
                }

                for msg in root.messages: HorizontalLayout {
                    alignment: msg.outgoing ? end : start;
                    Rectangle {
                        min-width: 68px;
                        max-width: 292px;
                        border-top-left-radius: 18px;
                        border-top-right-radius: 18px;
                        border-bottom-left-radius: msg.outgoing ? 18px : 6px;
                        border-bottom-right-radius: msg.outgoing ? 6px : 18px;
                        background: msg.outgoing ? root.primary-container : root.surface-low;
                        border-width: 1px;
                        border-color: msg.outgoing ? #ffffff1f : #ffffff14;
                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 4px;
                            Text {
                                text: msg.text;
                                font-size: 14px;
                                color: msg.outgoing ? root.on-primary-container : root.on-surface;
                                wrap: word-wrap;
                            }
                            Text {
                                text: msg.time-label;
                                font-size: 10px;
                                color: msg.outgoing ? root.on-primary-container.with-alpha(0.75) : root.on-surface-variant;
                                horizontal-alignment: right;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.action-msg-id = msg.id;
                                root.action-msg-text = msg.text;
                            }
                        }
                    }
                }
            }
        }

        // SMS character and segment counter when composing long messages
        if root.draft-text != "": HorizontalLayout {
            alignment: end;
            padding-right: 58px;
            Text {
                property <int> chars: root.draft-text.character-count;
                property <int> segs: chars <= 160 ? 1 : Math.ceil(chars / 153);
                text: segs > 1 ? "\{chars} (\{segs} SMS)" : "\{chars}/160";
                font-size: 11px;
                font-weight: 600;
                color: segs > 1 ? root.primary : root.on-surface-variant;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 48px;
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 24px;
                background: root.surface-low;
                border-width: 1px;
                border-color: #ffffff14;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                        if root.draft-text == "": Text {
                            text: @tr("Text message");
                            font-size: 14px;
                            color: root.on-surface-variant.with-alpha(0.65);
                            vertical-alignment: center;
                        }
                        TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> root.draft-text;
                            font-size: 14px;
                            color: root.on-surface;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => {
                                if (root.draft-text != "" && !root.sending) {
                                    root.send-message(root.active-peer, root.draft-text);
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: (root.draft-text == "" || root.sending) ? root.primary-container.with-alpha(0.45) : (send-ta.pressed ? root.primary : root.primary-container);
                border-width: 1px;
                border-color: #ffffff1f;
                animate background { duration: 100ms; }
                MsgIcon {
                    name: "send";
                    icon-size: 20px;
                    icon-color: root.on-primary-container;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                send-ta := TouchArea {
                    clicked => {
                        if (root.draft-text != "" && !root.sending) {
                            root.send-message(root.active-peer, root.draft-text);
                        }
                    }
                }
            }
        }
    }

    // Message action sheet (Copy / Delete)
    if root.action-msg-id != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        TouchArea {
            clicked => {
                root.action-msg-id = "";
                root.action-msg-text = "";
            }
        }

        Rectangle {
            x: 16px;
            y: parent.height - self.height - 16px;
            width: parent.width - 32px;
            height: msg-sheet-col.preferred-height;
            border-radius: 24px;
            background: root.surface-high;
            border-width: 1px;
            border-color: #ffffff1f;

            msg-sheet-col := VerticalLayout {
                padding: 16px;
                spacing: 8px;

                Text {
                    text: root.action-msg-text;
                    font-size: 13px;
                    color: root.on-surface-variant;
                    overflow: elide;
                }

                Rectangle {
                    height: 48px;
                    border-radius: 14px;
                    background: copy-row-ta.pressed ? root.primary-container : root.surface-low;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            MsgIcon { name: "copy"; icon-size: 18px; icon-color: root.primary; }
                        }
                        Text {
                            text: @tr("Copy text");
                            font-size: 15px;
                            font-weight: 600;
                            color: root.on-surface;
                            vertical-alignment: center;
                        }
                    }
                    copy-row-ta := TouchArea {
                        clicked => {
                            root.copy-message(root.action-msg-text);
                            root.action-msg-id = "";
                            root.action-msg-text = "";
                        }
                    }
                }

                Rectangle {
                    height: 48px;
                    border-radius: 14px;
                    background: del-row-ta.pressed ? #93000a : root.surface-low;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            MsgIcon { name: "delete"; icon-size: 18px; icon-color: #ffb4ab; }
                        }
                        Text {
                            text: @tr("Delete message");
                            font-size: 15px;
                            font-weight: 600;
                            color: #ffb4ab;
                            vertical-alignment: center;
                        }
                    }
                    del-row-ta := TouchArea {
                        clicked => {
                            root.delete-message(root.active-peer, root.action-msg-id);
                            root.action-msg-id = "";
                            root.action-msg-text = "";
                        }
                    }
                }
            }
        }
    }

    // Delete conversation confirmation dialog
    if root.confirm-delete-thread: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.min(parent.width - 36px, 340px);
            height: del-dlg-col.preferred-height;
            border-radius: 24px;
            background: root.surface-high;
            border-width: 1px;
            border-color: #ffffff1f;

            del-dlg-col := VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: @tr("Delete conversation?");
                    font-size: 18px;
                    font-weight: 700;
                    color: root.on-surface;
                }

                Text {
                    text: @tr("This will remove all messages with {} from this device.", root.active-peer-name != "" ? root.active-peer-name : root.active-peer);
                    font-size: 13px;
                    color: root.on-surface-variant;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        height: 44px;
                        horizontal-stretch: 1;
                        border-radius: 14px;
                        background: cancel-del-ta.pressed ? root.primary-container : root.surface-low;
                        Text {
                            text: @tr("Cancel");
                            font-size: 14px;
                            font-weight: 600;
                            color: root.on-surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cancel-del-ta := TouchArea { clicked => { root.confirm-delete-thread = false; } }
                    }
                    Rectangle {
                        height: 44px;
                        horizontal-stretch: 1;
                        border-radius: 14px;
                        background: confirm-del-ta.pressed ? #b3261e : #93000a;
                        Text {
                            text: @tr("Delete");
                            font-size: 14px;
                            font-weight: 700;
                            color: #ffdad6;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        confirm-del-ta := TouchArea {
                            clicked => {
                                root.confirm-delete-thread = false;
                                root.delete-thread(root.active-peer);
                            }
                        }
                    }
                }
            }
        }
    }
}
