import { Theme } from "../theme.slint";
import { Icon } from "../icon.slint";
import { SettingsTile, M3Switch } from "../components/settings_tile.slint";
import { SettingsSectionCard, SettingsSectionHeader } from "../components/settings_section.slint";

// ==============================================================================
// Data Structure: BtDeviceData
// ==============================================================================
// Represents a remote Bluetooth device discovered or managed via BlueZ.
export struct BtDeviceData {
    // Advertised friendly name or fallback hardware address of the device.
    name: string,
    // Unique Bluetooth hardware MAC address (e.g. "AA:BB:CC:DD:EE:FF").
    address: string,
    // Human-readable device category derived from BlueZ Icon (e.g. "Headphones").
    device-type: string,
    // Whether an active ACL/profile connection currently exists to this device.
    connected: bool,
    // Whether the device is paired and stored in the adapter's key store.
    paired: bool,
    // Reported battery percentage (0 to 100), or -1 if the device lacks battery reporting.
    battery: int,
}

// ==============================================================================
// Component: PageBluetooth
// ==============================================================================
// Bluetooth adapter and peripheral management subpage inspired by GNOME Settings.
export component PageBluetooth inherits Flickable {
    // Current Bluetooth adapter power state.
    in-out property <bool> bt-enabled: true;
    // Whether the adapter is discoverable by nearby devices.
    in-out property <bool> discoverable: false;
    // Human-readable broadcast name of the host adapter (e.g. "arch-legion").
    in property <string> adapter-name: "Bluetooth";
    // Real Bluetooth hardware MAC address.
    in property <string> bluetooth-mac: "5C:87:9C:27:10:A4";
    // Whether the adapter is actively running an LE or Classic discovery cycle.
    in property <bool> is-discovering: false;
    // List of paired and discovered Bluetooth accessories.
    in property <[BtDeviceData]> devices: [];

    in-out property <bool> editing-name: false;
    in-out property <string> rename-input: "";

    // Emitted when the user toggles the master Bluetooth power switch.
    callback toggle-bt(bool);
    // Emitted when the user taps a device row to toggle connect/disconnect or pair.
    callback toggle-device(string);
    // Emitted when the user forgets/unpairs a saved device.
    callback forget-device(string);
    // Emitted when the user taps "Pair new device" to begin discovery scanning.
    callback start-discovery();
    // Emitted when the user taps to stop discovery scanning.
    callback stop-discovery();
    // Emitted when the user toggles adapter discoverability.
    callback toggle-discoverable(bool);
    // Emitted when the user renames the Bluetooth adapter.
    callback rename-adapter(string);

    Flickable {
        width: 100%;
        height: 100%;

        content := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 96px;
            spacing: 12px;

        // Master Bluetooth Switch Card
        SettingsSectionCard {
            SettingsTile {
                icon-name: "bluetooth";
                icon-bg: root.bt-enabled ? #7dd8fc : #36343b;
                icon-tint: root.bt-enabled ? #00354e : #938f99;
                title: @tr("Use Bluetooth");
                subtitle: root.bt-enabled ? ("On • Visible as " + root.adapter-name) : "Off";
                is-switch: true;
                switch-checked: root.bt-enabled;
                show-divider: false;
                is-first: true;
                is-last: true;
                toggled(val) => { root.toggle-bt(val); }
            }
        }

        if root.bt-enabled: VerticalLayout {
            spacing: 12px;

            // Scan / Pair New Device Action
            SettingsSectionCard {
                SettingsTile {
                    icon-name: "refresh";
                    icon-bg: root.is-discovering ? Theme.primary : #a8c7fa;
                    icon-tint: #042b59;
                    title: root.is-discovering ? @tr("Scanning for devices... (Tap to stop)") : @tr("Scan for nearby devices");
                    subtitle: root.is-discovering ? "Discovery active on " + root.adapter-name : "Discover & pair Bluetooth accessories";
                    show-chevron: !root.is-discovering;
                    show-divider: false;
                    is-first: true;
                    is-last: true;
                    clicked => {
                        if root.is-discovering {
                            root.stop-discovery();
                        } else {
                            root.start-discovery();
                        }
                    }
                }
            }

            // Saved & Connected Devices (GNOME Settings style)
            VerticalLayout {
                spacing: 8px;
                SettingsSectionHeader { title: @tr("Saved & Connected Devices"); }
                SettingsSectionCard {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        if root.devices.length == 0: Text {
                            text: root.is-discovering
                                ? "Scanning for nearby Bluetooth devices..."
                                : "No Bluetooth devices found. Tap Scan to search.";
                            font-size: Theme.font-caption;
                            color: Theme.on-surface-variant;
                            wrap: word-wrap;
                        }

                        for dev in root.devices: VerticalLayout {
                            if dev.paired || dev.connected: Rectangle {
                                min-height: 62px;
                                border-radius: 16px;
                                background: dev.connected ? Theme.primary-container : #1e2025;
                                border-width: 1px;
                                border-color: dev.connected ? Theme.primary : Theme.specular-rim;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: dev.name;
                                            font-size: Theme.font-body;
                                            font-weight: 600;
                                            color: dev.connected ? Theme.on-primary-container : Theme.on-surface;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: (dev.device-type != "" ? dev.device-type + " • " : "")
                                                + (dev.connected
                                                    ? (dev.battery >= 0 ? "Connected • " + dev.battery + "%" : "Connected")
                                                    : "Disconnected");
                                            font-size: Theme.font-caption;
                                            color: dev.connected ? Theme.on-primary-container : Theme.on-surface-variant;
                                            overflow: elide;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        y: (parent.height - self.height) / 2;

                                        Rectangle {
                                            width: dev.connected ? 80px : 66px;
                                            height: 30px;
                                            border-radius: 15px;
                                            background: dev.connected ? Theme.surface-highest : Theme.primary;
                                            Text {
                                                text: dev.connected ? @tr("Disconnect") : @tr("Connect");
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: dev.connected ? Theme.on-surface : Theme.on-primary;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => { root.toggle-device(dev.address); }
                                            }
                                        }

                                        Rectangle {
                                            width: 60px;
                                            height: 30px;
                                            border-radius: 15px;
                                            background: #5c2020;
                                            Text {
                                                text: @tr("Forget");
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #ffb4ab;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            TouchArea {
                                                clicked => { root.forget-device(dev.address); }
                                            }
                                        }
                                    }
                                }

                                TouchArea {
                                    x: 0px;
                                    width: parent.width - 156px;
                                    clicked => { root.toggle-device(dev.address); }
                                }
                            }
                        }
                    }
                }
            }

            // Available Nearby Devices
            VerticalLayout {
                spacing: 8px;
                SettingsSectionHeader { title: @tr("Available Nearby"); }
                SettingsSectionCard {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        for dev in root.devices: VerticalLayout {
                            if !dev.paired && !dev.connected: Rectangle {
                                min-height: 64px;
                                border-radius: 16px;
                                background: #1e2025;
                                border-width: 1px;
                                border-color: Theme.specular-rim;

                                HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    padding-left: 14px;
                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 8px;
                                    alignment: space-between;

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: dev.name;
                                            font-size: Theme.font-body;
                                            font-weight: 600;
                                            color: Theme.on-surface;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: (dev.device-type != "" ? dev.device-type + " • " : "") + dev.address;
                                            font-size: Theme.font-caption;
                                            color: Theme.on-surface-variant;
                                            overflow: elide;
                                        }
                                    }

                                    Rectangle {
                                        width: 58px;
                                        height: 30px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 15px;
                                        background: Theme.primary;
                                        Text {
                                            text: @tr("Pair");
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: Theme.on-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                TouchArea {
                                    clicked => { root.toggle-device(dev.address); }
                                }
                            }
                        }
                    }
                }
            }

            // Device Preferences (Discoverability, Rename, MAC)
            VerticalLayout {
                spacing: 8px;
                SettingsSectionHeader { title: @tr("Connection preferences"); }
                SettingsSectionCard {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 12px;

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Visible to other devices");
                                    font-size: Theme.font-body;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                }
                                Text {
                                    text: "Allow nearby devices to discover " + root.adapter-name;
                                    font-size: Theme.font-caption;
                                    color: Theme.on-surface-variant;
                                }
                            }
                            M3Switch {
                                y: (parent.height - self.height) / 2;
                                checked <=> root.discoverable;
                                toggled(val) => { root.toggle-discoverable(val); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.outline-variant; }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("Device name");
                                    font-size: Theme.font-body;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                }
                                Text {
                                    text: root.adapter-name;
                                    font-size: Theme.font-caption;
                                    color: Theme.on-surface-variant;
                                }
                            }
                            Rectangle {
                                width: 64px;
                                height: 30px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 15px;
                                background: Theme.surface-highest;
                                Text {
                                    text: root.editing-name ? @tr("Close") : @tr("Edit");
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.on-surface;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        root.rename-input = root.adapter-name;
                                        root.editing-name = !root.editing-name;
                                    }
                                }
                            }
                        }

                        if root.editing-name: HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 38px;
                                horizontal-stretch: 1;
                                border-radius: 10px;
                                background: #1e2025;
                                border-width: 1px;
                                border-color: Theme.specular-rim;
                                TextInput {
                                    x: 10px; width: parent.width - 20px; height: 100%;
                                    text <=> root.rename-input;
                                    font-size: Theme.font-body;
                                    color: Theme.on-surface;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                width: 68px;
                                height: 38px;
                                border-radius: 10px;
                                background: Theme.primary;
                                Text {
                                    text: @tr("Save");
                                    font-size: Theme.font-caption;
                                    font-weight: 700;
                                    color: Theme.on-primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                TouchArea {
                                    clicked => {
                                        root.rename-adapter(root.rename-input);
                                        root.editing-name = false;
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.outline-variant; }

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: @tr("Bluetooth address");
                                font-size: Theme.font-body;
                                font-weight: 600;
                                color: Theme.on-surface;
                            }
                            Text {
                                text: root.bluetooth-mac;
                                font-size: Theme.font-caption;
                                color: Theme.on-surface-variant;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
}

