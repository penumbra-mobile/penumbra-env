import { Theme } from "../theme.slint";
import { Icon } from "../icon.slint";
import { SettingsTile } from "../components/settings_tile.slint";
import { SettingsSectionCard, SettingsSectionHeader } from "../components/settings_section.slint";

// ==============================================================================
// Component: VolumeSliderCard
// ==============================================================================
// Touch-scrubbing volume level controller for mobile audio output channels.
component VolumeSliderCard inherits Rectangle {
    // Channel descriptor label (e.g. "Media volume", "Call volume").
    in property <string> label: "Media volume";
    // Semantic icon rendered on the left badge (e.g. "sound").
    in property <string> icon: "sound";
    // Current normalized volume level (0.0 to 1.0).
    in-out property <float> value: 0.65;
    // Emitted continuously as the volume slider is scrubbed.
    callback changed(float);

    height: 72px;
    border-radius: Theme.radius-card;
    background: Theme.surface-low;
    clip: true;

    // Fill track
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * Math.clamp(root.value, 0.0, 1.0);
        height: parent.height;
        background: #ffb3ba.with-alpha(0.32);

        animate width { duration: 60ms; easing: ease-out; }
    }

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.value = Math.clamp(touch.mouse-x / root.width, 0.0, 1.0);
                root.changed(root.value);
            }
        }
        moved => {
            if (touch.pressed) {
                root.value = Math.clamp(touch.mouse-x / root.width, 0.0, 1.0);
                root.changed(root.value);
            }
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;

        // Visual Icon Badge (40px Circle)
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: #ffb3ba;
            y: (parent.height - self.height) / 2;

            Icon {
                name: root.icon;
                icon-size: 22px;
                icon-color: #551422;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.label;
                font-size: 16px;
                font-weight: 500;
                color: Theme.on-surface;
                horizontal-alignment: left;
            }

            Text {
                text: Math.round(root.value * 100.0) + "%";
                font-size: 13px;
                color: Theme.on-surface-variant;
                horizontal-alignment: left;
            }
        }
    }
}

// ==============================================================================
// Component: PageSound
// ==============================================================================
// Audio mixer, notification preferences, and haptic feedback subpage.
export component PageSound inherits Flickable {
    // Current normalized media playback volume (0.0 to 1.0).
    in-out property <float> media-volume: 0.65;
    // Current normalized voice call volume (0.0 to 1.0).
    in-out property <float> call-volume: 0.80;
    // Current normalized ringer and notification volume (0.0 to 1.0).
    in-out property <float> ring-volume: 0.70;
    // Current normalized microphone input volume (0.0 to 1.0).
    in-out property <float> mic-volume: 0.85;
    // Master mute state.
    in-out property <bool> output-muted: false;
    // Microphone mute state.
    in-out property <bool> mic-muted: false;
    // Active audio output device ("speaker", "headset", "hdmi").
    in-out property <string> output-device: "speaker";
    // Whether Do Not Disturb mode is actively suppressing notifications.
    in-out property <bool> dnd-enabled: false;
    // Whether haptic vibration is enabled for incoming voice calls.
    in-out property <bool> vibrate-for-calls: true;

    // Emitted when the media volume slider is scrubbed.
    callback media-volume-changed(float);
    // Emitted when the voice call volume slider is scrubbed.
    callback call-volume-changed(float);
    // Emitted when the ringer volume slider is scrubbed.
    callback ring-volume-changed(float);
    // Emitted when the microphone volume slider is scrubbed.
    callback mic-volume-changed(float);
    // Emitted when master output mute is toggled.
    callback toggle-output-muted(bool);
    // Emitted when mic mute is toggled.
    callback toggle-mic-muted(bool);
    // Emitted when audio output device is changed.
    callback output-device-changed(string);
    // Emitted when the user toggles Do Not Disturb mode.
    callback toggle-dnd(bool);
    // Emitted when the user toggles call vibration.
    callback toggle-vibrate-calls(bool);

    content := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 96px;
        spacing: 12px;

        // Audio Output Routing & Mute (Adapted from COSMIC Settings)
        VerticalLayout {
            spacing: 8px;
            SettingsSectionHeader { title: "Sound output & routing"; }
            SettingsSectionCard {
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 10px;

                    // Output device selection pills
                    HorizontalLayout {
                        spacing: 8px;

                        // Speaker
                        Rectangle {
                            property <bool> is-active: root.output-device == "speaker";
                            height: 48px;
                            horizontal-stretch: 1;
                            border-radius: 12px;
                            background: is-active ? Theme.primary : (spk-touch.pressed ? #282a30 : Theme.surface-high);
                            border-width: is-active ? 0px : 1px;
                            border-color: Theme.outline-variant;

                            animate background { duration: 120ms; easing: ease-out; }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Icon {
                                    name: "sound";
                                    icon-size: 16px;
                                    icon-color: is-active ? Theme.on-primary : Theme.on-surface;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "Speaker";
                                    font-size: 13px;
                                    font-weight: is-active ? 700 : 500;
                                    color: is-active ? Theme.on-primary : Theme.on-surface;
                                    vertical-alignment: center;
                                }
                            }

                            spk-touch := TouchArea {
                                clicked => {
                                    root.output-device = "speaker";
                                    root.output-device-changed("speaker");
                                }
                            }
                        }

                        // Headset
                        Rectangle {
                            property <bool> is-active: root.output-device == "headset";
                            height: 48px;
                            horizontal-stretch: 1;
                            border-radius: 12px;
                            background: is-active ? Theme.primary : (head-touch.pressed ? #282a30 : Theme.surface-high);
                            border-width: is-active ? 0px : 1px;
                            border-color: Theme.outline-variant;

                            animate background { duration: 120ms; easing: ease-out; }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Icon {
                                    name: "devices";
                                    icon-size: 16px;
                                    icon-color: is-active ? Theme.on-primary : Theme.on-surface;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "Headset";
                                    font-size: 13px;
                                    font-weight: is-active ? 700 : 500;
                                    color: is-active ? Theme.on-primary : Theme.on-surface;
                                    vertical-alignment: center;
                                }
                            }

                            head-touch := TouchArea {
                                clicked => {
                                    root.output-device = "headset";
                                    root.output-device-changed("headset");
                                }
                            }
                        }

                        // HDMI / External
                        Rectangle {
                            property <bool> is-active: root.output-device == "hdmi";
                            height: 48px;
                            horizontal-stretch: 1;
                            border-radius: 12px;
                            background: is-active ? Theme.primary : (hdmi-touch.pressed ? #282a30 : Theme.surface-high);
                            border-width: is-active ? 0px : 1px;
                            border-color: Theme.outline-variant;

                            animate background { duration: 120ms; easing: ease-out; }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Icon {
                                    name: "display";
                                    icon-size: 16px;
                                    icon-color: is-active ? Theme.on-primary : Theme.on-surface;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "HDMI / TV";
                                    font-size: 13px;
                                    font-weight: is-active ? 700 : 500;
                                    color: is-active ? Theme.on-primary : Theme.on-surface;
                                    vertical-alignment: center;
                                }
                            }

                            hdmi-touch := TouchArea {
                                clicked => {
                                    root.output-device = "hdmi";
                                    root.output-device-changed("hdmi");
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.outline-variant;
                    }

                    // Master Mute Switch
                    SettingsTile {
                        icon-name: "sound";
                        icon-bg: root.output-muted ? #ffb4a9 : #a8c7fa;
                        icon-tint: root.output-muted ? #680003 : #042b59;
                        title: "Mute output";
                        subtitle: root.output-muted ? "Audio muted" : "Playing audio normally";
                        is-switch: true;
                        switch-checked: root.output-muted;
                        show-divider: false;
                        is-first: false;
                        is-last: true;
                        toggled(v) => {
                            root.output-muted = v;
                            root.toggle-output-muted(v);
                        }
                    }
                }
            }
        }

        // Volume Sliders
        VerticalLayout {
            spacing: 8px;
            SettingsSectionHeader { title: "Volume channels"; }
            VerticalLayout {
                spacing: 8px;
                VolumeSliderCard {
                    label: "Media volume";
                    icon: "sound";
                    value <=> root.media-volume;
                    changed(v) => { root.media-volume-changed(v); }
                }
                VolumeSliderCard {
                    label: "Call volume";
                    icon: "sound";
                    value <=> root.call-volume;
                    changed(v) => { root.call-volume-changed(v); }
                }
                VolumeSliderCard {
                    label: "Ring & notifications";
                    icon: "sound";
                    value <=> root.ring-volume;
                    changed(v) => { root.ring-volume-changed(v); }
                }
                VolumeSliderCard {
                    label: "Microphone input";
                    icon: "notifications";
                    value <=> root.mic-volume;
                    changed(v) => { root.mic-volume-changed(v); }
                }
            }
        }

        // Do Not Disturb & Vibration
        VerticalLayout {
            spacing: 8px;
            SettingsSectionHeader { title: "Modes & feedback"; }
            SettingsSectionCard {
                VerticalLayout {
                    padding-top: 4px;
                    padding-bottom: 4px;

                    SettingsTile {
                        icon-name: "dnd";
                        icon-bg: #e8b4cb;
                        icon-tint: #3b1424;
                        title: "Do Not Disturb";
                        subtitle: root.dnd-enabled ? "On" : "Off";
                        is-switch: true;
                        switch-checked: root.dnd-enabled;
                        is-first: true;
                        is-last: false;
                        show-divider: true;
                        toggled(v) => { root.toggle-dnd(v); }
                    }
                    SettingsTile {
                        icon-name: "sound";
                        icon-bg: #ffcc80;
                        icon-tint: #4e2600;
                        title: "Vibrate for calls";
                        subtitle: root.vibrate-for-calls ? "Always vibrate" : "Never vibrate";
                        is-switch: true;
                        switch-checked: root.vibrate-for-calls;
                        is-first: false;
                        is-last: true;
                        show-divider: false;
                        toggled(v) => { root.toggle-vibrate-calls(v); }
                    }
                }
            }
        }
    }
}
