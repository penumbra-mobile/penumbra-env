import { Theme } from "../theme.slint";
import { Icon } from "../icon.slint";
import { SettingsTile } from "../components/settings_tile.slint";
import { SettingsSectionCard } from "../components/settings_section.slint";

// ==============================================================================
// Component: PageAbout
// ==============================================================================
// Hardware and software specifications subpage presenting genuine system telemetry.
// Strictly adheres to Android 17 Material You layout and left-aligned geometry.
export component PageAbout inherits Flickable {
    // Machine host or model identifier (e.g. "Lenovo Legion Y740").
    in property <string> device-name: "Linux Device";
    // Detailed hardware model (e.g. "Lenovo Legion Y740-17IRHg").
    in property <string> device-model: "Standard Hardware";
    // Operating system distribution release (e.g. "Arch Linux").
    in property <string> os-version: "Linux OS";
    // Kernel version string and architecture (e.g. "Linux 7.2.9-arch1-1 (x86_64)").
    in property <string> kernel-version: "Linux";
    // Processor description (e.g. "Intel Core i7-9750H @ 2.60GHz").
    in property <string> cpu-model: "Processor";
    // Total physical RAM installed (e.g. "15.5 GB RAM").
    in property <string> memory-info: "System RAM";
    // Storage capacity and available free space (e.g. "922 GB (160 GB free)").
    in property <string> storage-info: "Internal Storage";
    // System uptime elapsed since last boot (e.g. "3h 12m").
    in property <string> uptime-info: "Active";
    // Running Wayland compositor session description.
    in property <string> compositor-info: "Penumbra Shell (Smithay Wayland)";
    // Active POSIX/gettext language code ("en", "ro", "de", "fr", "es", "it").
    in-out property <string> current-language: "en";
    callback language-changed(string);

    Flickable {
        width: 100%;
        height: 100%;

        content := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 96px;
            spacing: 12px;

        // Device Hero Card
        Rectangle {
            height: 84px;
            border-radius: Theme.radius-card;
            background: Theme.surface-low;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 16px;

                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 22px;
                    background: #d0bcff;
                    y: (parent.height - self.height) / 2;

                    Icon {
                        name: "devices";
                        icon-size: 22px;
                        icon-color: #381e72;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.device-name;
                        font-size: 18px;
                        font-weight: 500;
                        color: Theme.on-surface;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    Text {
                        text: root.device-model;
                        font-size: 13px;
                        color: Theme.on-surface-variant;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }
            }
        }

        // Hardware Specifications Card Group
        SettingsSectionCard {
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;

                SettingsTile {
                    icon-name: "settings";
                    icon-bg: #7dd8fc;
                    icon-tint: #00354e;
                    title: @tr("Processor");
                    subtitle: root.cpu-model;
                    show-chevron: false;
                    is-first: true;
                    is-last: false;
                    show-divider: true;
                }

                SettingsTile {
                    icon-name: "devices";
                    icon-bg: #a8c7fa;
                    icon-tint: #042b59;
                    title: @tr("Memory");
                    subtitle: root.memory-info;
                    show-chevron: false;
                    is-first: false;
                    is-last: false;
                    show-divider: true;
                }

                SettingsTile {
                    icon-name: "storage";
                    icon-bg: #f9d868;
                    icon-tint: #3b2e00;
                    title: @tr("Internal storage");
                    subtitle: root.storage-info;
                    show-chevron: false;
                    is-first: false;
                    is-last: true;
                    show-divider: false;
                }
            }
        }

        // Software Specifications Card Group
        SettingsSectionCard {
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;

                SettingsTile {
                    icon-name: "info";
                    icon-bg: #d0bcff;
                    icon-tint: #381e72;
                    title: @tr("OS Version");
                    subtitle: root.os-version;
                    show-chevron: false;
                    is-first: true;
                    is-last: false;
                    show-divider: true;
                }

                SettingsTile {
                    icon-name: "power";
                    icon-bg: #a3e8b0;
                    icon-tint: #073919;
                    title: @tr("Linux kernel");
                    subtitle: root.kernel-version;
                    show-chevron: false;
                    is-first: false;
                    is-last: false;
                    show-divider: true;
                }

                SettingsTile {
                    icon-name: "brightness";
                    icon-bg: #ffcc80;
                    icon-tint: #4e2600;
                    title: @tr("Compositor & Shell");
                    subtitle: root.compositor-info;
                    show-chevron: false;
                    is-first: false;
                    is-last: false;
                    show-divider: true;
                }

                SettingsTile {
                    icon-name: "refresh";
                    icon-bg: #ffb3ba;
                    icon-tint: #491019;
                    title: @tr("System uptime");
                    subtitle: root.uptime-info;
                    show-chevron: false;
                    is-first: false;
                    is-last: true;
                    show-divider: false;
                }
            }

            // System Language & Locale Selector (GNU gettext / locale.conf)
            SettingsSectionCard {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    Text {
                        text: @tr("System language");
                        font-size: Theme.font-body;
                        font-weight: 700;
                        color: Theme.on-surface;
                    }

                    Text {
                        text: @tr("Applies to Penumbra Shell, Settings, and Linux apps (falls back to English when untranslated).");
                        font-size: Theme.font-caption;
                        color: Theme.on-surface-variant;
                        wrap: word-wrap;
                    }

                    VerticalLayout {
                        spacing: 6px;
                        for lang in [
                            { code: "en", label: @tr("English (Default)") },
                            { code: "ro", label: @tr("Română (Romanian)") },
                            { code: "de", label: @tr("Deutsch (German)") },
                            { code: "fr", label: @tr("Français (French)") },
                            { code: "es", label: @tr("Español (Spanish)") },
                            { code: "it", label: @tr("Italiano (Italian)") },
                        ]: Rectangle {
                            height: 40px;
                            border-radius: 14px;
                            background: root.current-language == lang.code ? Theme.primary-container : Theme.surface-low;
                            border-width: root.current-language == lang.code ? 1.5px : 1px;
                            border-color: root.current-language == lang.code ? Theme.primary : #ffffff14;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: lang.label;
                                    font-size: 13px;
                                    font-weight: root.current-language == lang.code ? 700 : 500;
                                    color: root.current-language == lang.code ? Theme.on-primary-container : Theme.on-surface;
                                    vertical-alignment: center;
                                }
                                if root.current-language == lang.code: Text {
                                    text: "✓";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => {
                                    root.current-language = lang.code;
                                    root.language-changed(lang.code);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
}
