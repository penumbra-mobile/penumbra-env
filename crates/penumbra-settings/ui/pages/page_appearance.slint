import { Theme } from "../theme.slint";
import { Icon } from "../icon.slint";
import { SettingsTile } from "../components/settings_tile.slint";
import { SettingsSectionCard, SettingsSectionHeader } from "../components/settings_section.slint";

component AccentSwatch inherits Rectangle {
    in property <string> color-id;
    in property <color> swatch-color;
    in property <color> check-tint;
    in property <bool> selected: false;
    callback clicked();

    width: 48px;
    height: 48px;
    background: transparent;

    Rectangle {
        x: touch.pressed ? 2px : 0px;
        y: touch.pressed ? 2px : 0px;
        width: parent.width - (touch.pressed ? 4px : 0px);
        height: parent.height - (touch.pressed ? 4px : 0px);
        border-radius: touch.pressed ? 16px : (root.selected ? 18px : 24px);
        background: root.swatch-color;
        border-width: root.selected ? 3px : 1px;
        border-color: root.selected ? Theme.on-surface : #ffffff22;

        animate x, y, width, height, border-radius {
            duration: 140ms;
            easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
        }

        if root.selected: Icon {
            name: "check";
            icon-size: 20px;
            icon-color: root.check-tint;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        touch := TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

export struct WallpaperEntry {
    path: string,
    name: string,
    folder: string,
    thumbnail: image,
    has-thumbnail: bool,
}

component ShapeOptionChip inherits Rectangle {
    in property <string> label;
    in property <length> preview-radius: 10px;
    in property <bool> is-pill: false;
    in property <bool> is-path: false;
    in property <string> path-commands: "";
    in property <bool> selected: false;
    in property <color> accent;
    in property <color> on-accent;
    callback clicked();

    height: 68px;
    horizontal-stretch: 1;
    border-radius: 18px;
    background: root.selected ? Theme.surface-container-high : Theme.surface-low;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? root.accent : #ffffff18;

    animate background, border-color { duration: 150ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 6px;

        Rectangle {
            width: 30px;
            height: 30px;
            x: (parent.width - self.width) / 2;
            background: transparent;

            if !root.is-path: Rectangle {
                width: 28px;
                height: root.is-pill ? 22px : 28px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: root.preview-radius;
                background: root.selected ? root.accent : Theme.surface-highest;

                if root.selected: Icon {
                    name: "palette";
                    icon-size: 13px;
                    icon-color: root.on-accent;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            if root.is-path: Path {
                width: 28px;
                height: 28px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 100;
                viewbox-height: 100;
                commands: root.path-commands;
                fill: root.selected ? root.accent : Theme.surface-highest;
            }

            if root.is-path && root.selected: Icon {
                name: "palette";
                icon-size: 13px;
                icon-color: root.on-accent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? root.accent : Theme.on-surface-variant;
            horizontal-alignment: center;
        }
    }
}

// ==============================================================================
// Component: PageAppearance (Wallpaper & style)
// ==============================================================================
export component PageAppearance inherits Rectangle {
    in-out property <string> accent-color: "blue"; // "blue", "lavender", "mint", "rose", "amber"
    in-out property <bool> dark-theme: true;
    in-out property <bool> dynamic-monet: true;
    in-out property <bool> themed-icons: false;
    in-out property <string> icon-shape: "squircle"; // "squircle", "circle", "rounded", "pill", "clover", "flower", "arch", "diamond"

    in property <[WallpaperEntry]> wallpaper-list: [];
    in property <[string]> wallpaper-folders: [];
    in-out property <string> current-wallpaper-path: "";
    in-out property <bool> show-add-folder-dialog: false;
    in-out property <string> folder-input-path: "";

    callback accent-color-changed(string);
    callback toggle-dark-theme(bool);
    callback toggle-dynamic-monet(bool);
    callback toggle-themed-icons(bool);
    callback icon-shape-changed(string);
    callback select-wallpaper(string);
    callback clear-wallpaper();
    callback add-wallpaper-folder(string);
    callback remove-wallpaper-folder(string);
    callback rescan-wallpapers();

    property <color> preview-accent:
        root.accent-color == "lavender" ? #d0bcff :
        root.accent-color == "mint" ? #a3e8b0 :
        root.accent-color == "rose" ? #ffb3ba :
        root.accent-color == "amber" ? #ffcc80 :
        #7dd8fc;

    property <color> preview-on-accent:
        root.accent-color == "lavender" ? #381e72 :
        root.accent-color == "mint" ? #073919 :
        root.accent-color == "rose" ? #491019 :
        root.accent-color == "amber" ? #4e2600 :
        #00354e;

    property <bool> preview-is-path:
        root.icon-shape == "clover" || root.icon-shape == "flower" || root.icon-shape == "arch" || root.icon-shape == "diamond";

    property <length> preview-icon-radius:
        root.icon-shape == "circle" ? 18px :
        root.icon-shape == "pill" ? 14px :
        root.icon-shape == "rounded" ? 8px :
        12px;

    property <string> preview-icon-path:
        root.icon-shape == "clover" ? "M 50 6 C 72 6 86 18 86 36 C 96 44 96 56 86 64 C 86 82 72 94 50 94 C 28 94 14 82 14 64 C 4 56 4 44 14 36 C 14 18 28 6 50 6 Z" :
        root.icon-shape == "flower" ? "M 50 4 C 58 4 64 10 68 14 C 74 12 84 16 86 24 C 92 28 96 36 92 44 C 96 50 96 58 92 64 C 96 72 90 82 82 84 C 78 92 70 96 62 92 C 56 96 44 96 38 92 C 30 96 22 92 18 84 C 10 82 4 72 8 64 C 4 58 4 50 8 44 C 4 36 8 28 14 24 C 16 16 26 12 32 14 C 36 10 42 4 50 4 Z" :
        root.icon-shape == "arch" ? "M 50 6 C 76 6 94 24 94 50 L 94 82 C 94 90 88 94 80 94 L 20 94 C 12 94 6 90 6 82 L 6 50 C 6 24 24 6 50 6 Z" :
        "M 50 4 C 56 4 62 8 68 14 L 86 32 C 92 38 96 44 96 50 C 96 56 92 62 86 68 L 68 86 C 62 92 56 96 50 96 C 44 96 38 92 32 86 L 14 68 C 8 62 4 56 4 50 C 4 44 8 38 14 32 L 32 14 C 38 8 44 4 50 4 Z";

    background: Theme.base-surface;

    Flickable {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 48px;
            spacing: 20px;

            // 1. Live Material 3 Expressive Preview Card
            SettingsSectionCard {
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Mini Phone Preview Frame
                    Rectangle {
                        height: 184px;
                        border-radius: 24px;
                        background: root.dark-theme ? #0d0c12 : #f4f3f8;
                        border-width: 1px;
                        border-color: #ffffff20;
                        clip: true;

                        animate background { duration: 220ms; }

                        // Subtle Monet radial-like wash
                        Rectangle {
                            x: -20px;
                            y: -30px;
                            width: 180px;
                            height: 180px;
                            border-radius: 90px;
                            background: root.preview-accent;
                            opacity: 0.14;
                        }

                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;
                            alignment: space-between;

                            // Mini Clock & QS Pastille Row
                            HorizontalLayout {
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "10:10";
                                        font-size: 28px;
                                        font-weight: 700;
                                        color: root.dark-theme ? #ffffff : #1a1b20;
                                    }
                                    Text {
                                        text: root.dynamic-monet ? "Dynamic Monet" : "Custom palette";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: root.preview-accent;
                                    }
                                }

                                // Mini Active QS Pill
                                Rectangle {
                                    width: 108px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: root.preview-accent;
                                    y: 4px;

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 6px;
                                        alignment: center;
                                        Icon {
                                            name: "wifi";
                                            icon-size: 14px;
                                            icon-color: root.preview-on-accent;
                                        }
                                        Text {
                                            text: "Wi-Fi";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: root.preview-on-accent;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Mini App Icon Dock Row
                            Rectangle {
                                height: 52px;
                                border-radius: 26px;
                                background: root.dark-theme ? #23202be0 : #e2e0eb;
                                border-width: 1px;
                                border-color: #ffffff18;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    alignment: space-around;

                                    for ic in ["wifi", "sound", "palette", "settings"]: Rectangle {
                                        width: 36px;
                                        height: root.icon-shape == "pill" ? 28px : 36px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: root.preview-icon-radius;
                                        background: root.preview-is-path ? transparent : (root.themed-icons ? root.preview-accent : (root.dark-theme ? #36343b : #ffffff));

                                        animate border-radius, background { duration: 180ms; }

                                        if root.preview-is-path: Path {
                                            width: 100%;
                                            height: 100%;
                                            viewbox-width: 100;
                                            viewbox-height: 100;
                                            commands: root.preview-icon-path;
                                            fill: root.themed-icons ? root.preview-accent : (root.dark-theme ? #36343b : #ffffff);
                                        }

                                        Icon {
                                            name: ic;
                                            icon-size: 18px;
                                            icon-color: root.themed-icons ? root.preview-on-accent : (root.dark-theme ? #e3e2e6 : #1a1b20);
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 2. Monet Color Palette
            VerticalLayout {
                spacing: 8px;
                SettingsSectionHeader { title: "Colors"; }
                SettingsSectionCard {
                    VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 14px;
                        spacing: 12px;

                        SettingsTile {
                            title: "Dynamic Monet";
                            subtitle: "Extract Material 3 Expressive tones from wallpaper";
                            is-switch: true;
                            switch-checked <=> root.dynamic-monet;
                            is-first: true;
                            is-last: false;
                            show-divider: true;
                            toggled(val) => { root.toggle-dynamic-monet(val); }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            alignment: space-around;

                            AccentSwatch {
                                color-id: "blue";
                                swatch-color: #7dd8fc;
                                check-tint: #00354e;
                                selected: root.accent-color == "blue";
                                clicked => {
                                    root.accent-color = "blue";
                                    root.accent-color-changed("blue");
                                }
                            }
                            AccentSwatch {
                                color-id: "lavender";
                                swatch-color: #d0bcff;
                                check-tint: #381e72;
                                selected: root.accent-color == "lavender";
                                clicked => {
                                    root.accent-color = "lavender";
                                    root.accent-color-changed("lavender");
                                }
                            }
                            AccentSwatch {
                                color-id: "mint";
                                swatch-color: #a3e8b0;
                                check-tint: #073919;
                                selected: root.accent-color == "mint";
                                clicked => {
                                    root.accent-color = "mint";
                                    root.accent-color-changed("mint");
                                }
                            }
                            AccentSwatch {
                                color-id: "rose";
                                swatch-color: #ffb3ba;
                                check-tint: #491019;
                                selected: root.accent-color == "rose";
                                clicked => {
                                    root.accent-color = "rose";
                                    root.accent-color-changed("rose");
                                }
                            }
                            AccentSwatch {
                                color-id: "amber";
                                swatch-color: #ffcc80;
                                check-tint: #4e2600;
                                selected: root.accent-color == "amber";
                                clicked => {
                                    root.accent-color = "amber";
                                    root.accent-color-changed("amber");
                                }
                            }
                        }
                    }
                }
            }

            // 3. Theme & Icons
            VerticalLayout {
                spacing: 8px;
                SettingsSectionHeader { title: "Theme & icons"; }
                SettingsSectionCard {
                    VerticalLayout {
                        padding-top: 4px;
                        padding-bottom: 4px;

                        SettingsTile {
                            title: "Dark theme";
                            subtitle: "OLED pitch-black surfaces and tinted containers";
                            is-switch: true;
                            switch-checked <=> root.dark-theme;
                            is-first: true;
                            is-last: false;
                            show-divider: true;
                            toggled(val) => { root.toggle-dark-theme(val); }
                        }

                        SettingsTile {
                            title: "Themed icons";
                            subtitle: "Apply Monet accent colors to supported app icons";
                            is-switch: true;
                            switch-checked <=> root.themed-icons;
                            is-first: false;
                            is-last: true;
                            show-divider: false;
                            toggled(val) => { root.toggle-themed-icons(val); }
                        }
                    }
                }
            }

            // 4. App Icon Shape (All Material 3 Expressive Shapes)
            VerticalLayout {
                spacing: 8px;
                SettingsSectionHeader { title: "Icon shape (Material 3 Expressive)"; }
                SettingsSectionCard {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 8px;

                            ShapeOptionChip {
                                label: "Squircle";
                                preview-radius: 9px;
                                selected: root.icon-shape == "squircle";
                                accent: root.preview-accent;
                                on-accent: root.preview-on-accent;
                                clicked => {
                                    root.icon-shape = "squircle";
                                    root.icon-shape-changed("squircle");
                                }
                            }
                            ShapeOptionChip {
                                label: "Circle";
                                preview-radius: 14px;
                                selected: root.icon-shape == "circle";
                                accent: root.preview-accent;
                                on-accent: root.preview-on-accent;
                                clicked => {
                                    root.icon-shape = "circle";
                                    root.icon-shape-changed("circle");
                                }
                            }
                            ShapeOptionChip {
                                label: "Rounded";
                                preview-radius: 6px;
                                selected: root.icon-shape == "rounded";
                                accent: root.preview-accent;
                                on-accent: root.preview-on-accent;
                                clicked => {
                                    root.icon-shape = "rounded";
                                    root.icon-shape-changed("rounded");
                                }
                            }
                            ShapeOptionChip {
                                label: "Pill";
                                preview-radius: 11px;
                                is-pill: true;
                                selected: root.icon-shape == "pill";
                                accent: root.preview-accent;
                                on-accent: root.preview-on-accent;
                                clicked => {
                                    root.icon-shape = "pill";
                                    root.icon-shape-changed("pill");
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            ShapeOptionChip {
                                label: "Clover";
                                is-path: true;
                                path-commands: "M 50 6 C 72 6 86 18 86 36 C 96 44 96 56 86 64 C 86 82 72 94 50 94 C 28 94 14 82 14 64 C 4 56 4 44 14 36 C 14 18 28 6 50 6 Z";
                                selected: root.icon-shape == "clover";
                                accent: root.preview-accent;
                                on-accent: root.preview-on-accent;
                                clicked => {
                                    root.icon-shape = "clover";
                                    root.icon-shape-changed("clover");
                                }
                            }
                            ShapeOptionChip {
                                label: "Flower";
                                is-path: true;
                                path-commands: "M 50 4 C 58 4 64 10 68 14 C 74 12 84 16 86 24 C 92 28 96 36 92 44 C 96 50 96 58 92 64 C 96 72 90 82 82 84 C 78 92 70 96 62 92 C 56 96 44 96 38 92 C 30 96 22 92 18 84 C 10 82 4 72 8 64 C 4 58 4 50 8 44 C 4 36 8 28 14 24 C 16 16 26 12 32 14 C 36 10 42 4 50 4 Z";
                                selected: root.icon-shape == "flower";
                                accent: root.preview-accent;
                                on-accent: root.preview-on-accent;
                                clicked => {
                                    root.icon-shape = "flower";
                                    root.icon-shape-changed("flower");
                                }
                            }
                            ShapeOptionChip {
                                label: "Arch";
                                is-path: true;
                                path-commands: "M 50 6 C 76 6 94 24 94 50 L 94 82 C 94 90 88 94 80 94 L 20 94 C 12 94 6 90 6 82 L 6 50 C 6 24 24 6 50 6 Z";
                                selected: root.icon-shape == "arch";
                                accent: root.preview-accent;
                                on-accent: root.preview-on-accent;
                                clicked => {
                                    root.icon-shape = "arch";
                                    root.icon-shape-changed("arch");
                                }
                            }
                            ShapeOptionChip {
                                label: "Diamond";
                                is-path: true;
                                path-commands: "M 50 4 C 56 4 62 8 68 14 L 86 32 C 92 38 96 44 96 50 C 96 56 92 62 86 68 L 68 86 C 62 92 56 96 50 96 C 44 96 38 92 32 86 L 14 68 C 8 62 4 56 4 50 C 4 44 8 38 14 32 L 32 14 C 38 8 44 4 50 4 Z";
                                selected: root.icon-shape == "diamond";
                                accent: root.preview-accent;
                                on-accent: root.preview-on-accent;
                                clicked => {
                                    root.icon-shape = "diamond";
                                    root.icon-shape-changed("diamond");
                                }
                            }
                        }
                    }
                }
            }

            // 5. GNOME-Compatible Multi-Folder Wallpaper Chooser
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    alignment: space-between;
                    SettingsSectionHeader { title: "Wallpaper"; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 28px;
                            border-radius: 14px;
                            background: Theme.surface-container-high;
                            border-width: 1px;
                            border-color: Theme.specular-rim;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: "Rescan";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.primary;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.rescan-wallpapers(); } }
                        }
                        if root.current-wallpaper-path != "": Rectangle {
                            height: 28px;
                            border-radius: 14px;
                            background: #5c2020;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: "Clear";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #ffb4ab;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.clear-wallpaper(); } }
                        }
                    }
                }

                SettingsSectionCard {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 12px;

                        // Search Folders (GNOME & Custom Multi-Folder)
                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "Search folders (" + root.wallpaper-folders.length + ")";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.on-surface-variant;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                height: 28px;
                                border-radius: 14px;
                                background: root.preview-accent;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: "+ Add folder";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: root.preview-on-accent;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.folder-input-path = "~/.local/share/backgrounds";
                                        root.show-add-folder-dialog = true;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 6px;
                            for folder in root.wallpaper-folders: Rectangle {
                                height: 34px;
                                border-radius: 12px;
                                background: Theme.surface-low;
                                border-width: 1px;
                                border-color: #ffffff14;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Text {
                                        text: folder;
                                        font-size: 11px;
                                        color: Theme.on-surface;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Rectangle {
                                        width: 24px;
                                        height: 24px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 12px;
                                        background: Theme.surface-highest;
                                        Text {
                                            text: "×";
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: Theme.on-surface-variant;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea {
                                            clicked => { root.remove-wallpaper-folder(folder); }
                                        }
                                    }
                                }
                            }
                        }

                        if root.wallpaper-list.length == 0: Rectangle {
                            height: 64px;
                            border-radius: 16px;
                            background: Theme.surface-low;
                            Text {
                                text: "No wallpapers found in configured folders.\nAdd /usr/share/backgrounds or ~/Pictures.";
                                font-size: 12px;
                                color: Theme.on-surface-variant;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // 3-Column Wallpaper Thumbnail Grid
                        if root.wallpaper-list.length > 0: VerticalLayout {
                            spacing: 8px;
                            property <int> num-rows: Math.ceil(root.wallpaper-list.length / 3);
                            for row_idx in self.num-rows: HorizontalLayout {
                                spacing: 8px;
                                for col_idx in 3: wp-cell := Rectangle {
                                    property <int> item-idx: row_idx * 3 + col_idx;
                                    horizontal-stretch: 1;
                                    height: 116px;
                                    border-radius: 16px;
                                    clip: true;
                                    background: wp-cell.item-idx < root.wallpaper-list.length ? Theme.surface-low : transparent;
                                    border-width: (wp-cell.item-idx < root.wallpaper-list.length && root.wallpaper-list[wp-cell.item-idx].path == root.current-wallpaper-path) ? 2.5px : (wp-cell.item-idx < root.wallpaper-list.length ? 1px : 0px);
                                    border-color: (wp-cell.item-idx < root.wallpaper-list.length && root.wallpaper-list[wp-cell.item-idx].path == root.current-wallpaper-path) ? root.preview-accent : #ffffff18;

                                    if wp-cell.item-idx < root.wallpaper-list.length && root.wallpaper-list[wp-cell.item-idx].has-thumbnail: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: root.wallpaper-list[wp-cell.item-idx].thumbnail;
                                        image-fit: cover;
                                    }

                                    if wp-cell.item-idx < root.wallpaper-list.length: Rectangle {
                                        y: parent.height - 24px;
                                        width: 100%;
                                        height: 24px;
                                        background: #0b0a0ecc;
                                        Text {
                                            x: 6px;
                                            width: parent.width - 12px;
                                            height: 100%;
                                            text: root.wallpaper-list[wp-cell.item-idx].name;
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: #ffffff;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if wp-cell.item-idx < root.wallpaper-list.length && root.wallpaper-list[wp-cell.item-idx].path == root.current-wallpaper-path: Rectangle {
                                        x: parent.width - 24px;
                                        y: 6px;
                                        width: 18px;
                                        height: 18px;
                                        border-radius: 9px;
                                        background: root.preview-accent;
                                        Text {
                                            text: "✓";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: root.preview-on-accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if wp-cell.item-idx < root.wallpaper-list.length: TouchArea {
                                        clicked => {
                                            root.current-wallpaper-path = root.wallpaper-list[wp-cell.item-idx].path;
                                            root.select-wallpaper(root.wallpaper-list[wp-cell.item-idx].path);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Add Wallpaper Folder Modal Dialog
    if root.show-add-folder-dialog: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000aa;

        TouchArea {}

        Rectangle {
            width: Math.min(360px, parent.width - 32px);
            height: 280px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 28px;
            background: Theme.surface-container-high;
            border-width: 1px;
            border-color: Theme.specular-rim;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                Text {
                    text: "Add wallpaper folder";
                    font-size: Theme.font-title;
                    font-weight: 700;
                    color: Theme.on-surface;
                }

                Rectangle {
                    height: 44px;
                    border-radius: 14px;
                    background: Theme.surface-low;
                    border-width: 1px;
                    border-color: Theme.primary;
                    TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: 100%;
                        text <=> root.folder-input-path;
                        color: Theme.on-surface;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                // Quick GNOME / User Preset Folder Chips
                HorizontalLayout {
                    spacing: 6px;
                    for preset in ["/usr/share/backgrounds", "~/.local/share/backgrounds", "~/Pictures"]: Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: 13px;
                        background: Theme.surface-highest;
                        Text {
                            text: preset == "/usr/share/backgrounds" ? "GNOME Sys" : (preset == "~/.local/share/backgrounds" ? "GNOME User" : "Pictures");
                            font-size: 10px;
                            font-weight: 600;
                            color: Theme.on-surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.folder-input-path = preset; } }
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        height: 38px;
                        horizontal-stretch: 1;
                        border-radius: 19px;
                        background: Theme.surface-highest;
                        Text {
                            text: "Cancel";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.on-surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea { clicked => { root.show-add-folder-dialog = false; } }
                    }
                    Rectangle {
                        height: 38px;
                        horizontal-stretch: 1;
                        border-radius: 19px;
                        background: root.preview-accent;
                        Text {
                            text: "Add folder";
                            font-size: 13px;
                            font-weight: 700;
                            color: root.preview-on-accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                if (root.folder-input-path != "") {
                                    root.add-wallpaper-folder(root.folder-input-path);
                                }
                                root.show-add-folder-dialog = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
