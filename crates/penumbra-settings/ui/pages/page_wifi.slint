import { Theme } from "../theme.slint";
import { Icon } from "../icon.slint";
import { SettingsTile, M3Switch } from "../components/settings_tile.slint";
import { SettingsSectionCard, SettingsSectionHeader } from "../components/settings_section.slint";

// ==============================================================================
// Data Structure: WifiApData
// ==============================================================================
// Represents a single scanned wireless access point discovered via NetworkManager.
export struct WifiApData {
    // Human-readable broadcast SSID of the access point.
    ssid: string,
    // Normalized wireless signal percentage (0 to 100%).
    signal: int,
    // Security capabilities string (e.g. "WPA3", "WPA2", "Open").
    security: string,
    // Whether this access point corresponds to the currently active connection.
    connected: bool,
    // Whether a saved NetworkManager connection profile exists for this SSID.
    saved: bool,
}

// ==============================================================================
// Component: PageWifi
// ==============================================================================
// Wi-Fi network configuration subpage adhering strictly to Android 17 design.
export component PageWifi inherits Rectangle {
    // Current wireless adapter power state.
    in-out property <bool> wifi-enabled: true;
    // SSID of the active wireless connection, or empty string if disconnected.
    in property <string> connected-ssid: "";
    // Signal percentage of the currently active connection (0 to 100).
    in property <int> signal-strength: 0;
    // Real Wi-Fi hardware MAC address and interface (e.g. "5c:87:9c:27:10:a0 (wlan0)").
    in property <string> wifi-mac: "Hardware MAC";
    // Active IPv4 address on Wi-Fi interface.
    in property <string> ip-address: "";
    // Wi-Fi Hotspot / Tethering state.
    in-out property <bool> hotspot-active: false;
    in-out property <string> hotspot-ssid-input: "Penumbra-Hotspot";
    in-out property <string> hotspot-pass-input: "penumbra123";
    // Array of available scanned access points from NetworkManager.
    in property <[WifiApData]> access-points: [];
    // All saved Wi-Fi network SSIDs (including out-of-range profiles).
    in property <[string]> saved-networks: [];

    // Connection Details modal state
    in-out property <bool> show-details-dialog: false;
    in-out property <string> details-ssid: "";
    in-out property <bool> details-is-connected: false;

    // Emitted when the user toggles the master Wi-Fi power switch.
    callback toggle-wifi(bool);
    // Emitted when the user disconnects the active Wi-Fi network.
    callback disconnect-wifi();
    // Emitted when the user forgets a saved Wi-Fi profile.
    callback forget-network(string);
    // Emitted when the user starts or stops Wi-Fi Hotspot tethering.
    callback start-hotspot(string, string);
    callback stop-hotspot();
    // Emitted when the user selects an open access point to initiate a connection.
    callback connect-ap(string);
    // Emitted when the user connects to a secured access point with a password.
    callback connect-ap-with-password(string, string);
    // Emitted when the user requests an immediate wireless beacon rescan.
    callback scan-requested();
    // Signals to activate the on-screen virtual keyboard.
    callback password-input-focused();
    // Signals to dismiss the on-screen virtual keyboard.
    callback password-input-dismissed();

    // Dialog state for WPA/WPA2 authentication
    in-out property <bool> show-password-dialog: false;
    in-out property <string> selected-ap-ssid: "";
    in-out property <string> selected-ap-security: "";
    in-out property <string> entered-password: "";
    in-out property <bool> show-password-text: false;

    background: Theme.base-surface;

    Flickable {
        width: 100%;
        height: 100%;

        content := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 96px;
            spacing: 12px;

            // Master Switch Card
            SettingsSectionCard {
                SettingsTile {
                    icon-name: "wifi";
                    icon-bg: root.wifi-enabled ? #7dd8fc : #36343b;
                    icon-tint: root.wifi-enabled ? #00354e : #938f99;
                    title: "Use Wi-Fi";
                    subtitle: root.wifi-enabled ? "On" : "Off";
                    is-switch: true;
                    switch-checked: root.wifi-enabled;
                    show-divider: false;
                    is-first: true;
                    is-last: true;
                    toggled(val) => { root.toggle-wifi(val); }
                }
            }

            if root.wifi-enabled: VerticalLayout {
                spacing: 12px;

                // Connected Network Card (with IPv4, Disconnect & Forget)
                if root.connected-ssid != "": VerticalLayout {
                    spacing: 8px;
                    SettingsSectionHeader { title: "Connected network"; }
                    SettingsSectionCard {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: root.connected-ssid;
                                        font-size: Theme.font-body;
                                        font-weight: 700;
                                        color: Theme.on-surface;
                                    }
                                    Text {
                                        text: "Connected • " + root.signal-strength + "%"
                                            + (root.ip-address != "" ? " • IP " + root.ip-address : "");
                                        font-size: Theme.font-caption;
                                        color: Theme.primary;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: 16px;
                                    background: Theme.primary;
                                    Text {
                                        text: "Details";
                                        font-size: Theme.font-caption;
                                        font-weight: 700;
                                        color: Theme.on-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.details-ssid = root.connected-ssid;
                                            root.details-is-connected = true;
                                            root.show-details-dialog = true;
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: 16px;
                                    background: Theme.surface-highest;
                                    Text {
                                        text: "Disconnect";
                                        font-size: Theme.font-caption;
                                        font-weight: 600;
                                        color: Theme.on-surface;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.disconnect-wifi(); }
                                    }
                                }
                                Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: 16px;
                                    background: #5c2020;
                                    Text {
                                        text: "Forget";
                                        font-size: Theme.font-caption;
                                        font-weight: 600;
                                        color: #ffb4ab;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        clicked => { root.forget-network(root.connected-ssid); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Available Networks
                VerticalLayout {
                    spacing: 8px;
                    SettingsSectionHeader { title: "Available networks"; }
                    SettingsSectionCard {
                        VerticalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;

                            if root.access-points.length == 0: SettingsTile {
                                icon-name: "refresh";
                                icon-bg: #282a30;
                                icon-tint: #938f99;
                                title: "Scanning for networks...";
                                subtitle: "Searching for available Wi-Fi access points";
                                show-chevron: false;
                                is-first: true;
                                is-last: true;
                                show-divider: false;
                            }

                            for ap[idx] in root.access-points: SettingsTile {
                                icon-name: "wifi";
                                icon-bg: ap.connected ? #a3e8b0 : #282a30;
                                icon-tint: ap.connected ? #073919 : #e6e0e9;
                                title: ap.ssid;
                                subtitle: (ap.saved ? "Saved • " : "") + ap.security + " • " + ap.signal + "% Signal";
                                trailing-text: ap.connected ? "Active" : (ap.saved ? "Saved" : "");
                                show-chevron: !ap.connected;
                                is-first: idx == 0;
                                is-last: idx == root.access-points.length - 1;
                                show-divider: idx < root.access-points.length - 1;
                                clicked => {
                                    if (!ap.connected) {
                                        if (ap.saved || ap.security == "Open" || ap.security == "None" || ap.security == "") {
                                            root.connect-ap(ap.ssid);
                                        } else {
                                            root.selected-ap-ssid = ap.ssid;
                                            root.selected-ap-security = ap.security;
                                            root.entered-password = "";
                                            root.show-password-text = false;
                                            root.show-password-dialog = true;
                                            root.password-input-focused();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Saved Connections (GNOME Settings style)
                if root.saved-networks.length > 0: VerticalLayout {
                    spacing: 8px;
                    SettingsSectionHeader { title: "Saved networks"; }
                    SettingsSectionCard {
                        VerticalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;

                            for saved_ssid[idx] in root.saved-networks: SettingsTile {
                                icon-name: "wifi";
                                icon-bg: saved_ssid == root.connected-ssid ? Theme.primary-container : #282a30;
                                icon-tint: saved_ssid == root.connected-ssid ? Theme.on-primary-container : #a8c7fa;
                                title: saved_ssid;
                                subtitle: saved_ssid == root.connected-ssid ? "Connected • Tap for details" : "Saved • Tap for details or forget";
                                trailing-text: saved_ssid == root.connected-ssid ? "Active" : "Details";
                                show-chevron: true;
                                is-first: idx == 0;
                                is-last: idx == root.saved-networks.length - 1;
                                show-divider: idx < root.saved-networks.length - 1;
                                clicked => {
                                    root.details-ssid = saved_ssid;
                                    root.details-is-connected = (saved_ssid == root.connected-ssid);
                                    root.show-details-dialog = true;
                                }
                            }
                        }
                    }
                }

                // Wi-Fi Hotspot & Tethering (GNOME Network Panel style)
                VerticalLayout {
                    spacing: 8px;
                    SettingsSectionHeader { title: "Hotspot & Tethering"; }
                    SettingsSectionCard {
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "Wi-Fi Hotspot";
                                        font-size: Theme.font-body;
                                        font-weight: 600;
                                        color: Theme.on-surface;
                                    }
                                    Text {
                                        text: root.hotspot-active
                                            ? "Active • Sharing internet as " + root.hotspot-ssid-input
                                            : "Share mobile or Ethernet internet over Wi-Fi";
                                        font-size: Theme.font-caption;
                                        color: root.hotspot-active ? Theme.primary : Theme.on-surface-variant;
                                    }
                                }
                                M3Switch {
                                    y: (parent.height - self.height) / 2;
                                    checked <=> root.hotspot-active;
                                    toggled(val) => {
                                        if val {
                                            root.start-hotspot(root.hotspot-ssid-input, root.hotspot-pass-input);
                                        } else {
                                            root.stop-hotspot();
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "Network Name"; font-size: 11px; color: Theme.on-surface-variant; }
                                    Rectangle {
                                        height: 36px;
                                        border-radius: 10px;
                                        background: #1e2025;
                                        border-width: 1px;
                                        border-color: Theme.specular-rim;
                                        TextInput {
                                            x: 10px; width: parent.width - 20px; height: 100%;
                                            text <=> root.hotspot-ssid-input;
                                            font-size: Theme.font-caption;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    Text { text: "Password (8+ chars)"; font-size: 11px; color: Theme.on-surface-variant; }
                                    Rectangle {
                                        height: 36px;
                                        border-radius: 10px;
                                        background: #1e2025;
                                        border-width: 1px;
                                        border-color: Theme.specular-rim;
                                        TextInput {
                                            x: 10px; width: parent.width - 20px; height: 100%;
                                            text <=> root.hotspot-pass-input;
                                            font-size: Theme.font-caption;
                                            color: Theme.on-surface;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Wi-Fi Preferences
                VerticalLayout {
                    spacing: 8px;
                    SettingsSectionHeader { title: "Network preferences"; }
                    SettingsSectionCard {
                        VerticalLayout {
                            padding-top: 4px;
                            padding-bottom: 4px;

                            SettingsTile {
                                icon-name: "refresh";
                                icon-bg: #7dd8fc;
                                icon-tint: #00354e;
                                title: "Scan for networks";
                                subtitle: "Trigger broadcast beacon discovery";
                                show-chevron: true;
                                is-first: true;
                                is-last: false;
                                show-divider: true;
                                clicked => { root.scan-requested(); }
                            }

                            SettingsTile {
                                icon-name: "network";
                                icon-bg: #d0bcff;
                                icon-tint: #381e72;
                                title: "Wi-Fi MAC address";
                                subtitle: root.wifi-mac;
                                show-chevron: false;
                                is-first: false;
                                is-last: true;
                                show-divider: false;
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Password Entry Dialog
    if root.show-password-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        // Scrim blocker to absorb touches behind the modal
        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 40px;
            width: Math.min(parent.width - 36px, 380px);
            border-radius: 28px;
            background: #25232a;
            border-width: 1px;
            border-color: #383540;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Header
                HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: #7dd8fc;
                        y: (parent.height - self.height) / 2;

                        Icon {
                            name: "wifi";
                            icon-size: 24px;
                            icon-color: #00354e;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Connect to Network";
                            font-size: 18px;
                            font-weight: 600;
                            color: Theme.on-surface;
                        }
                        Text {
                            text: root.selected-ap-ssid;
                            font-size: 14px;
                            color: #7dd8fc;
                            overflow: elide;
                        }
                    }
                }

                Text {
                    text: "Enter authentication password for " + root.selected-ap-ssid + " (" + root.selected-ap-security + "):";
                    font-size: 13px;
                    color: Theme.on-surface-variant;
                    wrap: word-wrap;
                }

                // Password Input Container
                Rectangle {
                    height: 52px;
                    border-radius: 14px;
                    background: #19181d;
                    border-width: 1.5px;
                    border-color: #48454e;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;

                        pw-input := TextInput {
                            text <=> root.entered-password;
                            font-size: 16px;
                            color: Theme.on-surface;
                            vertical-alignment: center;
                            single-line: true;
                            input-type: root.show-password-text ? InputType.text : InputType.password;

                            accepted => {
                                if (root.entered-password != "") {
                                    root.connect-ap-with-password(root.selected-ap-ssid, root.entered-password);
                                    root.show-password-dialog = false;
                                    root.password-input-dismissed();
                                }
                            }
                        }

                        // Show/Hide Password Eye Button
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            y: (parent.height - self.height) / 2;
                            background: pw-eye-touch.pressed ? #323038 : transparent;

                            Icon {
                                name: "shield";
                                icon-size: 18px;
                                icon-color: root.show-password-text ? #7dd8fc : #938f99;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }

                            pw-eye-touch := TouchArea {
                                clicked => {
                                    root.show-password-text = !root.show-password-text;
                                }
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            pw-input.focus();
                            root.password-input-focused();
                        }
                    }
                }

                // Action Buttons
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Rectangle {
                        height: 40px;
                        min-width: 80px;
                        border-radius: 20px;
                        background: cancel-btn-touch.pressed ? #323038 : transparent;

                        Text {
                            text: "Cancel";
                            font-size: 14px;
                            font-weight: 500;
                            color: #a8c7fa;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cancel-btn-touch := TouchArea {
                            clicked => {
                                root.show-password-dialog = false;
                                root.entered-password = "";
                                root.password-input-dismissed();
                            }
                        }
                    }

                    Rectangle {
                        height: 40px;
                        min-width: 96px;
                        border-radius: 20px;
                        background: root.entered-password != "" ? (conn-btn-touch.pressed ? #92dcfc : #7dd8fc) : #323038;

                        Text {
                            text: "Connect";
                            font-size: 14px;
                            font-weight: 600;
                            color: root.entered-password != "" ? #00354e : #726f78;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        conn-btn-touch := TouchArea {
                            enabled: root.entered-password != "";
                            clicked => {
                                root.connect-ap-with-password(root.selected-ap-ssid, root.entered-password);
                                root.show-password-dialog = false;
                                root.password-input-dismissed();
                            }
                        }
                    }
                }
            }
        }
    }

    // Connection Details Modal Sheet
    if root.show-details-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        TouchArea {
            clicked => { root.show-details-dialog = false; }
        }

        Rectangle {
            width: Math.min(parent.width - 32px, 360px);
            height: details-col.preferred-height + 40px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 28px;
            background: #222028;
            border-width: 1px;
            border-color: Theme.specular-rim;

            TouchArea {}

            details-col := VerticalLayout {
                x: 20px;
                y: 20px;
                width: parent.width - 40px;
                spacing: 12px;

                Text {
                    text: root.details-ssid;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.on-surface;
                }

                Rectangle {
                    height: details-info.preferred-height + 20px;
                    border-radius: 16px;
                    background: #17151d;
                    border-width: 1px;
                    border-color: Theme.specular-rim;

                    details-info := VerticalLayout {
                        x: 14px;
                        y: 10px;
                        width: parent.width - 28px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Status"; font-size: Theme.font-caption; color: Theme.on-surface-variant; }
                            Text {
                                text: root.details-is-connected ? "Connected" : "Saved";
                                font-size: Theme.font-caption;
                                font-weight: 600;
                                color: root.details-is-connected ? Theme.primary : Theme.on-surface;
                            }
                        }
                        if root.details-is-connected: HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Signal strength"; font-size: Theme.font-caption; color: Theme.on-surface-variant; }
                            Text {
                                text: root.signal-strength + "%";
                                font-size: Theme.font-caption;
                                font-weight: 600;
                                color: Theme.on-surface;
                            }
                        }
                        if root.details-is-connected && root.ip-address != "": HorizontalLayout {
                            alignment: space-between;
                            Text { text: "IPv4 address"; font-size: Theme.font-caption; color: Theme.on-surface-variant; }
                            Text {
                                text: root.ip-address;
                                font-size: Theme.font-caption;
                                font-weight: 600;
                                color: Theme.on-surface;
                            }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Hardware MAC"; font-size: Theme.font-caption; color: Theme.on-surface-variant; }
                            Text {
                                text: root.wifi-mac;
                                font-size: Theme.font-caption;
                                font-weight: 600;
                                color: Theme.on-surface;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    if !root.details-is-connected: Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: 18px;
                        background: Theme.primary;
                        Text {
                            text: "Connect";
                            font-size: Theme.font-caption;
                            font-weight: 700;
                            color: Theme.on-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.connect-ap(root.details-ssid);
                                root.show-details-dialog = false;
                            }
                        }
                    }

                    if root.details-is-connected: Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: 18px;
                        background: Theme.surface-highest;
                        Text {
                            text: "Disconnect";
                            font-size: Theme.font-caption;
                            font-weight: 600;
                            color: Theme.on-surface;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.disconnect-wifi();
                                root.show-details-dialog = false;
                            }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        horizontal-stretch: 1;
                        border-radius: 18px;
                        background: #5c2020;
                        Text {
                            text: "Forget";
                            font-size: Theme.font-caption;
                            font-weight: 600;
                            color: #ffb4ab;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            clicked => {
                                root.forget-network(root.details-ssid);
                                root.show-details-dialog = false;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 34px;
                    border-radius: 17px;
                    background: transparent;
                    Text {
                        text: "Close";
                        font-size: Theme.font-caption;
                        font-weight: 600;
                        color: Theme.primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.show-details-dialog = false; }
                    }
                }
            }
        }
    }
}
