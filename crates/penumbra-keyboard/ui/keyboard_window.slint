// Penumbra Keyboard: Wayland layer-shell on-screen keyboard.

component KeyButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> is-accent: false;
    in property <bool> is-functional: false;
    in property <bool> is-console: false;
    in property <bool> is-active: false;
    in property <length> custom-font-size: 19px;
    in property <string> icon-name: "";

    callback clicked();

    border-radius: root.is-console ? 9px : 10px;
    background: touch.pressed
        ? (root.is-accent ? #8ab4f8 : (root.is-console ? #34313d : #4a4852))
        : (root.is-active
            ? #a8c7fa
            : (root.is-accent
                ? #a8c7fa
                : (root.is-console
                    ? #1d1b23
                    : (root.is-functional ? #383542 : #2c2a33))));
    border-width: root.is-console && !root.is-active ? 1px : 0px;
    border-color: #ffffff1c;

    animate background { duration: 80ms; easing: ease-out; }

    if root.icon-name == "": HorizontalLayout {
        alignment: center;
        Text {
            text: root.text;
            color: root.is-active || (root.is-accent && !touch.pressed)
                ? #042b59
                : #e6e1e5;
            font-size: root.custom-font-size;
            font-weight: root.is-accent || root.is-functional || root.is-console ? 600 : 400;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    if root.icon-name != "": Path {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon-name == "shift" ? "M12 4 L4 13 H9 V20 H15 V13 H20 Z"
                : root.icon-name == "capslock" ? "M12 3 L4 12 H9 V17 H15 V12 H20 Z M7 20 H17"
                : root.icon-name == "backspace" ? "M21 6 H9 L3 12 L9 18 H21 Z M12 9 L17 15 M17 9 L12 15"
                : root.icon-name == "enter" ? "M19 6 V14 H6 M10 10 L6 14 L10 18"
                : root.icon-name == "left" ? "M15 6 L9 12 L15 18"
                : root.icon-name == "right" ? "M9 6 L15 12 L9 18"
                : root.icon-name == "up" ? "M6 15 L12 9 L18 15"
                : root.icon-name == "down" ? "M6 9 L12 15 L18 9"
                : "";
        stroke: root.is-active || (root.is-accent && !touch.pressed) ? #042b59 : #e6e1e5;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ToolbarChip inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> accent-text: false;
    callback clicked();

    height: 44px;
    background: transparent;

    Rectangle {
        y: 4px;
        width: parent.width;
        height: 36px;
        border-radius: 10px;
        background: chip-touch.pressed
            ? #3c3947
            : (root.active ? #a8c7fa : #24222b);
        border-width: root.active ? 0px : 1px;
        border-color: #ffffff14;

        animate background { duration: 80ms; }

        Text {
            width: 100%;
            height: 100%;
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            color: root.active ? #042b59 : (root.accent-text ? #a8c7fa : #e6e1e5);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    chip-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component KeyboardWindow inherits Window {
    title: "Penumbra Keyboard";
    no-frame: true;
    default-font-family: "Droid Sans";
    background: transparent;

    width: 412px;
    height: 380px;

    in-out property <bool> is-open: true;
    in-out property <bool> physical-keyboard-connected: false;
    in-out property <string> physical-keyboard-name: "";
    // 0 = Lowercase, 1 = Shift, 2 = CapsLock, 3 = Symbols, 4 = More Symbols
    in-out property <int> layout-mode: 0;
    in-out property <bool> terminal-bar-visible: true;
    in-out property <bool> number-row-visible: false;
    in-out property <bool> ctrl-active: false;
    in-out property <bool> alt-active: false;
    in-out property <bool> super-active: false;

    property <bool> effectively-open: root.is-open && !root.physical-keyboard-connected;
    out property <int> content-height-px:
        14
        + 44
        + (root.terminal-bar-visible ? 50 : 0)
        + (root.number-row-visible ? 50 : 0)
        + (4 * 48)
        + (3 * 6);

    callback key-clicked(string);
    callback special-key-clicked(string);
    callback shortcut-clicked(string);
    callback backspace-clicked();
    callback space-clicked();
    callback enter-clicked();
    callback toggle-hide();
    callback layout-height-changed(int);

    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        keyboard-sheet := Rectangle {
            width: 100%;
            height: root.content-height-px * 1px;
            y: root.effectively-open ? (parent.height - self.height) : parent.height;
            background: #141218;
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            border-width: 1px;
            border-color: #ffffff1a;

            animate y, height { duration: 190ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1.0); }

            VerticalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: 6px;
                padding-bottom: 8px;
                spacing: 6px;

                // Utility & Editing Strip
                HorizontalLayout {
                    height: 44px;
                    spacing: 6px;

                    ToolbarChip {
                        width: 48px;
                        label: ">_";
                        active: root.terminal-bar-visible;
                        clicked => {
                            root.terminal-bar-visible = !root.terminal-bar-visible;
                            root.layout-height-changed(root.content-height-px);
                        }
                    }

                    ToolbarChip {
                        width: 48px;
                        label: "123";
                        active: root.number-row-visible;
                        clicked => {
                            root.number-row-visible = !root.number-row-visible;
                            root.layout-height-changed(root.content-height-px);
                        }
                    }

                    ToolbarChip {
                        horizontal-stretch: 1;
                        label: @tr("Undo");
                        clicked => { root.shortcut-clicked("undo"); }
                    }

                    ToolbarChip {
                        horizontal-stretch: 1;
                        label: @tr("All");
                        clicked => { root.shortcut-clicked("select_all"); }
                    }

                    ToolbarChip {
                        horizontal-stretch: 1;
                        label: @tr("Copy");
                        clicked => { root.shortcut-clicked("copy"); }
                    }

                    ToolbarChip {
                        horizontal-stretch: 1;
                        label: @tr("Paste");
                        clicked => { root.shortcut-clicked("paste"); }
                    }

                    Rectangle {
                        width: 44px;
                        height: 44px;
                        background: transparent;

                        Rectangle {
                            y: 4px;
                            width: 44px;
                            height: 36px;
                            border-radius: 10px;
                            background: hide-touch.pressed ? #3c3947 : #24222b;
                            border-width: 1px;
                            border-color: #ffffff14;

                            Path {
                                width: 16px;
                                height: 16px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                viewbox-width: 24;
                                viewbox-height: 24;
                                commands: "M6 9 L12 15 L18 9";
                                stroke: #e6e1e5;
                                stroke-width: 2.2px;
                                stroke-line-cap: round;
                                stroke-line-join: round;
                                fill: transparent;
                            }
                        }

                        hide-touch := TouchArea {
                            clicked => {
                                root.is-open = false;
                                root.toggle-hide();
                            }
                        }
                    }
                }

                // Console / Terminal Key Row
                if root.terminal-bar-visible: HorizontalLayout {
                    spacing: 4px;
                    height: 44px;

                    KeyButton { text: "Esc"; is-console: true; horizontal-stretch: 1.15; custom-font-size: 11px; clicked => { root.special-key-clicked("esc"); } }
                    KeyButton { text: "Tab"; is-console: true; horizontal-stretch: 1.15; custom-font-size: 11px; clicked => { root.special-key-clicked("tab"); } }
                    KeyButton { text: "Ctrl"; is-console: true; is-active: root.ctrl-active; horizontal-stretch: 1.25; custom-font-size: 11px; clicked => { root.ctrl-active = !root.ctrl-active; } }
                    KeyButton { text: "Alt"; is-console: true; is-active: root.alt-active; horizontal-stretch: 1.05; custom-font-size: 11px; clicked => { root.alt-active = !root.alt-active; } }
                    KeyButton { text: "/"; is-console: true; horizontal-stretch: 0.85; custom-font-size: 14px; clicked => { root.key-clicked("/"); } }
                    KeyButton { text: "|"; is-console: true; horizontal-stretch: 0.85; custom-font-size: 14px; clicked => { root.key-clicked("|"); } }
                    KeyButton { text: "~"; is-console: true; horizontal-stretch: 0.85; custom-font-size: 14px; clicked => { root.key-clicked("~"); } }
                    KeyButton { text: "-"; is-console: true; horizontal-stretch: 0.85; custom-font-size: 14px; clicked => { root.key-clicked("-"); } }
                    KeyButton { icon-name: "left"; is-console: true; horizontal-stretch: 0.95; clicked => { root.special-key-clicked("left"); } }
                    KeyButton { icon-name: "down"; is-console: true; horizontal-stretch: 0.95; clicked => { root.special-key-clicked("down"); } }
                    KeyButton { icon-name: "up"; is-console: true; horizontal-stretch: 0.95; clicked => { root.special-key-clicked("up"); } }
                    KeyButton { icon-name: "right"; is-console: true; horizontal-stretch: 0.95; clicked => { root.special-key-clicked("right"); } }
                }

                // Optional Dedicated Number Row
                if root.number-row-visible: HorizontalLayout {
                    spacing: 5px;
                    height: 44px;

                    KeyButton { text: "1"; horizontal-stretch: 1; custom-font-size: 17px; clicked => { root.key-clicked("1"); } }
                    KeyButton { text: "2"; horizontal-stretch: 1; custom-font-size: 17px; clicked => { root.key-clicked("2"); } }
                    KeyButton { text: "3"; horizontal-stretch: 1; custom-font-size: 17px; clicked => { root.key-clicked("3"); } }
                    KeyButton { text: "4"; horizontal-stretch: 1; custom-font-size: 17px; clicked => { root.key-clicked("4"); } }
                    KeyButton { text: "5"; horizontal-stretch: 1; custom-font-size: 17px; clicked => { root.key-clicked("5"); } }
                    KeyButton { text: "6"; horizontal-stretch: 1; custom-font-size: 17px; clicked => { root.key-clicked("6"); } }
                    KeyButton { text: "7"; horizontal-stretch: 1; custom-font-size: 17px; clicked => { root.key-clicked("7"); } }
                    KeyButton { text: "8"; horizontal-stretch: 1; custom-font-size: 17px; clicked => { root.key-clicked("8"); } }
                    KeyButton { text: "9"; horizontal-stretch: 1; custom-font-size: 17px; clicked => { root.key-clicked("9"); } }
                    KeyButton { text: "0"; horizontal-stretch: 1; custom-font-size: 17px; clicked => { root.key-clicked("0"); } }
                }

                // Key Row 1
                HorizontalLayout {
                    spacing: 5px;
                    height: 48px;

                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "q" : "Q"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "w" : "W"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "e" : "E"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "r" : "R"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "t" : "T"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "y" : "Y"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "u" : "U"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "i" : "I"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "o" : "O"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "p" : "P"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }

                    if root.layout-mode == 3: KeyButton { text: "1"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "2"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "3"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "4"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "5"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "6"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "7"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "8"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "9"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "0"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }

                    if root.layout-mode == 4: KeyButton { text: "~"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "`"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "|"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "^"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "="; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "{"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "}"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "["; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "]"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "\\"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                }

                // Key Row 2
                HorizontalLayout {
                    spacing: 5px;
                    height: 48px;

                    Rectangle { width: 14px; background: transparent; }

                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "a" : "A"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "s" : "S"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "d" : "D"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "f" : "F"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "g" : "G"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "h" : "H"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "j" : "J"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "k" : "K"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "l" : "L"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }

                    if root.layout-mode == 3: KeyButton { text: "@"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "#"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "$"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "%"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "&"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "-"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "+"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "("; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: ")"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }

                    if root.layout-mode == 4: KeyButton { text: "<"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: ">"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "*"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "\""; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "'"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: ":"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: ";"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "/"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "_"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }

                    Rectangle { width: 14px; background: transparent; }
                }

                // Key Row 3
                HorizontalLayout {
                    spacing: 5px;
                    height: 48px;

                    if root.layout-mode <= 2: KeyButton {
                        icon-name: root.layout-mode == 2 ? "capslock" : "shift";
                        is-functional: true;
                        is-active: root.layout-mode == 1 || root.layout-mode == 2;
                        horizontal-stretch: 1.4;
                        clicked => {
                            if root.layout-mode == 0 {
                                root.layout-mode = 1;
                            } else if root.layout-mode == 1 {
                                root.layout-mode = 2;
                            } else {
                                root.layout-mode = 0;
                            }
                        }
                    }

                    if root.layout-mode == 3: KeyButton {
                        text: "=\\<";
                        is-functional: true;
                        horizontal-stretch: 1.4;
                        custom-font-size: 15px;
                        clicked => { root.layout-mode = 4; }
                    }

                    if root.layout-mode == 4: KeyButton {
                        text: "?123";
                        is-functional: true;
                        horizontal-stretch: 1.4;
                        custom-font-size: 15px;
                        clicked => { root.layout-mode = 3; }
                    }

                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "z" : "Z"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); if root.layout-mode == 1 { root.layout-mode = 0; } } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "x" : "X"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); if root.layout-mode == 1 { root.layout-mode = 0; } } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "c" : "C"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); if root.layout-mode == 1 { root.layout-mode = 0; } } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "v" : "V"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); if root.layout-mode == 1 { root.layout-mode = 0; } } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "b" : "B"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); if root.layout-mode == 1 { root.layout-mode = 0; } } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "n" : "N"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); if root.layout-mode == 1 { root.layout-mode = 0; } } }
                    if root.layout-mode <= 2: KeyButton { text: root.layout-mode == 0 ? "m" : "M"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); if root.layout-mode == 1 { root.layout-mode = 0; } } }

                    if root.layout-mode == 3: KeyButton { text: "*"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "\""; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "'"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: ":"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: ";"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "!"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 3: KeyButton { text: "?"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }

                    if root.layout-mode == 4: KeyButton { text: "!"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "?"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "$"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "%"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "^"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "&"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }
                    if root.layout-mode == 4: KeyButton { text: "€"; horizontal-stretch: 1; clicked => { root.key-clicked(self.text); } }

                    KeyButton {
                        icon-name: "backspace";
                        is-functional: true;
                        horizontal-stretch: 1.4;
                        clicked => { root.backspace-clicked(); }
                    }
                }

                // Key Row 4
                HorizontalLayout {
                    spacing: 5px;
                    height: 48px;

                    KeyButton {
                        text: root.layout-mode <= 2 ? "?123" : "ABC";
                        is-functional: true;
                        horizontal-stretch: 1.4;
                        custom-font-size: 15px;
                        clicked => {
                            if root.layout-mode <= 2 {
                                root.layout-mode = 3;
                            } else {
                                root.layout-mode = 0;
                            }
                        }
                    }

                    KeyButton {
                        text: ",";
                        horizontal-stretch: 1;
                        custom-font-size: 18px;
                        clicked => { root.key-clicked(","); }
                    }

                    KeyButton {
                        text: "";
                        horizontal-stretch: 4.6;
                        clicked => { root.space-clicked(); }
                    }

                    KeyButton {
                        text: ".";
                        horizontal-stretch: 1;
                        custom-font-size: 18px;
                        clicked => { root.key-clicked("."); }
                    }

                    KeyButton {
                        icon-name: "enter";
                        is-accent: true;
                        horizontal-stretch: 1.8;
                        clicked => { root.enter-clicked(); }
                    }
                }
            }
        }
    }
}
